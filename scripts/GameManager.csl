    find_press_operator_for_base :: method(base: PlayerBase, lane_index: s64) -> PressOperator {
        if base == null return null;
        if base.entity == null || base.entity.self == null return null;

        foreach op: component_iterator(PressOperator) {
            if op == null continue;
            if op.entity == null || op.entity.self == null continue;
            if !op.entity->get_world_enabled() continue;
            if op.lane_index != lane_index continue;

            pb := get_parent_player_base(op.entity);
            if pb == base {
                return op;
            }
        }
        return null;
    }

    server_spawn_press_operator :: method(base: PlayerBase, owner_user_id: string, lane_index: s64, spawn_pos: v2) {
        if !Game.is_server() return;
        if base == null return;
        if base.entity == null || base.entity.self == null return;
        if owner_user_id.count == 0 return;

        ensure_press_operator_prefab_loaded();
        if cached_press_operator_prefab == null {
            if !warned_missing_press_operator_prefab {
                warned_missing_press_operator_prefab = true;
                log_warning("GameManager: press_operator_prefab_path is empty or invalid (set it to something like \"Managers/PressOperator.prefab\")", {});
            }
            return;
        }

        ud := new(Spawn_PressOperator_Userdata);
        ud.base_entity = base.entity;
        ud.owner_user_id = owner_user_id;
        ud.lane_index = lane_index;

        _ := Scene.instantiate(
            cached_press_operator_prefab,
            spawn_pos,
            ud,
            proc(spawned_entity: Entity, userdata: Object) {
                ud := userdata.(Spawn_PressOperator_Userdata);
                if ud == null return;
                if spawned_entity == null return;
                if spawned_entity.self == null return;

                // Parent under the base so it is destroyed when the base is destroyed.
                if ud.base_entity != null && ud.base_entity.self != null {
                    spawned_entity->set_parent(ud.base_entity, true);
                }

                op := spawned_entity->get_component(PressOperator);
                if op != null {
                    op->server_init(ud.owner_user_id, ud.lane_index);
                }
                else {
                    log_warning("GameManager: PressOperator prefab is missing PressOperator component on its root entity", {});
                }
            }
        );
    }

    server_reconcile_press_operators_lane1 :: method() {
        if !Game.is_server() return;

        // PressOperator is bit 1 (lowest bit) in the lane mask.
        PRESS_OPERATOR_BIT :: 1;

        foreach p: component_iterator(Player) {
            if p == null continue;
            if p.base_entity == null || p.base_entity.self == null continue;

            pb := p.base_entity->get_component(PlayerBase);
            if pb == null continue;

            for lane: 0..3 {
                existing := find_press_operator_for_base(pb, lane);

                // Don't run managers in locked lanes.
                if !lanes_is_unlocked(p, lane) {
                    if existing != null && existing.entity != null && existing.entity.self != null {
                        existing.entity->destroy();
                    }
                    continue;
                }

                mask := p.managers_lane_masks[lane];
                unlocked := (mask & PRESS_OPERATOR_BIT) != 0;

                if unlocked {
                    if existing == null {
                        spawn_pos := this->manager_unlock_anchor_world_pos(pb, lane, .PRESS_OPERATOR);
                        server_spawn_press_operator(pb, p->get_user_id(), lane, spawn_pos);
                    }
                }
                else {
                    if existing != null && existing.entity != null && existing.entity.self != null {
                        existing.entity->destroy();
                    }
                }
            }
        }
    }

