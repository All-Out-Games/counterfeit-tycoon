        if cached_woodchipper_prefab == null {
            if !warned_missing_woodchipper_prefab {
                warned_missing_woodchipper_prefab = true;
                log_warning("GameManager: woodchipper_prefab_path is empty or invalid (set it to something like \"Woodchipper.prefab\")", {});
