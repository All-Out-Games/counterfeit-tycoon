import "core:ao"

DamageNumbers :: class {
    Text: string;
    Position: v2;
    Color: v4;
    T: float;
    TextSettings: Text_Settings;
    SpaceText: bool;
    DoingFading: bool;
    LastPosition: v2;
}

Spawn_Base_Userdata :: class {
    player: Player;
    spawn_index: s64;
    gm: GameManager;
}

Spawn_PressOperator_Userdata :: class {
    base_entity: Entity;
    owner_user_id: string;
    lane_index: s64;
}

Spawn_Colorist_Userdata :: class {
    base_entity: Entity;
    owner_user_id: string;
    lane_index: s64;
}

Spawn_Stamper_Userdata :: class {
    base_entity: Entity;
    owner_user_id: string;
    lane_index: s64;
}

Spawn_Courier_Userdata :: class {
    base_entity: Entity;
    owner_user_id: string;
    lane_index: s64;
}

Spawn_Woodchipper_Userdata :: class {
    base_entity: Entity;
    owner_user_id: string;
}

Spawn_Lane_Userdata :: class {
    player: Player;
    base_entity: Entity;
    lane_index: s64;
    gm: GameManager;
}

Spawn_ManagerUnlock_Userdata :: class {
    player: Player;
    base_entity: Entity;
    lane_index: s64;
    manager_index: s64; // 0..3, matches manager_kind_from_index ordering
    kind: Manager_Kind;
    gm: GameManager;
}

Spawn_WoodchipperUnlock_Userdata :: class {
    player: Player;
    base_entity: Entity;
    gm: GameManager;
}

find_truck_for_base :: proc(base: PlayerBase) -> Truck {
    if base == null return null;
    if base.entity == null || base.entity.self == null return null;

    foreach t: component_iterator(Truck) {
        if t == null continue;
        if t.entity == null || t.entity.self == null continue;
        if !t.entity->get_world_enabled() continue;

        pb := get_parent_player_base(t.entity);
        if pb == base {
            return t;
        }
    }
    return null;
}

find_harvester_for_base :: proc(base: PlayerBase) -> Harvester {
    if base == null return null;
    if base.entity == null || base.entity.self == null return null;

    foreach h: component_iterator(Harvester) {
        if h == null continue;
        if h.entity == null || h.entity.self == null continue;
        if !h.entity->get_world_enabled() continue;

        pb := get_parent_player_base(h.entity);
        if pb == base {
            return h;
        }
    }
    return null;
}


GameManager :: class : Component {
    damage_numbers: [..]DamageNumbers;

    // Navmesh
    // Rebuilt on both server + clients whenever player bases spawn/despawn.
    // Prefer setting this in-editor (typically the Navmesh lives on the same entity as GameManager).
    navmesh: Navmesh @ao_serialize;

    // Player base / plot-style spawning:
    // - Up to 6 bases can exist at once
    // - Each base is spawned at a configured spawn entity (set these in-editor)
    // - Ownership is set via PlayerBase.set_owner(player)
    player_base_prefab_path: string @ao_serialize; // e.g. "Plots/PlayerBase.prefab"
    PlayerSpawns: [6]Entity @ao_serialize;
    TruckRoutes: [6]Entity @ao_serialize;

    // Managers (moving agents) spawned per-player based on unlock state.
    // Prefab path in /res, like: "Managers/PressOperator.prefab"
    press_operator_prefab_path: string @ao_serialize;
    // Prefab path in /res, like: "Managers/Colorist.prefab"
    colorist_prefab_path: string @ao_serialize;
    // Prefab path in /res, like: "Managers/Stamper.prefab"
    stamper_prefab_path: string @ao_serialize;
    // Prefab path in /res, like: "Managers/Courier.prefab"
    courier_prefab_path: string @ao_serialize;
    // Prefab path in /res, like: "Managers/Woodchipper.prefab"
    woodchipper_prefab_path: string @ao_serialize;

    // Runtime
    cached_player_base_prefab: Prefab_Asset;
    needs_base_reconcile: bool;
    warned_missing_base_prefab: bool;

    cached_press_operator_prefab: Prefab_Asset;
    warned_missing_press_operator_prefab: bool;
    cached_colorist_prefab: Prefab_Asset;
    warned_missing_colorist_prefab: bool;
    cached_stamper_prefab: Prefab_Asset;
    warned_missing_stamper_prefab: bool;
    cached_courier_prefab: Prefab_Asset;
    warned_missing_courier_prefab: bool;
    cached_woodchipper_prefab: Prefab_Asset;
    warned_missing_woodchipper_prefab: bool;
    last_managers_reconcile_time: float;
    last_station_upgrades_reconcile_time: float;

    // Lanes (Lane.prefab) spawned per-player based on lane unlock mask.
    cached_lane_prefab: Prefab_Asset;
    warned_missing_lane_prefab: bool;
    last_lanes_reconcile_time: float;

    // Lane unlock prompt prefab (optional) spawned per-player for the next locked lane.
    cached_lane_unlock_prompt_prefab: Prefab_Asset;
    warned_missing_lane_unlock_prompt_prefab: bool;
    last_lane_unlock_prompt_reconcile_time: float;

    // Manager unlock prompt prefab (optional) spawned per-player for missing managers in unlocked lanes.
    cached_manager_unlock_prompt_prefab: Prefab_Asset;
    warned_missing_manager_unlock_prompt_prefab: bool;
    last_manager_unlock_prompt_reconcile_time: float;

    warned_missing_navmesh: bool;
    warned_navmesh_rebuild_failed: bool;
    last_base_entity_ids: [..]u64;
    scratch_base_entity_ids: [..]u64;
    last_lane_sigs: [..]u64;
    scratch_lane_sigs: [..]u64;

    mark_navmesh_for_rebuild :: method() {
        // Explicit reference only (set in-editor on the GameManager).
        nm := navmesh;
        if nm == null {
            if !warned_missing_navmesh {
                warned_missing_navmesh = true;
                log_warning("GameManager: Navmesh reference is missing (set GameManager.navmesh in-editor)", {});
            }
            return;
        }
        ok := nm->rebuild_immediately();
        if !ok && !warned_navmesh_rebuild_failed {
            warned_navmesh_rebuild_failed = true;
            log_warning("GameManager: Navmesh rebuild failed", {});
        }
    }

    sort_u64_ascending :: method(arr: ref [..]u64) {
        if arr.count <= 1 return;
        for i: 0..arr.count-1 {
            best := i;
            for j: i+1..arr.count-1 {
                if arr[j] < arr[best] {
                    best = j;
                }
            }
            if best != i {
                tmp := arr[i];
                arr[i] = arr[best];
                arr[best] = tmp;
            }
        }
    }

    update_navmesh_rebuild_if_base_set_changed :: method() {
        scratch_base_entity_ids->clear();

        foreach pb: component_iterator(PlayerBase) {
            if pb == null continue;
            if pb.entity == null || pb.entity.self == null continue;
            if !pb.entity->get_world_enabled() continue;
            scratch_base_entity_ids->append(pb.entity.id);
        }

        this->sort_u64_ascending(ref scratch_base_entity_ids);

        changed := scratch_base_entity_ids.count != last_base_entity_ids.count;
        if !changed {
            for i: 0..scratch_base_entity_ids.count-1 {
                if scratch_base_entity_ids[i] != last_base_entity_ids[i] {
                    changed = true;
                    break;
                }
            }
        }

        if changed {
            this->mark_navmesh_for_rebuild();

            last_base_entity_ids->clear();
            for id: scratch_base_entity_ids {
                last_base_entity_ids->append(id);
            }
        }
    }

    update_navmesh_rebuild_if_lane_set_changed :: method() {
        scratch_lane_sigs->clear();

        foreach p: component_iterator(Player) {
            if p == null continue;

            // Track spawned lane prefab roots (lanes 2-4). Lane 1 lives in the base prefab.
            for lane: 1..3 {
                e := p.lane_entities[lane];
                if e == null continue;
                if e.self == null continue;
                if !e->get_world_enabled() continue;

                // Include local Y position in the signature so lane repositioning also triggers rebuilds.
                yq := (e.local_position.y * 1000.0).(s64);
                sig := e.id ^ (yq.(u64) * 1315423911);
                scratch_lane_sigs->append(sig);
            }
        }

        this->sort_u64_ascending(ref scratch_lane_sigs);

        changed := scratch_lane_sigs.count != last_lane_sigs.count;
        if !changed {
            for i: 0..scratch_lane_sigs.count-1 {
                if scratch_lane_sigs[i] != last_lane_sigs[i] {
                    changed = true;
                    break;
                }
            }
        }

        if changed {
            this->mark_navmesh_for_rebuild();

            last_lane_sigs->clear();
            for sig: scratch_lane_sigs {
                last_lane_sigs->append(sig);
            }
        }
    }

    ao_start :: proc(using this: GameManager) {
        // Called when this component is created
        if Game.is_server() {
            needs_base_reconcile = true;
            last_managers_reconcile_time = -99999.0;
            last_station_upgrades_reconcile_time = -99999.0;
            last_lanes_reconcile_time = -99999.0;
            last_lane_unlock_prompt_reconcile_time = -99999.0;
            last_manager_unlock_prompt_reconcile_time = -99999.0;
        }
    }

    ao_update :: proc(using this: GameManager, dt: float) {
        // Server-authoritative game state machine
        _ := dt;

        // Runs on both server + clients so everyone rebuilds their local navmesh
        // when bases/lanes are created/destroyed/repositioned via replication.
        this->update_navmesh_rebuild_if_base_set_changed();
        this->update_navmesh_rebuild_if_lane_set_changed();

        if !Game.is_server() {
            return;
        }

        if needs_base_reconcile {
            needs_base_reconcile = false;
            this->server_reconcile_player_bases();
        }

        // Reconcile managers periodically (covers unlock-at-runtime and unlocks loaded on join).
        MANAGERS_RECONCILE_INTERVAL :: 0.5;
        if get_time() - last_managers_reconcile_time >= MANAGERS_RECONCILE_INTERVAL {
            last_managers_reconcile_time = get_time();
            this->server_reconcile_press_operators_lane1();
            this->server_reconcile_colorists_lane1();
            this->server_reconcile_stampers_lane1();
            this->server_reconcile_couriers_lane1();
            this->server_reconcile_woodchippers();
        }

        // Re-apply station upgrade levels periodically to avoid load-order issues
        // (e.g. player save loads after bases/stations spawn).
        STATION_UPGRADES_RECONCILE_INTERVAL :: 0.5;
        if get_time() - last_station_upgrades_reconcile_time >= STATION_UPGRADES_RECONCILE_INTERVAL {
            last_station_upgrades_reconcile_time = get_time();
            foreach p: component_iterator(Player) {
                if p == null continue;
                this->server_apply_station_upgrade_levels_for_player(p);
                this->server_apply_vault_level_for_player(p);
            }
        }

        // Reconcile lane prefabs periodically (covers unlock-at-runtime and unlocks loaded on join).
        LANES_RECONCILE_INTERVAL :: 0.5;
        if get_time() - last_lanes_reconcile_time >= LANES_RECONCILE_INTERVAL {
            last_lanes_reconcile_time = get_time();
            this->server_reconcile_lanes();
        }

        // Reconcile "Unlock Lane" prompts periodically (covers unlock-at-runtime and unlocks loaded on join).
        LANE_UNLOCK_PROMPT_RECONCILE_INTERVAL :: 0.5;
        if get_time() - last_lane_unlock_prompt_reconcile_time >= LANE_UNLOCK_PROMPT_RECONCILE_INTERVAL {
            last_lane_unlock_prompt_reconcile_time = get_time();
            this->server_reconcile_lane_unlock_prompts();
        }

        // Reconcile "Hire Manager" prompts periodically (covers unlock-at-runtime and unlocks loaded on join).
        MANAGER_UNLOCK_PROMPT_RECONCILE_INTERVAL :: 0.5;
        if get_time() - last_manager_unlock_prompt_reconcile_time >= MANAGER_UNLOCK_PROMPT_RECONCILE_INTERVAL {
            last_manager_unlock_prompt_reconcile_time = get_time();
            this->server_reconcile_manager_unlock_prompts();
            this->server_reconcile_woodchipper_unlock_prompts();
        }
    }

    lane_local_y_for_player :: method(player: Player, lane_index: s64) -> float {
        // Lanes are numbered 1..4 in the design, but lane_index is 0-based:
        // - lane_index 0 == Lane 1 (lives in the base prefab; local Y assumed 0)
        // - lane_index 1..3 == Lane 2..4 (spawned at runtime via Lane.prefab)
        //
        // New layout (local Y positions for lanes 2/3/4):
        // - Players 1/2/3 (spawn 0/1/2):  -2.0,  4.0,  7.5
        // - Players 4/5/6 (spawn 3/4/5):   4.0, -2.0, -5.5
        if lane_index == 0 {
            return 0.0;
        }

        mirror := player != null && player.base_spawn_index >= 3;
        if !mirror {
            switch lane_index {
                case 1: return -2.0; // Lane 2
                case 2: return 4.0;  // Lane 3
                case 3: return 7.5;  // Lane 4
            }
        }
        else {
            switch lane_index {
                case 1: return 4.0;   // Lane 2 (mirrored)
                case 2: return -2.0;  // Lane 3 (mirrored)
                case 3: return -5.5;  // Lane 4 (mirrored)
            }
        }

        return 0.0;
    }

    ensure_lane_prefab_loaded :: method() {
        if cached_lane_prefab != null {
            return;
        }
        cached_lane_prefab = get_asset(Prefab_Asset, "Lane.prefab");
    }

    ensure_lane_unlock_prompt_prefab_loaded :: method() {
        if cached_lane_unlock_prompt_prefab != null {
            return;
        }
        cached_lane_unlock_prompt_prefab = get_asset(Prefab_Asset, "LaneUnlockPrompt.prefab");
    }

    ensure_manager_unlock_prompt_prefab_loaded :: method() {
        if cached_manager_unlock_prompt_prefab != null {
            return;
        }
        cached_manager_unlock_prompt_prefab = get_asset(Prefab_Asset, "ManagerUnlockPrompt.prefab");
    }

    server_spawn_lane_for_player :: method(player: Player, lane_index: s64) {
        if !Game.is_server() return;
        if player == null return;
        if lane_index < 0 || lane_index > 3 return;
        if player.base_entity == null || player.base_entity.self == null return;

        // We only spawn additional lanes (Lane 2-4). Lane 1 is expected to exist in the base prefab already.
        if lane_index == 0 {
            return;
        }

        // Already spawned and still alive? Ensure it's positioned correctly and return.
        existing := player.lane_entities[lane_index];
        if existing != null && existing.self != null {
            existing->set_local_position(v2{0, this->lane_local_y_for_player(player, lane_index)});
            return;
        }

        ensure_lane_prefab_loaded();
        if cached_lane_prefab == null {
            if !warned_missing_lane_prefab {
                warned_missing_lane_prefab = true;
                log_warning("GameManager: missing Lane.prefab asset (expected prefab at \"Lane.prefab\")", {});
            }
            return;
        }

        spawn_pos := player.base_entity.world_position;

        ud := new(Spawn_Lane_Userdata);
        ud.player = player;
        ud.base_entity = player.base_entity;
        ud.lane_index = lane_index;
        ud.gm = this;

        _ := Scene.instantiate(
            cached_lane_prefab,
            spawn_pos,
            ud,
            proc(spawned_entity: Entity, userdata: Object) {
                ud := userdata.(Spawn_Lane_Userdata);
                if ud == null return;
                if spawned_entity == null return;
                if spawned_entity.self == null return;

                is_descendant_of :: proc(child: Entity, ancestor: Entity) -> bool {
                    if child == null return false;
                    if child.self == null return false;
                    if ancestor == null return false;
                    if ancestor.self == null return false;

                    cur := child;
                    for step: 0..48 {
                        _ := step;
                        if cur == null break;
                        if cur.self == null break;
                        if cur == ancestor return true;
                        cur = cur.parent;
                    }
                    return false;
                }

                // Parent under the base so it is destroyed when the base is destroyed.
                if ud.base_entity != null && ud.base_entity.self != null {
                    spawned_entity->set_parent(ud.base_entity, true);
                }

                // Position lanes stacked vertically.
                y := ud.gm->lane_local_y_for_player(ud.player, ud.lane_index);
                spawned_entity->set_local_position(v2{0, y});

                // Track on the player so we can avoid duplicate spawns.
                if ud.player != null {
                    ud.player.lane_entities[ud.lane_index] = spawned_entity;
                }

                // IMPORTANT:
                // Stations inside Lane.prefab must have their `lane_index` set correctly so they
                // save/load lane-specific keys (otherwise they default to Lane 1 values).
                // After setting lane_index, force a re-load from Save for this lane.
                pb := get_parent_player_base(spawned_entity);
                if pb != null {
                    foreach m: component_iterator(Paper_Mill) {
                        if m == null continue;
                        if m.entity == null || m.entity.self == null continue;
                        if get_parent_player_base(m.entity) != pb continue;
                        if !is_descendant_of(m.entity, spawned_entity) continue;

                        m.lane_index = ud.lane_index;
                        m.loaded_from_save = false;
                        m.loaded_for_user_id = {};
                        m.stored_wood = 0;
                        m.stored_paper = 0;
                        m.convert_timer = 0;
                        m->server_try_load_from_save();
                    }
                    foreach b: component_iterator(Blank_Bill_Press) {
                        if b == null continue;
                        if b.entity == null || b.entity.self == null continue;
                        if get_parent_player_base(b.entity) != pb continue;
                        if !is_descendant_of(b.entity, spawned_entity) continue;

                        b.lane_index = ud.lane_index;
                        b.loaded_from_save = false;
                        b.loaded_for_user_id = {};
                        b.stored_paper = 0;
                        b.stored_blank_bills = 0;
                        b.convert_timer = 0;
                        b->server_try_load_from_save();
                    }
                    foreach c: component_iterator(Colored_Bill_Press) {
                        if c == null continue;
                        if c.entity == null || c.entity.self == null continue;
                        if get_parent_player_base(c.entity) != pb continue;
                        if !is_descendant_of(c.entity, spawned_entity) continue;

                        c.lane_index = ud.lane_index;
                        c.loaded_from_save = false;
                        c.loaded_for_user_id = {};
                        c.stored_blank_bills = 0;
                        c.stored_colored_bills = 0;
                        c.convert_timer = 0;
                        c->server_try_load_from_save();
                    }
                    foreach f: component_iterator(Finished_Bill_Press) {
                        if f == null continue;
                        if f.entity == null || f.entity.self == null continue;
                        if get_parent_player_base(f.entity) != pb continue;
                        if !is_descendant_of(f.entity, spawned_entity) continue;

                        f.lane_index = ud.lane_index;
                        f.loaded_from_save = false;
                        f.loaded_for_user_id = {};
                        f.stored_colored_bills = 0;
                        f.stored_finished_bills = 0;
                        f.convert_timer = 0;
                        f->server_try_load_from_save();
                    }
                }

                // Newly spawned stations should reflect saved upgrade levels immediately.
                gm := ud.gm;
                if gm != null && ud.player != null {
                    gm->apply_station_upgrade_levels_for_player(ud.player);
                    gm->apply_vault_level_for_player(ud.player);
                    // Lane spawned + repositioned: rebuild navmesh ASAP on server.
                    gm->mark_navmesh_for_rebuild();
                }
            }
        );
    }

    get_next_locked_lane_index :: method(player: Player) -> s64 {
        if player == null return -1;
        // Lane 1 (index 0) is always unlocked; we only prompt for lanes 2-4 (indices 1..3).
        for li: 1..3 {
            if !lanes_is_unlocked(player, li) {
                return li;
            }
        }
        return -1;
    }

    server_destroy_lane_unlock_prompt_for_player :: method(player: Player) {
        if !Game.is_server() return;
        if player == null return;

        e := player.lane_unlock_prompt_entity;
        if e != null && e.self != null {
            e->destroy();
        }
        player.lane_unlock_prompt_entity = null;
        player.lane_unlock_prompt_lane_index = -1;
    }

    server_spawn_lane_unlock_prompt_for_player :: method(player: Player, lane_index: s64) {
        if !Game.is_server() return;
        if player == null return;
        if lane_index < 1 || lane_index > 3 return;
        if player.base_entity == null || player.base_entity.self == null return;

        // Don't spawn if already unlocked (race safety).
        if lanes_is_unlocked(player, lane_index) {
            return;
        }

        // If prefab exists, instantiate it; otherwise create a minimal runtime placeholder.
        ensure_lane_unlock_prompt_prefab_loaded();
        spawn_pos := player.base_entity.world_position;

        if cached_lane_unlock_prompt_prefab != null {
            ud := new(Spawn_Lane_Userdata);
            ud.player = player;
            ud.base_entity = player.base_entity;
            ud.lane_index = lane_index;
            ud.gm = this;

            _ := Scene.instantiate(
                cached_lane_unlock_prompt_prefab,
                spawn_pos,
                ud,
                proc(spawned_entity: Entity, userdata: Object) {
                    ud := userdata.(Spawn_Lane_Userdata);
                    if ud == null return;
                    if spawned_entity == null return;
                    if spawned_entity.self == null return;

                    // Parent under the base so it is destroyed when the base is destroyed.
                    if ud.base_entity != null && ud.base_entity.self != null {
                        spawned_entity->set_parent(ud.base_entity, true);
                    }

                    // Position exactly where this lane would be spawned.
                    y := ud.gm->lane_local_y_for_player(ud.player, ud.lane_index);
                    spawned_entity->set_local_position(v2{0, y});

                    // Add/configure the interactable.
                    lu := spawned_entity->get_component(LaneUnlock);
                    if lu == null {
                        lu = spawned_entity->add_component(LaneUnlock);
                    }
                    if lu != null {
                        lu->configure(ud.player, ud.lane_index);
                        // Reasonable defaults if prefab didn't set them.
                        if lu.radius <= 0.01 {
                            lu.radius = 2.0;
                        }
                        if lu.priority == 0 {
                            lu.priority = 50;
                        }
                        if lu.required_hold_time < 0.0 {
                            lu.required_hold_time = 0.0;
                        }
                        if lu.prompt_offset.x == 0.0 && lu.prompt_offset.y == 0.0 {
                            lu.prompt_offset = v2{0, 1.0};
                        }
                    }

                    // Track on the player so we can avoid duplicate spawns.
                    if ud.player != null {
                        ud.player.lane_unlock_prompt_entity = spawned_entity;
                        ud.player.lane_unlock_prompt_lane_index = ud.lane_index;
                    }
                }
            );
            return;
        }

        if !warned_missing_lane_unlock_prompt_prefab {
            warned_missing_lane_unlock_prompt_prefab = true;
            log_warning("GameManager: missing LaneUnlockPrompt.prefab asset (expected prefab at \"LaneUnlockPrompt.prefab\"). Using runtime placeholder.", {});
        }

        // Runtime placeholder entity (simple coin sprite child so it's visible).
        root := Scene.create_entity();
        root->set_parent(player.base_entity, true);
        y := this->lane_local_y_for_player(player, lane_index);
        root->set_local_position(v2{0, y});
        root->set_local_rotation(0);
        root->set_local_scale(v2{1, 1});

        // Visual child.
        visual := Scene.create_entity();
        visual->set_parent(root, true);
        visual->set_local_position(v2{0, 0});
        visual->set_local_rotation(0);
        visual->set_local_scale(v2{1, 1});
        sr := visual->add_component(Sprite_Renderer);
        if sr != null {
            tex := get_asset(Texture_Asset, "Items/Coin.png");
            if tex != null {
                sr->set_texture(tex);
            }
            sr.depth_offset = 0.5;
            sr.layer = 20;
            sr.color = v4{1, 1, 1, 1};
        }

        lu := root->add_component(LaneUnlock);
        if lu != null {
            lu->configure(player, lane_index);
            if lu.radius <= 0.01 {
                lu.radius = 2.0;
            }
            if lu.priority == 0 {
                lu.priority = 50;
            }
            if lu.prompt_offset.x == 0.0 && lu.prompt_offset.y == 0.0 {
                lu.prompt_offset = v2{0, 1.0};
            }
        }

        player.lane_unlock_prompt_entity = root;
        player.lane_unlock_prompt_lane_index = lane_index;
    }

    server_reconcile_lane_unlock_prompt_for_player :: method(player: Player) {
        if !Game.is_server() return;
        if player == null return;
        if player.base_entity == null || player.base_entity.self == null return;

        next := this->get_next_locked_lane_index(player);
        if next < 0 {
            this->server_destroy_lane_unlock_prompt_for_player(player);
            return;
        }

        // If we already have the correct prompt alive, just ensure it's positioned correctly.
        e := player.lane_unlock_prompt_entity;
        if e != null && e.self != null && player.lane_unlock_prompt_lane_index == next {
            y := this->lane_local_y_for_player(player, next);
            e->set_local_position(v2{0, y});

            lu := e->get_component(LaneUnlock);
            if lu != null {
                lu->configure(player, next);
            }
            return;
        }

        // Otherwise replace it.
        this->server_destroy_lane_unlock_prompt_for_player(player);
        this->server_spawn_lane_unlock_prompt_for_player(player, next);
    }

    server_reconcile_lane_unlock_prompts :: method() {
        if !Game.is_server() return;

        foreach p: component_iterator(Player) {
            if p == null continue;
            if p.base_entity == null || p.base_entity.self == null continue;
            this->server_reconcile_lane_unlock_prompt_for_player(p);
        }
    }

    get_next_locked_manager_index_in_lane :: method(player: Player, lane_index: s64) -> s64 {
        if player == null return -1;
        if lane_index < 0 || lane_index > 3 return -1;

        // Unlock order is the same as `manager_kind_from_index`:
        // PressOperator -> Colorist -> Stamper -> Courier
        for mi: 0..3 {
            kind := manager_kind_from_index(mi);
            if !is_manager_unlocked(player, lane_index, kind) {
                return mi;
            }
        }
        return -1;
    }

    manager_unlock_lane_anchor_world_pos :: method(base: PlayerBase, lane_index: s64) -> v2 {
        if base == null return v2{0, 0};
        if base.entity == null || base.entity.self == null return v2{0, 0};

        // Prompts live slightly left of the lane's Paper Mill.
        // (Even if the next manager is not the Press Operator.)
        mill := press_operator_find_paper_mill_for_base_and_lane(base, lane_index);
        if mill != null && mill.entity != null && mill.entity.self != null {
            return mill.entity.world_position + v2{-1.5, 0.0};
        }

        // Fallback: base position (should be rare; typically mills exist once lane prefab exists).
        return base.entity.world_position;
    }

    manager_unlock_anchor_world_pos :: method(base: PlayerBase, lane_index: s64, kind: Manager_Kind) -> v2 {
        if base == null return v2{0, 0};
        if base.entity == null || base.entity.self == null return v2{0, 0};

        offset := v2{-0.75, -1.2};

        // "Accompanying station" mapping uses each manager's SOURCE station (unique per kind):
        // - PressOperator: Paper_Mill
        // - Colorist: Blank_Bill_Press
        // - Stamper: Colored_Bill_Press
        // - Courier: Finished_Bill_Press
        switch kind {
            case .PRESS_OPERATOR: {
                m := press_operator_find_paper_mill_for_base_and_lane(base, lane_index);
                if m != null && m.entity != null && m.entity.self != null {
                    return m.entity.world_position + offset;
                }
            }
            case .COLORIST: {
                p := colorist_find_blank_bill_press_for_base_and_lane(base, lane_index);
                if p != null && p.entity != null && p.entity.self != null {
                    return p.entity.world_position + offset;
                }
            }
            case .STAMPER: {
                p := stamper_find_colored_bill_press_for_base_and_lane(base, lane_index);
                if p != null && p.entity != null && p.entity.self != null {
                    return p.entity.world_position + offset;
                }
            }
            case .COURIER: {
                p := courier_find_finished_bill_press_for_base_and_lane(base, lane_index);
                if p != null && p.entity != null && p.entity.self != null {
                    return p.entity.world_position + offset;
                }
            }
        }

        // Fallback: base position (should be rare; typically stations exist once lane prefab exists).
        return base.entity.world_position;
    }

    server_spawn_manager_kind_at :: method(player: Player, lane_index: s64, kind: Manager_Kind, spawn_world_pos: v2) {
        if !Game.is_server() return;
        if player == null return;
        if player.base_entity == null || player.base_entity.self == null return;
        if lane_index < 0 || lane_index > 3 return;

        pb := player.base_entity->get_component(PlayerBase);
        if pb == null return;

        // Don't spawn managers in locked lanes.
        if !lanes_is_unlocked(player, lane_index) {
            return;
        }

        owner_id := player->get_user_id();
        if owner_id.count == 0 return;

        switch kind {
            case .PRESS_OPERATOR: {
                if find_press_operator_for_base(pb, lane_index) != null return;
                this->server_spawn_press_operator(pb, owner_id, lane_index, spawn_world_pos);
            }
            case .COLORIST: {
                if find_colorist_for_base(pb, lane_index) != null return;
                this->server_spawn_colorist(pb, owner_id, lane_index, spawn_world_pos);
            }
            case .STAMPER: {
                if find_stamper_for_base(pb, lane_index) != null return;
                this->server_spawn_stamper(pb, owner_id, lane_index, spawn_world_pos);
            }
            case .COURIER: {
                if find_courier_for_base(pb, lane_index) != null return;
                this->server_spawn_courier(pb, owner_id, lane_index, spawn_world_pos);
            }
        }
    }

    server_destroy_manager_unlock_prompts_for_player :: method(player: Player) {
        if !Game.is_server() return;
        if player == null return;

        for i: 0..15 {
            e := player.manager_unlock_prompt_entities[i];
            if e != null && e.self != null {
                e->destroy();
            }
            player.manager_unlock_prompt_entities[i] = null;
        }
    }

    server_spawn_manager_unlock_prompt_for_player :: method(player: Player, lane_index: s64, manager_index: s64) {
        if !Game.is_server() return;
        if player == null return;
        if player.base_entity == null || player.base_entity.self == null return;
        if lane_index < 0 || lane_index > 3 return;
        if manager_index < 0 || manager_index > 3 return;

        // Only in unlocked lanes.
        if !lanes_is_unlocked(player, lane_index) {
            return;
        }

        kind := manager_kind_from_index(manager_index);
        if is_manager_unlocked(player, lane_index, kind) {
            return;
        }

        pb := player.base_entity->get_component(PlayerBase);
        if pb == null {
            return;
        }

        idx := lane_index * 4 + manager_index;
        if idx < 0 || idx >= 16 return;

        // Already alive?
        existing := player.manager_unlock_prompt_entities[idx];
        if existing != null && existing.self != null {
            // Keep it configured and positioned.
            existing->set_parent(player.base_entity, true);
            anchor := this->manager_unlock_lane_anchor_world_pos(pb, lane_index);
            base_world := player.base_entity.world_position;
            existing->set_local_position(anchor - base_world);

            mu := existing->get_component(ManagerUnlock);
            if mu == null {
                mu = existing->add_component(ManagerUnlock);
            }
            if mu != null {
                mu->configure(player, lane_index, kind);
                if mu.radius <= 0.01 {
                    mu.radius = 2.0;
                }
                if mu.priority == 0 {
                    mu.priority = 50;
                }
                if mu.required_hold_time < 0.0 {
                    mu.required_hold_time = 0.0;
                }
                if mu.prompt_offset.x == 0.0 && mu.prompt_offset.y == 0.0 {
                    mu.prompt_offset = v2{0, 1.0};
                }
            }
            return;
        }

        ensure_manager_unlock_prompt_prefab_loaded();
        spawn_pos := this->manager_unlock_lane_anchor_world_pos(pb, lane_index);

        if cached_manager_unlock_prompt_prefab != null {
            ud := new(Spawn_ManagerUnlock_Userdata);
            ud.player = player;
            ud.base_entity = player.base_entity;
            ud.lane_index = lane_index;
            ud.manager_index = manager_index;
            ud.kind = kind;
            ud.gm = this;

            _ := Scene.instantiate(
                cached_manager_unlock_prompt_prefab,
                spawn_pos,
                ud,
                proc(spawned_entity: Entity, userdata: Object) {
                    ud := userdata.(Spawn_ManagerUnlock_Userdata);
                    if ud == null return;
                    if spawned_entity == null return;
                    if spawned_entity.self == null return;

                    // Parent under the base so it is destroyed when the base is destroyed.
                    if ud.base_entity != null && ud.base_entity.self != null {
                        spawned_entity->set_parent(ud.base_entity, true);
                    }

                    mu := spawned_entity->get_component(ManagerUnlock);
                    if mu == null {
                        mu = spawned_entity->add_component(ManagerUnlock);
                    }
                    if mu != null && ud.player != null {
                        mu->configure(ud.player, ud.lane_index, ud.kind);
                        if mu.radius <= 0.01 {
                            mu.radius = 2.0;
                        }
                        if mu.priority == 0 {
                            mu.priority = 50;
                        }
                        if mu.required_hold_time < 0.0 {
                            mu.required_hold_time = 0.0;
                        }
                        if mu.prompt_offset.x == 0.0 && mu.prompt_offset.y == 0.0 {
                            mu.prompt_offset = v2{0, 1.0};
                        }
                    }

                    if ud.player != null {
                        idx := ud.lane_index * 4 + ud.manager_index;
                        if idx >= 0 && idx < 16 {
                            ud.player.manager_unlock_prompt_entities[idx] = spawned_entity;
                        }
                    }
                }
            );
            return;
        }

        if !warned_missing_manager_unlock_prompt_prefab {
            warned_missing_manager_unlock_prompt_prefab = true;
            log_warning("GameManager: missing ManagerUnlockPrompt.prefab asset (expected prefab at \"ManagerUnlockPrompt.prefab\"). Using runtime placeholder.", {});
        }

        // Runtime placeholder entity (simple manager icon sprite child so it's visible).
        root := Scene.create_entity();
        root->set_local_position(spawn_pos);
        root->set_local_rotation(0);
        root->set_local_scale(v2{1, 1});
        root->set_parent(player.base_entity, true);

        visual := Scene.create_entity();
        visual->set_parent(root, true);
        visual->set_local_position(v2{0, 0});
        visual->set_local_rotation(0);
        visual->set_local_scale(v2{1, 1});
        sr := visual->add_component(Sprite_Renderer);
        if sr != null {
            tex := get_asset(Texture_Asset, "UI/Manager.png");
            if tex != null {
                sr->set_texture(tex);
            }
            sr.depth_offset = 0.5;
            sr.layer = 20;
            sr.color = v4{1, 1, 1, 1};
        }

        mu := root->add_component(ManagerUnlock);
        if mu != null {
            mu->configure(player, lane_index, kind);
            if mu.radius <= 0.01 {
                mu.radius = 2.0;
            }
            if mu.priority == 0 {
                mu.priority = 50;
            }
            if mu.prompt_offset.x == 0.0 && mu.prompt_offset.y == 0.0 {
                mu.prompt_offset = v2{0, 1.0};
            }
        }

        player.manager_unlock_prompt_entities[idx] = root;
    }

    server_reconcile_manager_unlock_prompts_for_player :: method(player: Player) {
        if !Game.is_server() return;
        if player == null return;

        if player.base_entity == null || player.base_entity.self == null {
            this->server_destroy_manager_unlock_prompts_for_player(player);
            return;
        }

        pb := player.base_entity->get_component(PlayerBase);
        if pb == null {
            this->server_destroy_manager_unlock_prompts_for_player(player);
            return;
        }

        for lane: 0..3 {
            // Lanes must be unlocked to show manager prompts at all.
            if !lanes_is_unlocked(player, lane) {
                // Ensure there are no leftover prompts in this (locked) lane.
                for mi: 0..3 {
                    idx := lane * 4 + mi;
                    if idx < 0 || idx >= 16 continue;
                    e := player.manager_unlock_prompt_entities[idx];
                    if e != null && e.self != null {
                        e->destroy();
                    }
                    player.manager_unlock_prompt_entities[idx] = null;
                }
                continue;
            }

            next_mi := this->get_next_locked_manager_index_in_lane(player, lane);
            if next_mi < 0 {
                // All managers in this lane are unlocked; ensure prompts are gone.
                for mi: 0..3 {
                    idx := lane * 4 + mi;
                    if idx < 0 || idx >= 16 continue;
                    e := player.manager_unlock_prompt_entities[idx];
                    if e != null && e.self != null {
                        e->destroy();
                    }
                    player.manager_unlock_prompt_entities[idx] = null;
                }
                continue;
            }

            desired_idx := lane * 4 + next_mi;
            desired_kind := manager_kind_from_index(next_mi);

            // Destroy any other manager prompts in this lane so we only show one at a time.
            for mi: 0..3 {
                idx := lane * 4 + mi;
                if idx < 0 || idx >= 16 continue;
                if idx == desired_idx continue;

                e := player.manager_unlock_prompt_entities[idx];
                if e != null && e.self != null {
                    e->destroy();
                }
                player.manager_unlock_prompt_entities[idx] = null;
            }

            e := player.manager_unlock_prompt_entities[desired_idx];
            if e == null || e.self == null {
                this->server_spawn_manager_unlock_prompt_for_player(player, lane, next_mi);
                continue;
            }

            // Ensure it stays parented under the base and is positioned at the lane anchor (Paper Mill -X).
            e->set_parent(player.base_entity, true);
            anchor := this->manager_unlock_lane_anchor_world_pos(pb, lane);
            // Since base has no rotation/scaling in this project, local = world - base_world is safe.
            base_world := player.base_entity.world_position;
            e->set_local_position(anchor - base_world);

            mu := e->get_component(ManagerUnlock);
            if mu == null {
                mu = e->add_component(ManagerUnlock);
            }
            if mu != null {
                mu->configure(player, lane, desired_kind);
            }
        }
    }

    server_reconcile_manager_unlock_prompts :: method() {
        if !Game.is_server() return;
        foreach p: component_iterator(Player) {
            if p == null continue;
            this->server_reconcile_manager_unlock_prompts_for_player(p);
        }
    }

    woodchipper_unlock_anchor_world_pos :: method(base: PlayerBase) -> v2 {
        if base == null return v2{0, 0};
        if base.entity == null || base.entity.self == null return v2{0, 0};

        harvester := find_harvester_for_base(base);
        if harvester != null && harvester.entity != null && harvester.entity.self != null {
            return harvester.entity.world_position + v2{-1.0, -0.5};
        }
        return base.entity.world_position;
    }

    server_destroy_woodchipper_unlock_prompt_for_player :: method(player: Player) {
        if !Game.is_server() return;
        if player == null return;

        e := player.woodchipper_unlock_prompt_entity;
        if e != null && e.self != null {
            e->destroy();
        }
        player.woodchipper_unlock_prompt_entity = null;
    }

    server_spawn_woodchipper_unlock_prompt_for_player :: method(player: Player) {
        if !Game.is_server() return;
        if player == null return;
        if player.base_entity == null || player.base_entity.self == null return;

        // Don't spawn if already unlocked.
        if player.harvester_manager_unlocked {
            return;
        }

        pb := player.base_entity->get_component(PlayerBase);
        if pb == null return;

        // Only spawn if harvester exists (prompt location is relative to it).
        harvester := find_harvester_for_base(pb);
        if harvester == null || harvester.entity == null || harvester.entity.self == null {
            return;
        }

        // Avoid duplicates.
        existing := player.woodchipper_unlock_prompt_entity;
        if existing != null && existing.self != null {
            return;
        }

        ensure_manager_unlock_prompt_prefab_loaded();
        spawn_pos := this->woodchipper_unlock_anchor_world_pos(pb);

        if cached_manager_unlock_prompt_prefab != null {
            ud := new(Spawn_WoodchipperUnlock_Userdata);
            ud.player = player;
            ud.base_entity = player.base_entity;
            ud.gm = this;

            _ := Scene.instantiate(
                cached_manager_unlock_prompt_prefab,
                spawn_pos,
                ud,
                proc(spawned_entity: Entity, userdata: Object) {
                    ud := userdata.(Spawn_WoodchipperUnlock_Userdata);
                    if ud == null return;
                    if spawned_entity == null return;
                    if spawned_entity.self == null return;

                    // Parent under the base so it is destroyed when the base is destroyed.
                    if ud.base_entity != null && ud.base_entity.self != null {
                        spawned_entity->set_parent(ud.base_entity, true);
                    }

                    mu := spawned_entity->get_component(ManagerUnlock);
                    if mu == null {
                        mu = spawned_entity->add_component(ManagerUnlock);
                    }
                    if mu != null && ud.player != null {
                        mu->configure(ud.player, 0, .WOODCHIPPER);
                        if mu.radius <= 0.01 {
                            mu.radius = 2.0;
                        }
                        if mu.priority == 0 {
                            mu.priority = 50;
                        }
                        if mu.required_hold_time < 0.0 {
                            mu.required_hold_time = 0.0;
                        }
                        if mu.prompt_offset.x == 0.0 && mu.prompt_offset.y == 0.0 {
                            mu.prompt_offset = v2{0, 1.0};
                        }
                    }

                    if ud.player != null {
                        ud.player.woodchipper_unlock_prompt_entity = spawned_entity;
                    }
                }
            );
            return;
        }

        if !warned_missing_manager_unlock_prompt_prefab {
            warned_missing_manager_unlock_prompt_prefab = true;
            log_warning("GameManager: missing ManagerUnlockPrompt.prefab asset (expected prefab at \"ManagerUnlockPrompt.prefab\"). Using runtime placeholder.", {});
        }

        root := Scene.create_entity();
        root->set_local_position(spawn_pos);
        root->set_local_rotation(0);
        root->set_local_scale(v2{1, 1});
        root->set_parent(player.base_entity, true);

        visual := Scene.create_entity();
        visual->set_parent(root, true);
        visual->set_local_position(v2{0, 0});
        visual->set_local_rotation(0);
        visual->set_local_scale(v2{1, 1});
        sr := visual->add_component(Sprite_Renderer);
        if sr != null {
            tex := get_asset(Texture_Asset, "UI/Manager.png");
            if tex != null {
                sr->set_texture(tex);
            }
            sr.depth_offset = 0.5;
            sr.layer = 20;
            sr.color = v4{1, 1, 1, 1};
        }

        mu := root->add_component(ManagerUnlock);
        if mu != null {
            mu->configure(player, 0, .WOODCHIPPER);
            if mu.radius <= 0.01 {
                mu.radius = 2.0;
            }
            if mu.priority == 0 {
                mu.priority = 50;
            }
            if mu.prompt_offset.x == 0.0 && mu.prompt_offset.y == 0.0 {
                mu.prompt_offset = v2{0, 1.0};
            }
        }

        player.woodchipper_unlock_prompt_entity = root;
    }

    server_reconcile_woodchipper_unlock_prompt_for_player :: method(player: Player) {
        if !Game.is_server() return;
        if player == null return;

        if player.base_entity == null || player.base_entity.self == null {
            this->server_destroy_woodchipper_unlock_prompt_for_player(player);
            return;
        }

        // If unlocked, ensure prompt is gone.
        if player.harvester_manager_unlocked {
            this->server_destroy_woodchipper_unlock_prompt_for_player(player);
            return;
        }

        pb := player.base_entity->get_component(PlayerBase);
        if pb == null {
            this->server_destroy_woodchipper_unlock_prompt_for_player(player);
            return;
        }

        harvester := find_harvester_for_base(pb);
        if harvester == null || harvester.entity == null || harvester.entity.self == null {
            this->server_destroy_woodchipper_unlock_prompt_for_player(player);
            return;
        }

        e := player.woodchipper_unlock_prompt_entity;
        if e == null || e.self == null {
            this->server_spawn_woodchipper_unlock_prompt_for_player(player);
            return;
        }

        // Keep it positioned correctly (anchor is in world-space; parent keeps world when true).
        anchor := this->woodchipper_unlock_anchor_world_pos(pb);
        base_world := player.base_entity.world_position;
        e->set_local_position(anchor - base_world);

        mu := e->get_component(ManagerUnlock);
        if mu == null {
            mu = e->add_component(ManagerUnlock);
        }
        if mu != null {
            mu->configure(player, 0, .WOODCHIPPER);
        }
    }

    server_reconcile_woodchipper_unlock_prompts :: method() {
        if !Game.is_server() return;
        foreach p: component_iterator(Player) {
            if p == null continue;
            this->server_reconcile_woodchipper_unlock_prompt_for_player(p);
        }
    }

    server_spawn_woodchipper_at :: method(player: Player, spawn_world_pos: v2) {
        if !Game.is_server() return;
        if player == null return;
        if player.base_entity == null || player.base_entity.self == null return;
        pb := player.base_entity->get_component(PlayerBase);
        if pb == null return;

        // Avoid duplicates.
        if find_woodchipper_for_base(pb) != null {
            return;
        }
        this->server_spawn_woodchipper(pb, player->get_user_id(), spawn_world_pos);
    }

    server_reconcile_lanes :: method() {
        if !Game.is_server() return;

        foreach p: component_iterator(Player) {
            if p == null continue;
            if p.base_entity == null || p.base_entity.self == null continue;

            // Spawn lanes 2-4 if unlocked.
            for lane: 1..3 {
                if !lanes_is_unlocked(p, lane) {
                    continue;
                }
                this->server_spawn_lane_for_player(p, lane);
            }
        }
    }

    request_base_reconcile :: method() {
        if !Game.is_server() {
            return;
        }
        needs_base_reconcile = true;
    }

    // Server-only: push saved per-lane upgrade levels onto this player's stations.
    // Levels are stored on the Player as a flat [16] array: idx = lane_index * 4 + station_index.
    // station_index mapping:
    // 0 = Paper_Mill (Shredder), 1 = Blank_Bill_Press (Paper Press),
    // 2 = Colored_Bill_Press (Color Machine), 3 = Finished_Bill_Press (Stamp Machine)
    server_apply_station_upgrade_levels_for_player :: method(player: Player) {
        if !Game.is_server() return;
        apply_station_upgrade_levels_for_player(player);
    }

    // Apply station upgrade levels for a player on BOTH server + clients.
    // - Server: updates authoritative station speed settings.
    // - Client: updates local station fields so world UI shows correct level/speed immediately.
    apply_station_upgrade_levels_for_player :: method(player: Player) {
        if player == null return;
        if player.base_entity == null || player.base_entity.self == null return;

        pb := player.base_entity->get_component(PlayerBase);
        if pb == null return;

        get_level :: proc(p: Player, lane_index: s64, station_index: s64) -> s64 {
            if p == null return 1;
            if lane_index < 0 || lane_index > 3 return 1;
            if station_index < 0 || station_index > 3 return 1;
            idx := lane_index * 4 + station_index;
            if idx < 0 || idx >= 16 return 1;

            lvl := p.station_upgrade_levels[idx];
            if lvl < 1 {
                lvl = 1;
            }
            if lvl > 10 {
                lvl = 10;
            }
            return lvl;
        }

        foreach m: component_iterator(Paper_Mill) {
            if m == null continue;
            if m.entity == null || m.entity.self == null continue;
            if get_parent_player_base(m.entity) != pb continue;
            lvl := get_level(player, m.lane_index, 0);
            if Game.is_server() {
                m->server_set_upgrade_level(lvl);
            }
            else {
                m->apply_upgrade_level(lvl);
            }
        }
        foreach b: component_iterator(Blank_Bill_Press) {
            if b == null continue;
            if b.entity == null || b.entity.self == null continue;
            if get_parent_player_base(b.entity) != pb continue;
            lvl := get_level(player, b.lane_index, 1);
            if Game.is_server() {
                b->server_set_upgrade_level(lvl);
            }
            else {
                b->apply_upgrade_level(lvl);
            }
        }
        foreach c: component_iterator(Colored_Bill_Press) {
            if c == null continue;
            if c.entity == null || c.entity.self == null continue;
            if get_parent_player_base(c.entity) != pb continue;
            lvl := get_level(player, c.lane_index, 2);
            if Game.is_server() {
                c->server_set_upgrade_level(lvl);
            }
            else {
                c->apply_upgrade_level(lvl);
            }
        }
        foreach f: component_iterator(Finished_Bill_Press) {
            if f == null continue;
            if f.entity == null || f.entity.self == null continue;
            if get_parent_player_base(f.entity) != pb continue;
            lvl := get_level(player, f.lane_index, 3);
            if Game.is_server() {
                f->server_set_upgrade_level(lvl);
            }
            else {
                f->apply_upgrade_level(lvl);
            }
        }
    }

    server_apply_vault_level_for_player :: method(player: Player) {
        if !Game.is_server() return;
        apply_vault_level_for_player(player);
    }

    apply_vault_level_for_player :: method(player: Player) {
        if player == null return;
        if player.base_entity == null || player.base_entity.self == null return;

        pb := player.base_entity->get_component(PlayerBase);
        if pb == null return;

        lvl := player.vault_level;
        if lvl < 1 lvl = 1;
        if lvl > VAULT_MAX_LEVEL lvl = VAULT_MAX_LEVEL;

        foreach v: component_iterator(Vault) {
            if v == null continue;
            if v.entity == null || v.entity.self == null continue;
            if get_parent_player_base(v.entity) != pb continue;
            if Game.is_server() {
                v->server_set_upgrade_level(lvl);
            }
            else {
                v->apply_upgrade_level(lvl);
            }
        }
    }

    server_on_player_left :: method(player: Player) {
        if !Game.is_server() return;
        if player == null return;

        // Persist player base state before cleanup.
        if player.base_entity != null && player.base_entity.self != null {
            pb := player.base_entity->get_component(PlayerBase);
            if pb != null {
                vault := find_vault_for_base(pb);
                if vault != null {
                    // Make sure we don't clobber an older save with an uninitialized vault value.
                    vault->server_try_load_from_save();
                    Save.set_int(player, VAULT_SAVE_KEY_FINISHED_BILLS, vault.stored_finished_bills);
                }

                // Persist station storage per lane (sorted by lane_index for determinism).
                {
                    mills: [..]Paper_Mill;
                    blanks: [..]Blank_Bill_Press;
                    coloreds: [..]Colored_Bill_Press;
                    finisheds: [..]Finished_Bill_Press;

                    foreach m: component_iterator(Paper_Mill) {
                        if m == null continue;
                        if m.entity == null || m.entity.self == null continue;
                        if get_parent_player_base(m.entity) != pb continue;
                        mills->append(m);
                    }
                    foreach b: component_iterator(Blank_Bill_Press) {
                        if b == null continue;
                        if b.entity == null || b.entity.self == null continue;
                        if get_parent_player_base(b.entity) != pb continue;
                        blanks->append(b);
                    }
                    foreach c: component_iterator(Colored_Bill_Press) {
                        if c == null continue;
                        if c.entity == null || c.entity.self == null continue;
                        if get_parent_player_base(c.entity) != pb continue;
                        coloreds->append(c);
                    }
                    foreach f: component_iterator(Finished_Bill_Press) {
                        if f == null continue;
                        if f.entity == null || f.entity.self == null continue;
                        if get_parent_player_base(f.entity) != pb continue;
                        finisheds->append(f);
                    }

                    // Selection sort by lane_index (ascending)
                    for i: 0..mills.count-1 {
                        best := i;
                        for j: i+1..mills.count-1 {
                            if mills[j].lane_index < mills[best].lane_index {
                                best = j;
                            }
                        }
                        if best != i {
                            tmp := mills[i];
                            mills[i] = mills[best];
                            mills[best] = tmp;
                        }
                    }
                    for i: 0..blanks.count-1 {
                        best := i;
                        for j: i+1..blanks.count-1 {
                            if blanks[j].lane_index < blanks[best].lane_index {
                                best = j;
                            }
                        }
                        if best != i {
                            tmp := blanks[i];
                            blanks[i] = blanks[best];
                            blanks[best] = tmp;
                        }
                    }
                    for i: 0..coloreds.count-1 {
                        best := i;
                        for j: i+1..coloreds.count-1 {
                            if coloreds[j].lane_index < coloreds[best].lane_index {
                                best = j;
                            }
                        }
                        if best != i {
                            tmp := coloreds[i];
                            coloreds[i] = coloreds[best];
                            coloreds[best] = tmp;
                        }
                    }
                    for i: 0..finisheds.count-1 {
                        best := i;
                        for j: i+1..finisheds.count-1 {
                            if finisheds[j].lane_index < finisheds[best].lane_index {
                                best = j;
                            }
                        }
                        if best != i {
                            tmp := finisheds[i];
                            finisheds[i] = finisheds[best];
                            finisheds[best] = tmp;
                        }
                    }

                    for i: 0..mills.count-1 {
                        mill := mills[i];
                        if mill == null continue;
                        mill->server_try_load_from_save();
                        lane := mill.lane_index;
                        if lane < 0 lane = 0;
                        if mill.stored_wood < 0 mill.stored_wood = 0;
                        if mill.stored_paper < 0 mill.stored_paper = 0;
                        Save.set_int(player, paper_mill_save_key_wood(lane), mill.stored_wood);
                        Save.set_int(player, paper_mill_save_key_paper(lane), mill.stored_paper);
                    }

                    for i: 0..blanks.count-1 {
                        press := blanks[i];
                        if press == null continue;
                        press->server_try_load_from_save();
                        lane := press.lane_index;
                        if lane < 0 lane = 0;
                        if press.stored_paper < 0 press.stored_paper = 0;
                        if press.stored_blank_bills < 0 press.stored_blank_bills = 0;
                        Save.set_int(player, blank_bill_press_save_key_paper(lane), press.stored_paper);
                        Save.set_int(player, blank_bill_press_save_key_blank_bills(lane), press.stored_blank_bills);
                    }

                    for i: 0..coloreds.count-1 {
                        press := coloreds[i];
                        if press == null continue;
                        press->server_try_load_from_save();
                        lane := press.lane_index;
                        if lane < 0 lane = 0;
                        if press.stored_blank_bills < 0 press.stored_blank_bills = 0;
                        if press.stored_colored_bills < 0 press.stored_colored_bills = 0;
                        Save.set_int(player, colored_bill_press_save_key_blank_bills(lane), press.stored_blank_bills);
                        Save.set_int(player, colored_bill_press_save_key_colored_bills(lane), press.stored_colored_bills);
                    }

                    for i: 0..finisheds.count-1 {
                        press := finisheds[i];
                        if press == null continue;
                        press->server_try_load_from_save();
                        lane := press.lane_index;
                        if lane < 0 lane = 0;
                        if press.stored_colored_bills < 0 press.stored_colored_bills = 0;
                        if press.stored_finished_bills < 0 press.stored_finished_bills = 0;
                        Save.set_int(player, finished_bill_press_save_key_colored_bills(lane), press.stored_colored_bills);
                        Save.set_int(player, finished_bill_press_save_key_finished_bills(lane), press.stored_finished_bills);
                    }
                }
            }
        }

        // Best-effort cleanup: destroy the base they owned.
        if player.base_entity != null && player.base_entity.self != null {
            // Base despawn: rebuild navmesh ASAP on server.
            mark_navmesh_for_rebuild();
            player.base_entity->destroy();
        }

        player.base_entity = null;
        player.base_spawn_index = -1;

        // Next tick, backfill the freed slot to a player without a base.
        needs_base_reconcile = true;
    }

    ensure_player_base_prefab_loaded :: method() {
        if cached_player_base_prefab != null {
            return;
        }
        if player_base_prefab_path.count == 0 {
            return;
        }
        cached_player_base_prefab = get_asset(Prefab_Asset, player_base_prefab_path);
    }

