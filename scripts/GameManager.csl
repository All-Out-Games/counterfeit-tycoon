        }

        ud := new(Spawn_Woodchipper_Userdata);
        ud.base_entity = base.entity;
        ud.owner_user_id = owner_user_id;

        _ := Scene.instantiate(
            cached_woodchipper_prefab,
            spawn_pos,
            ud,
            proc(spawned_entity: Entity, userdata: Object) {
                ud := userdata.(Spawn_Woodchipper_Userdata);
                if ud == null return;
                if spawned_entity == null return;
                if spawned_entity.self == null return;

                // Parent under the base so it is destroyed when the base is destroyed.
                if ud.base_entity != null && ud.base_entity.self != null {
                    spawned_entity->set_parent(ud.base_entity, true);
                }

                w := spawned_entity->get_component(Woodchipper);
                if w != null {
                    w->server_init(ud.owner_user_id);
                }
                else {
                    log_warning("GameManager: Woodchipper prefab is missing Woodchipper component on its root entity", {});
                }
            }
        );
    }

    server_reconcile_woodchippers :: method() {
        if !Game.is_server() return;

        foreach p: component_iterator(Player) {
            if p == null continue;
            if p.base_entity == null || p.base_entity.self == null continue;

            pb := p.base_entity->get_component(PlayerBase);
            if pb == null continue;

            unlocked := p.harvester_manager_unlocked;

            existing := find_woodchipper_for_base(pb);

            if unlocked {
                if existing == null {
                    spawn_pos := this->woodchipper_unlock_anchor_world_pos(pb);
                    server_spawn_woodchipper(pb, p->get_user_id(), spawn_pos);
                }
            }
            else {
                if existing != null && existing.entity != null && existing.entity.self != null {
                    existing.entity->destroy();
                }
            }
        }
    }

    get_spawn_position :: method(spawn_index: s64) -> v2, bool {
        if spawn_index < 0 || spawn_index >= 6 {
            return v2{}, false;
        }

        spawn_e := PlayerSpawns[spawn_index];
        if spawn_e == null return v2{}, false;
        if spawn_e.self == null return v2{}, false;

        return spawn_e.world_position, true;
    }

    server_reconcile_player_bases :: method() {
        MAX_BASES :: 6;

        // Track which indices are already taken.
        used: [6]bool;

        // 1) Validate existing assignments and mark used slots.
        foreach p: component_iterator(Player) {
            if p == null continue;

            // Clear invalid base refs so they can be reassigned.
            if p.base_spawn_index < 0 || p.base_spawn_index >= MAX_BASES {
                p.base_spawn_index = -1;
                p.base_entity = null;
                continue;
            }

            if p.base_entity != null && p.base_entity.self != null {
                used[p.base_spawn_index] = true;

                // Ensure base-specific mirrored layout entities are positioned correctly (e.g. after layout changes).
                pb := p.base_entity->get_component(PlayerBase);
                if pb != null {
                    pb->apply_layout_mirror_y_for_spawn_index(p.base_spawn_index);
                }

                // Existing base assignment: ensure stations reflect saved upgrade levels.
                this->server_apply_station_upgrade_levels_for_player(p);
                this->server_apply_vault_level_for_player(p);
            }
            else {
                // Reserved index but no base entity (e.g., prefab missing or base destroyed)
                // Treat as no-base so we can attempt a respawn.
                p.base_entity = null;
            }
        }

        // 2) Assign bases to players who don't have one yet, while slots are available.
        foreach p: component_iterator(Player) {
            if p == null continue;

            if p.base_entity != null && p.base_entity.self != null {
                continue; // already has a base
            }

            // Find a free spawn index with a valid spawn entity.
            free_idx: s64 = -1;
            for i: 0..MAX_BASES-1 {
                if used[i] continue;
                if PlayerSpawns[i] == null continue;
                if PlayerSpawns[i].self == null continue;
                free_idx = i;
                break;
            }

            if free_idx < 0 {
                // No slots left. Warp to 0,0 as requested.
                if p.entity != null && p.entity.self != null {
                    p.entity->set_local_position(v2{0, 0});
                }
                p.base_spawn_index = -1;
                p.base_entity = null;
                continue;
            }

            spawn_pos, ok := get_spawn_position(free_idx);
            if !ok {
                // Shouldn't happen since we validated above, but be defensive.
                used[free_idx] = true;
                continue;
            }

            // Teleport the player near their base (offset from the PlayerSpawn center).
            if p.entity != null && p.entity.self != null {
                // Players 1-3 (spawn 0-2) spawn a bit LOWER; players 4-6 (spawn 3-5) spawn a bit HIGHER.
                offset := v2{0, -2};
                if free_idx >= 3 {
                    offset = v2{0, 2};
                }
                p.entity->set_local_position(spawn_pos + offset);
            }

            // Spawn a PlayerBase prefab for them (server-only).
            ensure_player_base_prefab_loaded();
            if cached_player_base_prefab == null {
                if !warned_missing_base_prefab {
                    warned_missing_base_prefab = true;
                    log_warning("GameManager: player_base_prefab_path is empty or invalid (set it to something like \"Plots/PlayerBase.prefab\")", {});
                }

                // Reserve the slot anyway so we don't stack all players on the same spawn.
                p.base_spawn_index = free_idx;
                p.base_entity = null;
                used[free_idx] = true;
                continue;
            }

            ud := new(Spawn_Base_Userdata);
            ud.player = p;
            ud.spawn_index = free_idx;
            ud.gm = this;

            spawned := Scene.instantiate(
                cached_player_base_prefab,
                spawn_pos,
                ud,
                proc(spawned_entity: Entity, userdata: Object) {
                    ud := userdata.(Spawn_Base_Userdata);
                    if ud == null return;

                    player := ud.player;
                    spawn_index := ud.spawn_index;
                    if player == null return;
                    if spawned_entity == null return;
                    if spawned_entity.self == null return;

                    pb := spawned_entity->get_component(PlayerBase);
                    if pb != null {
                        pb->set_owner(player);

                        // Adjust the truck's local starting position based on which PlayerSpawn this base is using.
                        // - Player 1/2/3 (spawn 0/1/2): leave truck where it is in the prefab.
                        // - Player 4/5/6 (spawn 3/4/5): set local Y to 10.0.
                        if spawn_index >= 3 {
                            truck := find_truck_for_base(pb);
                            if truck != null && truck.entity != null && truck.entity.self != null {
                                lp := truck.entity.local_position;
                                lp.y = 10.0;
                                truck.entity->set_local_position(lp);
                            }

                            // Same as Truck, but only alter Y: keep prefab X and set local Y to 10.0.
                            harvester := find_harvester_for_base(pb);
                            if harvester != null && harvester.entity != null && harvester.entity.self != null {
                                lp := harvester.entity.local_position;
                                lp.y = 10.0;
                                harvester.entity->set_local_position(lp);
                            }
                        }

                        // Snap any configured "layout mirror" entities to their correct local Y.
                        pb->apply_layout_mirror_y_for_spawn_index(spawn_index);
                    }

                    // Now that ownership is established, apply the player's station upgrade levels.
                    gm := ud.gm;
                    if gm != null {
                        gm->server_apply_station_upgrade_levels_for_player(player);
                        gm->server_apply_vault_level_for_player(player);
                        // Base spawned: rebuild navmesh ASAP on server.
                        gm->mark_navmesh_for_rebuild();
                    }
                }
            );

            p.base_spawn_index = free_idx;
            p.base_entity = spawned;
            used[free_idx] = true;
        }
    }
}

get_game_manager :: proc() -> GameManager {
    // Returns the first GameManager component found in the scene (or null if none exist)
    foreach gm: component_iterator(GameManager) {
        return gm;
    }
    return null;
}