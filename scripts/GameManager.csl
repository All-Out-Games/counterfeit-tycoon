            if c == null continue;
            if c.entity == null || c.entity.self == null continue;
            if !c.entity->get_world_enabled() continue;
            if c.lane_index != lane_index continue;

            pb := get_parent_player_base(c.entity);
            if pb == base {
                return c;
            }
