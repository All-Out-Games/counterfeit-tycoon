import "core:ao"

// Turret item ids (3 tiers).
TURRET_ITEM_ID_TIER_1 :: "turret_tier_1";
TURRET_ITEM_ID_TIER_2 :: "turret_tier_2";
TURRET_ITEM_ID_TIER_3 :: "turret_tier_3";

TURRET_MAX_PER_BASE :: 4;
TURRET_BASE_HALF_SIZE :: 10.0; // Matches current base safe-zone half size.
TURRET_STATION_CLEARANCE_RADIUS :: 1.5;
TURRET_SAVE_KEY :: "turret_placements";
TURRET_SAVE_VERSION :: 1;
TURRET_HEALTH_STEP :: 100;
TURRET_FIRE_ANIM_DURATION :: 0.16;

Turret_Save_Entry :: class {
    tier: s64 @ao_serialize;
    rel_x: float @ao_serialize;
    rel_y: float @ao_serialize;
    hp: s64 @ao_serialize;
}

Turret_Save_Data :: class {
    version: s64 @ao_serialize;
    entries: [..]Turret_Save_Entry @ao_serialize;
}

turret_item_tier_from_definition :: proc(defn: Item_Definition) -> s64 {
    if defn == null return 0;
    id := defn.get_id();
    switch id {
        case TURRET_ITEM_ID_TIER_1: return 1;
        case TURRET_ITEM_ID_TIER_2: return 2;
        case TURRET_ITEM_ID_TIER_3: return 3;
    }
    return 0;
}

turret_is_item_definition :: proc(defn: Item_Definition) -> bool {
    return turret_item_tier_from_definition(defn) > 0;
}

turret_is_position_inside_base :: proc(base_entity: Entity, pos: v2) -> bool {
    if base_entity == null || base_entity.self == null return false;
    base_pos := base_entity.world_position;
    dx := abs(pos.x - base_pos.x);
    dy := abs(pos.y - base_pos.y);
    return dx <= TURRET_BASE_HALF_SIZE && dy <= TURRET_BASE_HALF_SIZE;
}

turret_is_position_inside_player_base :: proc(player: Player, pos: v2) -> bool {
    if player == null return false;
    if player.base_entity == null || player.base_entity.self == null return false;
    return turret_is_position_inside_base(player.base_entity, pos);
}

turret_is_too_close_to_any_station_in_base :: proc(base: PlayerBase, pos: v2) -> bool {
    if base == null return false;
    if base.entity == null || base.entity.self == null return false;

    // Build stations that physically occupy base space and should block turret placement.
    foreach m: component_iterator(Paper_Mill) {
        if m == null continue;
        if m.entity == null || m.entity.self == null continue;
        if get_parent_player_base(m.entity) != base continue;
        if length(m.entity.world_position - pos) < TURRET_STATION_CLEARANCE_RADIUS return true;
    }
    foreach m: component_iterator(Blank_Bill_Press) {
        if m == null continue;
        if m.entity == null || m.entity.self == null continue;
        if get_parent_player_base(m.entity) != base continue;
        if length(m.entity.world_position - pos) < TURRET_STATION_CLEARANCE_RADIUS return true;
    }
    foreach m: component_iterator(Colored_Bill_Press) {
        if m == null continue;
        if m.entity == null || m.entity.self == null continue;
        if get_parent_player_base(m.entity) != base continue;
        if length(m.entity.world_position - pos) < TURRET_STATION_CLEARANCE_RADIUS return true;
    }
    foreach m: component_iterator(Finished_Bill_Press) {
        if m == null continue;
        if m.entity == null || m.entity.self == null continue;
        if get_parent_player_base(m.entity) != base continue;
        if length(m.entity.world_position - pos) < TURRET_STATION_CLEARANCE_RADIUS return true;
    }
    foreach m: component_iterator(Vault) {
        if m == null continue;
        if m.entity == null || m.entity.self == null continue;
        if get_parent_player_base(m.entity) != base continue;
        if length(m.entity.world_position - pos) < TURRET_STATION_CLEARANCE_RADIUS return true;
    }
    foreach m: component_iterator(Harvester) {
        if m == null continue;
        if m.entity == null || m.entity.self == null continue;
        if get_parent_player_base(m.entity) != base continue;
        if length(m.entity.world_position - pos) < TURRET_STATION_CLEARANCE_RADIUS return true;
    }
    foreach m: component_iterator(Truck) {
        if m == null continue;
        if m.entity == null || m.entity.self == null continue;
        if get_parent_player_base(m.entity) != base continue;
        if length(m.entity.world_position - pos) < TURRET_STATION_CLEARANCE_RADIUS return true;
    }

    return false;
}

turret_is_too_close_to_player_station :: proc(player: Player, pos: v2) -> bool {
    if player == null return false;
    if player.base_entity == null || player.base_entity.self == null return false;
    base := player.base_entity.get_component(PlayerBase);
    if base == null return false;
    return turret_is_too_close_to_any_station_in_base(base, pos);
}

turret_get_drop_target_world_pos :: proc(player: Player) -> v2 {
    if player == null return v2{0, 0};
    if player.entity == null || player.entity.self == null return v2{0, 0};

    // Hotbar drag/drop target: use the current pointer world position.
    // This works for cursor-based and touch-based world targeting.
    target := get_mouse_world_position();

    // If pointer position looks invalid, fall back to the player's position.
    if target.x == 0.0 && target.y == 0.0 {
        target = player.entity.world_position;
    }
    return target;
}

turret_is_position_inside_box_centered_at :: proc(pos: v2, center: v2, half_size: float) -> bool {
    dx := abs(pos.x - center.x);
    dy := abs(pos.y - center.y);
    return dx <= half_size && dy <= half_size;
}

turret_count_for_base :: proc(base: PlayerBase) -> s64 {
    if base == null return 0;
    if base.entity == null || base.entity.self == null return 0;

    count: s64 = 0;
    foreach t: component_iterator(Turret) {
        if t == null continue;
        if t.entity == null || t.entity.self == null continue;
        if !t.entity.get_world_enabled() continue;
        if get_parent_player_base(t.entity) != base continue;
        count += 1;
    }
    return count;
}

turret_count_for_player :: proc(player: Player) -> s64 {
    if player == null return 0;
    if player.base_entity == null || player.base_entity.self == null return 0;
    pb := player.base_entity.get_component(PlayerBase);
    if pb == null return 0;
    return turret_count_for_base(pb);
}

turret_save_player_data_excluding_entity_id :: proc(player: Player, excluded_entity_id: u64 = 0) {
    if !Game.is_server() return;
    if player == null return;

    save := new(Turret_Save_Data);
    save.version = TURRET_SAVE_VERSION;

    if player.base_entity == null || player.base_entity.self == null {
        Save.set_json(player, TURRET_SAVE_KEY, ref save);
        return;
    }

    pb := player.base_entity.get_component(PlayerBase);
    if pb == null {
        Save.set_json(player, TURRET_SAVE_KEY, ref save);
        return;
    }

    foreach t: component_iterator(Turret) {
        if t == null continue;
        if t.entity == null || t.entity.self == null continue;
        if excluded_entity_id != 0 && t.entity.id == excluded_entity_id continue;
        if !t.entity.get_world_enabled() continue;
        if get_parent_player_base(t.entity) != pb continue;

        if save.entries.count >= TURRET_MAX_PER_BASE {
            break;
        }

        entry := new(Turret_Save_Entry);
        entry.tier = t.tier;
        if entry.tier < 1 entry.tier = 1;
        if entry.tier > 3 entry.tier = 3;
        max_hp := t.hp_max;
        if max_hp <= 0 {
            max_hp = t.get_max_health();
        }
        if max_hp <= 0 {
            max_hp = TURRET_HEALTH_STEP;
        }
        entry.hp = t.hp;
        if entry.hp < 1 entry.hp = 1;
        if entry.hp > max_hp entry.hp = max_hp;

        lp := t.entity.local_position;
        entry.rel_x = lp.x;
        entry.rel_y = lp.y;
        save.entries.append(entry);
    }

    Save.set_json(player, TURRET_SAVE_KEY, ref save);
}

turret_save_player_data :: proc(player: Player) {
    turret_save_player_data_excluding_entity_id(player, 0);
}

turret_clear_for_player_base :: proc(player: Player) {
    if player == null return;
    if player.base_entity == null || player.base_entity.self == null return;
    pb := player.base_entity.get_component(PlayerBase);
    if pb == null return;

    to_destroy: [..]Entity;
    foreach t: component_iterator(Turret) {
        if t == null continue;
        if t.entity == null || t.entity.self == null continue;
        if get_parent_player_base(t.entity) != pb continue;
        to_destroy.append(t.entity);
    }

    for e: to_destroy {
        if e != null && e.self != null {
            e.destroy();
        }
    }
}

turret_load_player_data :: proc(player: Player, gm: GameManager) {
    if !Game.is_server() return;
    if player == null return;
    if gm == null return;
    if player.base_entity == null || player.base_entity.self == null return;

    turret_clear_for_player_base(player);

    save: Turret_Save_Data;
    if !Save.try_get_json(player, TURRET_SAVE_KEY, ref save) {
        return;
    }

    base_pos := player.base_entity.world_position;
    spawned: s64 = 0;

    for entry: save.entries {
        if entry == null continue;
        if spawned >= TURRET_MAX_PER_BASE break;
        if entry.tier < 1 || entry.tier > 3 continue;
        if entry.hp <= 0 continue;

        spawn_pos := base_pos + v2{entry.rel_x, entry.rel_y};
        if !turret_is_position_inside_player_base(player, spawn_pos) {
            continue;
        }
        if turret_is_too_close_to_player_station(player, spawn_pos) {
            continue;
        }

        if gm.server_spawn_turret_for_player(player, entry.tier, spawn_pos, false, entry.hp) {
            spawned += 1;
        }
    }

    // Normalize save payload (clamped tiers/count + valid positions only).
    turret_save_player_data(player);
}

// Returns true when the drop was a turret item and has been handled
// (successful placement OR rejected with feedback).
turret_handle_inventory_drop :: proc(player: Player, dropped_item: Item_Instance, place_pos: v2) -> bool {
    if !Game.is_server() return false;
    if player == null return false;
    if dropped_item == null return false;

    defn := dropped_item.get_definition();
    tier := turret_item_tier_from_definition(defn);
    if tier <= 0 {
        return false;
    }

    if !turret_is_position_inside_player_base(player, place_pos) {
        Notifier.notify(player, "You can only place turrets inside your base.");
        return true;
    }
    if turret_is_too_close_to_player_station(player, place_pos) {
        Notifier.notify(player, "Turrets must be at least % units away from stations.", {format_float(TURRET_STATION_CLEARANCE_RADIUS, decimals=1)});
        return true;
    }

    if turret_count_for_player(player) >= TURRET_MAX_PER_BASE {
        Notifier.notify(player, "You can only place up to % turrets.", {TURRET_MAX_PER_BASE});
        return true;
    }

    gm := get_game_manager();
    if gm == null {
        Notifier.notify(player, "Can't place turret right now.");
        return true;
    }

    if !gm.server_spawn_turret_for_player(player, tier, place_pos, true) {
        Notifier.notify(player, "Can't place turret right now.");
        return true;
    }

    // Consume one turret item on successful placement.
    if dropped_item.quantity <= 1 {
        Items.destroy_item_instance(dropped_item);
    }
    else {
        Items.destroy_item_instance(dropped_item, 1);
    }

    //Notifier.notify(player, "Placed Tier % Turret.", {tier});
    return true;
}

// Client-side UX helper:
// mirrors server placement checks so local players get immediate feedback.
turret_get_local_place_block_reason :: proc(player: Player, dropped_item: Item_Instance, place_pos: v2) -> string {
    if player == null return {};
    if dropped_item == null return {};

    defn := dropped_item.get_definition();
    tier := turret_item_tier_from_definition(defn);
    if tier <= 0 {
        return {};
    }

    if !turret_is_position_inside_player_base(player, place_pos) {
        return "You can only place turrets inside your base.";
    }
    if turret_is_too_close_to_player_station(player, place_pos) {
        return format_string("Turrets must be at least % units away from stations.", {format_float(TURRET_STATION_CLEARANCE_RADIUS, decimals=1)});
    }
    if turret_count_for_player(player) >= TURRET_MAX_PER_BASE {
        return format_string("You can only place up to % turrets.", {TURRET_MAX_PER_BASE});
    }

    return {};
}

turret_find_player_by_entity_id :: proc(entity_id: u64) -> Player {
    if entity_id == 0 return null;
    foreach p: component_iterator(Player) {
        if p == null continue;
        if p.entity == null || p.entity.self == null continue;
        if p.entity.id == entity_id {
            return p;
        }
    }
    return null;
}

turret_find_player_by_user_id :: proc(user_id: string) -> Player {
    if user_id.count <= 0 return null;
    foreach p: component_iterator(Player) {
        if p == null continue;
        if p.get_user_id() == user_id {
            return p;
        }
    }
    return null;
}

turret_try_register_weapon_hit_nearest :: proc(pos: v2, radius: float, shooter_entity_id: u64, damage: float) -> bool {
    if !Game.is_server() return false;
    hit_turret, found := Scene.get_closest_component_in_range(pos, radius, Turret);
    if !found || hit_turret == null return false;
    return hit_turret.server_register_weapon_hit(shooter_entity_id, damage);
}

turret_apply_weapon_aoe_damage :: proc(pos: v2, radius: float, shooter_entity_id: u64, damage: float) {
    if !Game.is_server() return;
    nearby_turrets: [..]Turret;
    Scene.get_all_components_in_range(pos, radius, ref nearby_turrets);
    for t: nearby_turrets {
        if t == null continue;
        _ := t.server_register_weapon_hit(shooter_entity_id, damage);
    }
}

turret_rotate_v2 :: proc(v: v2, angle_rad: float) -> v2 {
    c := cos(angle_rad);
    s := sin(angle_rad);
    return v2{v.x * c - v.y * s, v.x * s + v.y * c};
}

turret_world_to_spine_local :: proc(spine_entity: Entity, world_pos: v2) -> v2 {
    if spine_entity == null || spine_entity.self == null return world_pos;

    delta := world_pos - spine_entity.world_position;
    inv_rot_rad := -spine_entity.world_rotation * (PI / 180.0);
    unrotated := turret_rotate_v2(delta, inv_rot_rad);

    s := spine_entity.local_scale;
    // Use signed scale so IK coordinates correctly mirror when X flip is applied.
    sx := s.x;
    sy := s.y;
    if abs(sx) <= 0.0001 sx = 1.0;
    if abs(sy) <= 0.0001 sy = 1.0;

    return v2{unrotated.x / sx, unrotated.y / sy};
}

Turret_Projectile :: class : Component {
    damage: float;
    lifetime: float;
    direction: v2;
    owner_user_id: string;
    speed: float;
    max_lifetime: float;
    base_center: v2;
    base_half_size: float;

    ao_update :: method(dt: float) {
        lifetime += dt;
        if max_lifetime <= 0 {
            max_lifetime = 3.0;
        }
        if lifetime > max_lifetime {
            entity.destroy();
            return;
        }

        move := v2{direction.x * speed * dt, direction.y * speed * dt};
        entity.add_local_position(move);

        // Keep projectile combat strictly inside the base bounds.
        if !turret_is_position_inside_box_centered_at(entity.world_position, base_center, base_half_size) {
            entity.destroy();
            return;
        }

        if !Game.is_server() return;

        pos := entity.world_position;
        hit_player, found := Scene.get_closest_component_in_range(pos, 0.8, Player);
        if !found || hit_player == null {
            return;
        }
        if hit_player.entity == null || hit_player.entity.self == null {
            return;
        }
        if hit_player.get_user_id() == owner_user_id {
            return;
        }
        if !turret_is_position_inside_box_centered_at(hit_player.entity.world_position, base_center, base_half_size) {
            return;
        }

        did_damage := hit_player.take_damage(damage, null, true);
        if did_damage {
            hit_sfx := get_asset(SFX_Asset, "reusable_weapons/sounds/reusable-weapons/bullet_hit.wav");
            sfx_desc := SFX.default_sfx_desc();
            sfx_desc.set_position(pos);
            sfx_desc.range_multiplier = 2.0;
            SFX.play(hit_sfx, sfx_desc);
        }
        entity.destroy();
    }
}

Turret :: class : Component {
    owner_user_id: string;
    tier: s64;
    spine_animator: Spine_Animator @ao_serialize;
    fire_cooldown: float;
    hp: s64;
    hp_max: s64;
    spine_state_machine: State_Machine;
    has_target: bool;
    target_world_pos: v2;
    fire_anim_t: float;

    server_init :: method(owner_uid: string, turret_tier: s64, initial_hp: s64 = -1) {
        owner_user_id = owner_uid;
        tier = turret_tier;
        if tier < 1 tier = 1;
        if tier > 3 tier = 3;

        if spine_animator == null {
            spine_animator = entity.get_component(Spine_Animator);
        }

        hp_max = get_max_health();
        hp = hp_max;
        if initial_hp > 0 {
            hp = initial_hp;
            if hp > hp_max {
                hp = hp_max;
            }
        }
    }

    setup_spine_state_machine :: method() {
        if spine_state_machine != null return;
        if spine_animator == null return;
        if spine_animator.entity == null || spine_animator.entity.self == null return;

        spine_animator.awaken();
        if spine_animator.instance == null return;

        sm := State_Machine.create();
        layer := sm.create_layer("main", 0);

        firing_var := sm.create_variable("firing", .BOOL);
        aim_state := layer.create_state("RED013/Aim_mIK", true);
        fire_state := layer.create_state("RED013/Fire_mIK", false);
        layer.set_initial_state(aim_state);

        aim_to_fire := layer.create_transition(aim_state, fire_state, false);
        aim_to_fire.create_bool_condition(firing_var, true);

        fire_to_aim := layer.create_transition(fire_state, aim_state, false);
        fire_to_aim.create_bool_condition(firing_var, false);

        spine_animator.instance.set_state_machine(sm, true); // transfer ownership to spine instance
        spine_state_machine = sm;
    }

    update_spine_ik :: method() {
        if !has_target return;
        if spine_animator == null return;
        if spine_animator.entity == null || spine_animator.entity.self == null return;

        // Face the target by flipping spine X scale.
        // Right side => +1, left side => -1.
        target_is_right := target_world_pos.x > entity.world_position.x;
        scale := spine_animator.entity.local_scale;
        scale.x = target_is_right ? 1.0 : -1.0;
        spine_animator.entity.set_local_scale(scale);

        spine_animator.awaken();
        if spine_animator.instance == null return;

        aim_local := turret_world_to_spine_local(spine_animator.entity, target_world_pos);
        spine_animator.instance.set_bone_local_position("AIM", aim_local);
    }

    update_spine_visual_state :: method() {
        setup_spine_state_machine();
        if spine_animator == null return;
        if spine_animator.instance == null return;
        if spine_animator.instance.state_machine == null return;

        // Fire animation plays only while actively firing at a valid target.
        firing_now := has_target && fire_anim_t > 0.0;
        spine_animator.instance.state_machine.set_bool("firing", firing_now);
    }

    get_max_health :: method() -> s64 {
        if tier < 1 return TURRET_HEALTH_STEP;
        if tier > 3 return 3 * TURRET_HEALTH_STEP;
        return tier * TURRET_HEALTH_STEP;
    }

    get_damage :: method() -> float {
        switch tier {
            case 1: return 6.0;
            case 2: return 9.0;
            case 3: return 13.0;
        }
        return 6.0;
    }

    get_fire_rate :: method() -> float {
        switch tier {
            case 1: return 0.7;
            case 2: return 0.5;
            case 3: return 0.35;
        }
        return 0.7;
    }

    get_projectile_speed :: method() -> float {
        switch tier {
            case 1: return 13.0;
            case 2: return 16.0;
            case 3: return 19.0;
        }
        return 13.0;
    }

    find_target_in_base :: method(pb: PlayerBase) -> Player {
        if pb == null return null;
        if pb.entity == null || pb.entity.self == null return null;

        center := pb.entity.world_position;
        best: Player;
        best_dist_sq := 99999999.0;

        foreach p: component_iterator(Player) {
            if p == null continue;
            if p.entity == null || p.entity.self == null continue;
            if p.get_user_id() == owner_user_id continue;

            p_pos := p.entity.world_position;
            if !turret_is_position_inside_box_centered_at(p_pos, center, TURRET_BASE_HALF_SIZE) {
                continue;
            }

            delta := p_pos - entity.world_position;
            d2 := delta.x * delta.x + delta.y * delta.y;
            if d2 < best_dist_sq {
                best_dist_sq = d2;
                best = p;
            }
        }

        return best;
    }

    fire_at_target :: method(target: Player, pb: PlayerBase) {
        if target == null return;
        if target.entity == null || target.entity.self == null return;
        if pb == null || pb.entity == null || pb.entity.self == null return;

        start := entity.world_position;
        to_target := target.entity.world_position - start;
        dist_sq := to_target.x * to_target.x + to_target.y * to_target.y;
        if dist_sq <= 0.0001 {
            return;
        }

        dir := normalize(to_target);

        proj_entity := Scene.create_entity();
        proj_entity.set_local_position(start);
        proj_entity.set_local_rotation(to_degrees(atan2(dir.y, dir.x)));
        proj_entity.set_local_scale(v2{1.3, 1.3});

        bullet_texture := get_asset(Texture_Asset, "reusable_weapons/sprites/reusable-weapons/projectiles/MachineGunBullet.png");
        sprite := proj_entity.add_component(Sprite_Renderer);
        if sprite != null && bullet_texture != null {
            sprite.set_texture(bullet_texture);
        }

        proj := proj_entity.add_component(Turret_Projectile);
        proj.damage = get_damage();
        proj.direction = dir;
        proj.owner_user_id = owner_user_id;
        proj.speed = get_projectile_speed();
        proj.max_lifetime = 1.5;
        proj.base_center = pb.entity.world_position;
        proj.base_half_size = TURRET_BASE_HALF_SIZE;
    }

    get_owner_entity_id :: method() -> u64 {
        if owner_user_id.count <= 0 return 0;
        owner := turret_find_player_by_user_id(owner_user_id);
        if owner == null return 0;
        if owner.entity == null || owner.entity.self == null return 0;
        return owner.entity.id;
    }

    can_be_shot_by_entity_id :: method(shooter_entity_id: u64) -> bool {
        if !Game.is_server() return false;
        if shooter_entity_id == 0 return false;

        pb := get_parent_player_base(entity);
        if pb == null || pb.entity == null || pb.entity.self == null return false;

        shooter := turret_find_player_by_entity_id(shooter_entity_id);
        if shooter == null return false;
        if shooter.get_user_id() == owner_user_id return false;

        // Shooter must be inside this base to damage its turrets.
        if shooter.entity == null || shooter.entity.self == null return false;
        if !turret_is_position_inside_base(pb.entity, shooter.entity.world_position) return false;

        // Turret should also be in bounds (defensive).
        if !turret_is_position_inside_base(pb.entity, entity.world_position) return false;

        return true;
    }

    server_register_weapon_hit :: method(shooter_entity_id: u64, damage: float) -> bool {
        if !can_be_shot_by_entity_id(shooter_entity_id) return false;
        if hp <= 0 return false;

        dmg := (damage + 0.5).(s64);
        if dmg < 1 { dmg = 1; }

        hp -= dmg;
        if hp < 0 { hp = 0; }

        if hp <= 0 {
            server_on_destroyed_by(shooter_entity_id);
        }
        return true;
    }

    server_on_destroyed_by :: method(shooter_entity_id: u64) {
        if !Game.is_server() return;

        death_pos := v2{0, 0};
        if entity != null && entity.self != null {
            death_pos = entity.world_position;
        }

        owner := turret_find_player_by_user_id(owner_user_id);
        if owner == null {
            pb := get_parent_player_base(entity);
            if pb != null {
                owner = pb.get_owner();
            }
        }
        if owner != null {
            turret_save_player_data_excluding_entity_id(owner, entity.id);
            Notifier.notify(owner, "One of your turrets was destroyed.");
        }

        shooter := turret_find_player_by_entity_id(shooter_entity_id);
        if shooter != null {
            //Notifier.notify(shooter, "Destroyed enemy turret.");
        }

        // Match Truck destruction feedback with the same explosion prefab.
        explosion_prefab := get_asset(Prefab_Asset, "ExplosionVFX.prefab");
        if explosion_prefab != null {
            fx := Scene.instantiate(explosion_prefab);
            if fx != null && fx.self != null {
                fx.set_local_position(death_pos);
                fx.queue_for_destruction(1);
            }
        }

        if entity != null && entity.self != null {
            entity.destroy();
        }
    }

    ao_update :: method(dt: float) {
        // Visual state (state machine + IK) should run on all peers.
        if fire_anim_t > 0.0 {
            fire_anim_t -= dt;
            if fire_anim_t < 0.0 {
                fire_anim_t = 0.0;
            }
        }
        update_spine_visual_state();
        update_spine_ik();

        if !Game.is_server() return;

        pb := get_parent_player_base(entity);
        if pb == null return;

        // Keep owner binding valid even if this turret was spawned from legacy data.
        if owner_user_id.count == 0 {
            owner := pb.get_owner();
            if owner != null {
                owner_user_id = owner.get_user_id();
            }
        }
        if owner_user_id.count == 0 return;

        hp_max = get_max_health();
        if hp > hp_max {
            hp = hp_max;
        }
        if hp <= 0 {
            return;
        }

        fire_cooldown -= dt;
        target := find_target_in_base(pb);
        has_target = target != null;
        if !has_target return;
        target_world_pos = target.entity.world_position;

        if fire_cooldown <= 0.0 {
            fire_at_target(target, pb);
            fire_cooldown = get_fire_rate();
            fire_anim_t = TURRET_FIRE_ANIM_DURATION;
        }
    }
}

// ---------------------------------------------------------------------------
// Turret world-space health bars (local-only)
// Drawn from Player.ao_late_update.
// ---------------------------------------------------------------------------
draw_all_turret_health_bars_local :: proc() {
    UI.push_world_draw_context();
    defer UI.pop_draw_context();

    UI.push_layer(5);
    defer UI.pop_layer();

    foreach t: component_iterator(Turret) {
        if t == null continue;
        if t.entity == null || t.entity.self == null continue;
        if !t.entity.get_world_enabled() continue;
        draw_turret_health_bar_in_world_context(t);
    }
}

draw_turret_health_bar_in_world_context :: proc(turret: Turret) {
    if turret == null return;
    if turret.entity == null || turret.entity.self == null return;
    if turret.hp_max <= 0 return;
    if turret.hp <= 0 return;

    pos := turret.entity.world_position + v2{0, 1.25};
    UI.push_z(turret.entity.world_position.y - 0.002);
    defer UI.pop_z();

    health_rect := Rect{pos, pos}.grow(0.05, 0.45, 0.05, 0.45);
    border_rect := health_rect.grow(0.02, 0.02, 0.02, 0.02);

    #static back := get_asset(Texture_Asset, "reusable_weapons/sprites/reusable-weapons/hud_elements/health_bar_green/healthbar_back.png");
    #static fill := get_asset(Texture_Asset, "reusable_weapons/sprites/reusable-weapons/hud_elements/health_bar_green/healthbar_fill.png");

    if back != null {
        UI.quad(border_rect, back, {1, 1, 1, 1});
    }
    else {
        UI.quad(border_rect, core_globals.white_sprite, {0, 0, 0, 0.8});
    }

    pct := turret.hp.(float) / turret.hp_max.(float);
    if pct < 0 { pct = 0; }
    if pct > 1 { pct = 1; }

    fill_rect := health_rect.subrect(0, 0, pct, 1);
    if fill != null {
        UI.quad(fill_rect, fill, {1, 1, 1, 1});
    }
    else {
        UI.quad(fill_rect, core_globals.white_sprite, {0.1, 0.95, 0.2, 1});
    }
}
