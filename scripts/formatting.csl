import "core:ao"

// ---------------------------------------------------------------------------
// Formatting helpers
// ---------------------------------------------------------------------------

// Format an integer with comma thousands separators.
// Example: 10000 -> "10,000"
format_int_with_commas :: proc(v: s64) -> string {
    // Handle sign.
    negative := v < 0;
    x := v;
    if negative {
        x = -x;
    }

    // Break into 3-digit groups (least-significant first).
    groups: [..]string;
    while true {
        group := x % 1000;
        x = x / 1000;

        if x == 0 {
            // Most-significant group: no leading zeroes.
            groups->append(format_string("%", {group}));
            break;
        }

        // Middle groups: always 3 digits.
        groups->append(format_string("%", {format_int(group.(int), leading_zeroes=3)}));
    }

    // Join in reverse (most-significant first).
    i := groups.count - 1;
    result := groups[i];
    i -= 1;
    while i >= 0 {
        result = format_string("%0,%", {result, groups[i]});
        i -= 1;
    }

    if negative {
        result = format_string("-%", {result});
    }
    return result;
}

