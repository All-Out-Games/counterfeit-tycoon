import "core:ao"

// Stamper:
// - Spawned via prefab and assigned to a specific owner + lane (Lane 1 = lane_index 0).
// - Paths between the owning PlayerBase's Colored_Bill_Press and Finished_Bill_Press.
// - "Collects" colored bills from the Colored_Bill_Press's stored output (server-only) into internal storage.
// - Deposits carried colored bills into the Finished_Bill_Press's stored input (server-only).
// - Despawns automatically if its owning player disconnects.
//
// Setup:
// - Add `Stamper` to an entity that has a `Movement_Agent` component.
// - The Stamper entity should be parented under the owning PlayerBase entity.
// - A server-side spawner should call `server_init(owner_user_id, lane_index)` after instantiation.

Stamper_State :: enum {
    TO_SOURCE;
    WAIT_AT_SOURCE;
    TO_DEST;
    WAIT_AT_DEST;
    PAUSE_BEFORE_TO_DEST;
    PAUSE_BEFORE_TO_SOURCE;
}

stamper_find_colored_bill_press_for_base_and_lane :: proc(base: PlayerBase, lane_index: s64) -> Colored_Bill_Press {
    if base == null return null;
    if base.entity == null || !#alive(base.entity) return null;

    for p: component_iterator(Colored_Bill_Press) {
        if p == null continue;
        if p.entity == null || !#alive(p.entity) continue;
        if !p.entity.get_world_enabled() continue;
        if p.lane_index != lane_index continue;

        pb := get_parent_player_base(p.entity);
        if pb == base {
            return p;
        }
    }
    return null;
}

stamper_find_finished_bill_press_for_base_and_lane :: proc(base: PlayerBase, lane_index: s64) -> Finished_Bill_Press {
    if base == null return null;
    if base.entity == null || !#alive(base.entity) return null;

    for p: component_iterator(Finished_Bill_Press) {
        if p == null continue;
        if p.entity == null || !#alive(p.entity) continue;
        if !p.entity.get_world_enabled() continue;
        if p.lane_index != lane_index continue;

        pb := get_parent_player_base(p.entity);
        if pb == base {
            return p;
        }
    }
    return null;
}

Stamper :: class : Component {
    // Tuning
    move_speed: float @ao_serialize;
    arrive_radius: float @ao_serialize;
    max_drive_seconds: float @ao_serialize; // Safety timeout to prevent soft-locks.

    max_colored_bills_capacity: s64 @ao_serialize;
    collect_interval: float @ao_serialize;  // seconds between collect attempts while waiting at source press
    deposit_interval: float @ao_serialize;  // seconds between deposit attempts while waiting at dest press
    path_wait_seconds: float @ao_serialize; // downtime between travel legs

    // Spine visuals
    spine_animator: Spine_Animator @ao_serialize;
    spine_entity: Entity @ao_serialize;

    // World UI
    ui_offset: v2 @ao_serialize;

    // Synced / runtime
    owner_user_id: string;
    lane_index: s64;
    state: Stamper_State;
    carried_colored_bills: s64;
    deposit_seq: s64;

    // Runtime
    agent: Movement_Agent;
    drive_start_time: float;
    last_action_time: float;
    pause_until_time: float;
    break_variant: s64; // 1 or 2, controls Idle_Break_1 vs Idle_Break_2

    spine: Spine_Animator;
    spine_sm: State_Machine;
    spine_base_scale: v2;
    spine_scale_initialized: bool;

    last_world_pos: v2;
    last_world_pos_initialized: bool;

    ao_start :: method() {
        // Defaults (only if not set in editor)
        if move_speed <= 0 {
            move_speed = 3.75;
        }
        if arrive_radius <= 0 {
            arrive_radius = 0.6;
        }
        if max_drive_seconds <= 0 {
            max_drive_seconds = 60.0;
        }
        if max_colored_bills_capacity <= 0 {
            max_colored_bills_capacity = 20;
        }
        if collect_interval <= 0 {
            collect_interval = 0.35;
        }
        if deposit_interval <= 0 {
            deposit_interval = 0.2;
        }
        if path_wait_seconds <= 0 {
            path_wait_seconds = 3.0;
        }
        if ui_offset.x == 0 && ui_offset.y == 0 {
            ui_offset = {0, 1.35};
        }
        if lane_index < 0 {
            lane_index = 0;
        }

        agent = entity.get_component(Movement_Agent);
        if agent == null {
            log_warning("Stamper: missing Movement_Agent on Stamper entity", {});
        }

        last_world_pos = entity.world_position;
        last_world_pos_initialized = true;

        resolve_spine();
        setup_spine_state_machine();
        update_visuals();

        pb := get_parent_player_base(entity);
        if pb != null {
            owner_user_id = pb.owner_user_id;
        }

        if state != .TO_SOURCE && state != .WAIT_AT_SOURCE && state != .TO_DEST && state != .WAIT_AT_DEST {
            state = .TO_SOURCE;
        }
        if Game.is_server() {
            drive_start_time = get_time();
            last_action_time = 0;
            pause_until_time = 0;
            break_variant = 0;
        }
    }

    target_pos_for_source :: method(press: Colored_Bill_Press) -> v2 {
        if press == null return entity.world_position;
        if press.entity == null || !#alive(press.entity) return entity.world_position;
        return press.entity.world_position + v2{0, -1.0};
    }

    target_pos_for_dest :: method(press: Finished_Bill_Press) -> v2 {
        if press == null return entity.world_position;
        if press.entity == null || !#alive(press.entity) return entity.world_position;
        return press.entity.world_position + v2{0, -1.0};
    }

    is_moving :: method() -> bool {
        return state == .TO_SOURCE || state == .TO_DEST;
    }

    is_pausing :: method() -> bool {
        return state == .PAUSE_BEFORE_TO_DEST || state == .PAUSE_BEFORE_TO_SOURCE;
    }

    should_play_bored_idle :: method() -> bool {
        // Only play bored idle when we're waiting at a station with no output to pick up.
        // (Not when we're pausing between path legs.)
        if state != .WAIT_AT_SOURCE return false;
        if carried_colored_bills > 0 return false;

        pb := get_parent_player_base(entity);
        source := stamper_find_colored_bill_press_for_base_and_lane(pb, lane_index);
        if source == null return false;
        return source.stored_colored_bills <= 0;
    }

    server_init :: method(owner_id: string, lane: s64) {
        if !Game.is_server() {
            return;
        }
        owner_user_id = owner_id;
        lane_index = lane;
        if lane_index < 0 {
            lane_index = 0;
        }
        state = .TO_SOURCE;
        drive_start_time = get_time();
        last_action_time = 0;
        pause_until_time = 0;
        break_variant = 0;
        deposit_seq = 0;
    }

    server_begin_pause :: method(next_state: Stamper_State) {
        if !Game.is_server() return;

        if path_wait_seconds <= 0 {
            state = next_state;
            drive_start_time = get_time();
            last_action_time = 0;
            pause_until_time = 0;
            break_variant = 0;
            return;
        }

        rng := make_frame_rng(entity.id + 241);
        break_variant = rng_range_int(ref rng, 1, 2);
        pause_until_time = get_time() + path_wait_seconds;
        last_action_time = get_time();
        drive_start_time = 0;

        if next_state == .TO_DEST {
            state = .PAUSE_BEFORE_TO_DEST;
        }
        else {
            state = .PAUSE_BEFORE_TO_SOURCE;
        }
    }

    resolve_spine :: method() {
        spine = null;
        target_entity := entity;

        if spine_animator != null {
            spine = spine_animator;
            if spine_animator.entity != null && #alive(spine_animator.entity) {
                target_entity = spine_animator.entity;
            }
        }
        else if spine_entity != null && #alive(spine_entity) {
            spine = spine_entity.get_component(Spine_Animator);
            target_entity = spine_entity;
        }
        else if target_entity != null && #alive(target_entity) {
            spine = target_entity.get_component(Spine_Animator);
        }

        if spine != null {
            spine.awaken();
        }

        if !spine_scale_initialized {
            if target_entity != null && #alive(target_entity) {
                spine_base_scale = target_entity.local_scale;
                if spine_base_scale.x == 0 {
                    spine_base_scale.x = 1;
                }
                if spine_base_scale.y == 0 {
                    spine_base_scale.y = 1;
                }
                spine_scale_initialized = true;
            }
        }
    }

    setup_spine_state_machine :: method() {
        if spine == null return;
        if spine.instance == null return;
        if spine_sm != null return;

        spine_sm = State_Machine.create();
        mode_var := spine_sm.create_variable("anim_mode", .INT);
        push_var := spine_sm.create_variable("push", .TRIGGER);
        layer := spine_sm.create_layer("main", 0);

        idle_state := layer.create_state("Idle", true);
        run_state := layer.create_state("Run", true);
        break1_state := layer.create_state("Idle_Break_1", true);
        break2_state := layer.create_state("Idle_Break_2", true);
        push_state := layer.create_state("Push", false);
        layer.set_initial_state(idle_state);

        idle_to_run := layer.create_transition(idle_state, run_state, false);
        idle_to_run.create_int_condition(mode_var, 1, .EQUAL);

        idle_to_b1 := layer.create_transition(idle_state, break1_state, false);
        idle_to_b1.create_int_condition(mode_var, 2, .EQUAL);

        idle_to_b2 := layer.create_transition(idle_state, break2_state, false);
        idle_to_b2.create_int_condition(mode_var, 3, .EQUAL);

        run_to_idle := layer.create_transition(run_state, idle_state, false);
        run_to_idle.create_int_condition(mode_var, 0, .EQUAL);

        run_to_b1 := layer.create_transition(run_state, break1_state, false);
        run_to_b1.create_int_condition(mode_var, 2, .EQUAL);

        run_to_b2 := layer.create_transition(run_state, break2_state, false);
        run_to_b2.create_int_condition(mode_var, 3, .EQUAL);

        b1_to_idle := layer.create_transition(break1_state, idle_state, false);
        b1_to_idle.create_int_condition(mode_var, 0, .EQUAL);

        b1_to_run := layer.create_transition(break1_state, run_state, false);
        b1_to_run.create_int_condition(mode_var, 1, .EQUAL);

        b1_to_b2 := layer.create_transition(break1_state, break2_state, false);
        b1_to_b2.create_int_condition(mode_var, 3, .EQUAL);

        b2_to_idle := layer.create_transition(break2_state, idle_state, false);
        b2_to_idle.create_int_condition(mode_var, 0, .EQUAL);

        b2_to_run := layer.create_transition(break2_state, run_state, false);
        b2_to_run.create_int_condition(mode_var, 1, .EQUAL);

        b2_to_b1 := layer.create_transition(break2_state, break1_state, false);
        b2_to_b1.create_int_condition(mode_var, 2, .EQUAL);

        to_push := layer.create_global_transition(push_state, false);
        to_push.create_trigger_condition(push_var);
        _ := to_push;
        push_to_idle := layer.create_transition(push_state, idle_state, true);
        _ := push_to_idle;

        _ := mode_var;
        spine.instance.set_state_machine(spine_sm, true);
    }

    try_play_push_when_placing_items :: method() {
        if spine == null return;
        if spine.instance == null return;
        if spine.instance.state_machine == null return;

        Push_Seen_Entry :: struct {
            id: u64;
            seq: s64;
        }
        #static seen: [64]Push_Seen_Entry;

        slot: s64 = -1;
        empty: s64 = -1;
        for i: 0..63 {
            if seen[i].id == entity.id {
                slot = i;
                break;
            }
            if seen[i].id == 0 && empty < 0 {
                empty = i;
            }
        }
        if slot < 0 {
            slot = (empty >= 0) ? empty : 0;
            seen[slot].id = entity.id;
            seen[slot].seq = deposit_seq;
            return;
        }

        prev := seen[slot].seq;
        if deposit_seq > prev {
            spine.instance.state_machine.set_trigger("push");
        }
        seen[slot].seq = deposit_seq;
    }

    update_spine_state :: method() {
        if spine == null return;
        if spine.instance == null return;
        if spine.instance.state_machine == null return;

        mode := 0;
        if is_moving() {
            mode = 1;
        }
        else if should_play_bored_idle() {
            mode = (break_variant == 1) ? 2 : 3;
        }
        spine.instance.state_machine.set_int("anim_mode", mode);
    }

    update_visuals :: method() {
        if spine == null {
            resolve_spine();
            setup_spine_state_machine();
        }

        cur := entity.world_position;
        if !last_world_pos_initialized {
            last_world_pos = cur;
            last_world_pos_initialized = true;
        }
        delta := cur - last_world_pos;
        last_world_pos = cur;

        if spine_scale_initialized {
            target_entity := entity;
            if spine_entity != null && #alive(spine_entity) {
                target_entity = spine_entity;
            }

            if target_entity != null && #alive(target_entity) {
                if delta.x > 0.001 {
                    target_entity.set_local_scale({abs(spine_base_scale.x), spine_base_scale.y});
                }
                else if delta.x < -0.001 {
                    target_entity.set_local_scale({-abs(spine_base_scale.x), spine_base_scale.y});
                }
            }
        }

        update_spine_state();
        apply_depth_sort_from_owner();
    }

    apply_depth_sort_from_owner :: method() {
        if spine == null return;
        pb := get_parent_player_base(entity);
        if pb == null return;
        owner := pb.get_owner();
        if owner == null return;
        if !#alive(owner) return;
        if owner.animator == null return;

        spine.layer = owner.animator.layer;
        spine.depth_offset = owner.animator.depth_offset;
    }

    has_arrived :: method(target: v2) -> bool {
        delta := entity.world_position - target;
        return length_squared(delta) <= arrive_radius * arrive_radius;
    }

    server_should_despawn :: method() -> bool {
        if owner_user_id.count == 0 {
            return true;
        }

        pb := get_parent_player_base(entity);
        if pb == null {
            return true;
        }
        if pb.owner_user_id.count == 0 {
            return true;
        }
        if pb.owner_user_id != owner_user_id {
            return true;
        }

        owner := pb.get_owner();
        if owner == null {
            return true;
        }
        return false;
    }

    ao_update :: method(dt: float) {
        _ := dt;

        update_visuals();
        try_play_push_when_placing_items();

        if agent == null {
            agent = entity.get_component(Movement_Agent);
        }

        pb := get_parent_player_base(entity);
        source := stamper_find_colored_bill_press_for_base_and_lane(pb, lane_index);
        dest := stamper_find_finished_bill_press_for_base_and_lane(pb, lane_index);

        if agent != null {
            spd_mult := sparks_manager_boost_speed_multiplier_for_owner_user_id(owner_user_id);
            spd := move_speed * spd_mult;
            switch state {
                case .TO_SOURCE: {
                    if source != null {
                        _ := agent.set_path_target(target_pos_for_source(source), spd);
                    }
                }
                case .TO_DEST: {
                    if dest != null {
                        _ := agent.set_path_target(target_pos_for_dest(dest), spd);
                    }
                }
            }
        }

        if !Game.is_server() {
            return;
        }

        if server_should_despawn() {
            entity.destroy();
            return;
        }

        cap_mult := sparks_manager_boost_capacity_multiplier_for_owner_user_id(owner_user_id);
        effective_cap := max_colored_bills_capacity * cap_mult;
        if effective_cap < 1 {
            effective_cap = 1;
        }

        if carried_colored_bills < 0 {
            carried_colored_bills = 0;
        }
        if carried_colored_bills > effective_cap {
            carried_colored_bills = effective_cap;
        }

        if (state == .TO_SOURCE || state == .TO_DEST) && drive_start_time > 0 && max_drive_seconds > 0 {
            if get_time() - drive_start_time > max_drive_seconds {
                state = .TO_SOURCE;
                drive_start_time = get_time();
                last_action_time = 0;
                pause_until_time = 0;
                break_variant = 0;
            }
        }

        switch state {
            case .TO_SOURCE: {
                if source == null {
                    state = .WAIT_AT_SOURCE;
                    drive_start_time = 0;
                    last_action_time = 0;
                    return;
                }
                if has_arrived(target_pos_for_source(source)) {
                    state = .WAIT_AT_SOURCE;
                    drive_start_time = 0;
                    last_action_time = 0;
                }
            }
            case .WAIT_AT_SOURCE: {
                if source == null {
                    return;
                }

                // Choose a break variant only when we're truly waiting on empty output.
                // This prevents "bored" idles from being associated with path pauses.
                if carried_colored_bills <= 0 && source.stored_colored_bills <= 0 {
                    if break_variant == 0 {
                        rng := make_frame_rng(entity.id + 242);
                        break_variant = rng_range_int(ref rng, 1, 2);
                    }
                }
                else {
                    break_variant = 0;
                }

                if carried_colored_bills < effective_cap {
                    if last_action_time <= 0 || get_time() - last_action_time >= collect_interval {
                        room := effective_cap - carried_colored_bills;
                        taken := source.server_collect_colored_bills_for_manager(owner_user_id, room);
                        if taken > 0 {
                            carried_colored_bills += taken;
                        }
                        last_action_time = get_time();
                    }
                }

                if carried_colored_bills > 0 {
                    source_empty_now := source.stored_colored_bills <= 0;
                    if carried_colored_bills >= effective_cap || source_empty_now {
                        server_begin_pause(.TO_DEST);
                    }
                }
            }
            case .TO_DEST: {
                if dest == null {
                    state = .TO_SOURCE;
                    drive_start_time = get_time();
                    last_action_time = 0;
                    return;
                }
                if has_arrived(target_pos_for_dest(dest)) {
                    state = .WAIT_AT_DEST;
                    drive_start_time = 0;
                    last_action_time = 0;
                }
            }
            case .WAIT_AT_DEST: {
                if dest == null {
                    return;
                }

                if carried_colored_bills <= 0 {
                    state = .TO_SOURCE;
                    drive_start_time = get_time();
                    last_action_time = 0;
                    return;
                }

                if last_action_time <= 0 || get_time() - last_action_time >= deposit_interval {
                    deposited := dest.server_deposit_colored_bills_from_manager(owner_user_id, carried_colored_bills);
                    if deposited > 0 {
                        carried_colored_bills -= deposited;
                        if carried_colored_bills < 0 {
                            carried_colored_bills = 0;
                        }
                        deposit_seq += 1;
                    }
                    last_action_time = get_time();
                }

                if carried_colored_bills <= 0 {
                    server_begin_pause(.TO_SOURCE);
                }
            }
            case .PAUSE_BEFORE_TO_DEST: {
                if pause_until_time > 0 && get_time() >= pause_until_time {
                    state = .TO_DEST;
                    drive_start_time = get_time();
                    last_action_time = 0;
                    pause_until_time = 0;
                    break_variant = 0;
                }
            }
            case .PAUSE_BEFORE_TO_SOURCE: {
                if pause_until_time > 0 && get_time() >= pause_until_time {
                    state = .TO_SOURCE;
                    drive_start_time = get_time();
                    last_action_time = 0;
                    pause_until_time = 0;
                    break_variant = 0;
                }
            }
        }
    }

    ao_late_update :: method(dt: float) {
        _ := dt;
        if Game.is_server() {
            return;
        }
        local_player := get_local_player();
        if local_player == null {
            return;
        }
        if !#alive(local_player) {
            return;
        }

        UI_CULL_DISTANCE :: 20.0;
        delta := local_player.entity.world_position - entity.world_position;
        if length_squared(delta) > UI_CULL_DISTANCE * UI_CULL_DISTANCE {
            return;
        }
        draw_carried_ui();
    }

    draw_carried_ui :: method() {
        UI.push_world_draw_context();
        defer UI.pop_draw_context();

        UI.push_layer(5);
        defer UI.pop_layer();

        UI.push_z(entity.world_position.y - 0.002);
        defer UI.pop_z();

        pos := entity.world_position + ui_offset;

        rect := Rect{pos, pos}.grow(0.18, 0.55, 0.18, 0.55);
        icon_rect := rect.cut_left(0.22).inset(0.01);
        text_rect := rect;

        #static bills_icon := get_asset(Texture_Asset, "Items/ColoredBills.png");
        if bills_icon != null {
            UI.quad(icon_rect.fit_aspect(bills_icon.get_aspect()), bills_icon);
        }

        ts := UI.default_text_settings();
        ts.size = 0.34;
        ts.halign = .LEFT;
        ts.valign = .CENTER;
        ts.do_outline = true;
        ts.outline_thickness = 2;
        ts.outline_color = {0, 0, 0, 1};
        ts.color = {1, 1, 1, 1};
        ts.offset = {0.05, 0};

        UI.text(text_rect, ts, "x%", {carried_colored_bills});
    }
}

