    tutorial_find_owned_truck :: method() -> Truck {
        foreach t: component_iterator(Truck) {
            if t == null continue;
            if t.entity == null || t.entity.self == null continue;
            if !t.entity->get_world_enabled() continue;
            if is_owner_of_parent_base(t.entity, this) {
                return t;
            }
        }
        return null;
    }

    tutorial_step_get_text :: method(step: s64) -> string {
        switch step {
            case 0:  return "Chop Down a Tree";
            case 1:  return "Deposit Wood into your Paper Mill";
            case 2:  return "Collect Paper from your Paper Mill";
            case 3:  return "Deposit Paper into your Blank Bill Press";
            case 4:  return "Collect Blank Bills";
            case 5:  return "Deposit Blank Bills into your Colored Bill Press";
            case 6:  return "Collect Colored Bills";
            case 7:  return "Deposit Colored Bills into your Finished Bill Press";
            case 8:  return "Collect Finished Bills";
            case 9:  return "Deposit Finished Bills into your Vault";
            case 10: return "Send your Truck to the Bank";
            case 11: return "Tutorial Complete";
        }
        return "";
    }

    tutorial_step_get_target_world :: method(step: s64) -> v2, bool {
        if entity == null || entity.self == null {
            return {}, false;
        }

        switch step {
            case 0: {
                tree := find_closest_treecutting_tree_to_position(entity.world_position);
                if tree != null && tree.entity != null && tree.entity.self != null && tree.entity->get_world_enabled() {
                    return tree.entity.world_position, true;
                }
                return {}, false;
            }
            case 1: {
                pm := tutorial_find_owned_paper_mill_lane0();
                if pm != null && pm.entity != null && pm.entity.self != null {
                    return pm.entity.world_position, true;
                }
            }
            case 2: {
                pm := tutorial_find_owned_paper_mill_lane0();
                if pm != null && pm.entity != null && pm.entity.self != null {
                    return pm.entity.world_position, true;
                }
            }
            case 3: {
                press := tutorial_find_owned_blank_bill_press_lane0();
                if press != null && press.entity != null && press.entity.self != null {
                    return press.entity.world_position, true;
                }
            }
            case 4: {
                press := tutorial_find_owned_blank_bill_press_lane0();
                if press != null && press.entity != null && press.entity.self != null {
                    return press.entity.world_position, true;
                }
            }
            case 5: {
                press := tutorial_find_owned_colored_bill_press_lane0();
                if press != null && press.entity != null && press.entity.self != null {
                    return press.entity.world_position, true;
                }
            }
            case 6: {
                press := tutorial_find_owned_colored_bill_press_lane0();
                if press != null && press.entity != null && press.entity.self != null {
                    return press.entity.world_position, true;
                }
            }
            case 7: {
                press := tutorial_find_owned_finished_bill_press_lane0();
                if press != null && press.entity != null && press.entity.self != null {
                    return press.entity.world_position, true;
                }
            }
            case 8: {
                press := tutorial_find_owned_finished_bill_press_lane0();
                if press != null && press.entity != null && press.entity.self != null {
                    return press.entity.world_position, true;
                }
            }
            case 9: {
                v := tutorial_find_owned_vault();
                if v != null && v.entity != null && v.entity.self != null {
                    return v.entity.world_position, true;
                }
            }
            case 10: {
                t := tutorial_find_owned_truck();
                if t != null && t.entity != null && t.entity.self != null {
                    return t.entity.world_position, true;
                }
            }
        }

        return {}, false;
    }

    tutorial_set_step :: method(step: s64) {
        if !Game.is_server() {
            return;
        }
        if step < 0 { step = 0; }
        if step > 11 { step = 11; }

        // If entering the truck step, baseline delivery_seq so the player must do a fresh delivery.
        if step == 10 {
            truck := tutorial_find_owned_truck();
            if truck != null {
                tutorial_last_truck_delivery_seq = truck.delivery_seq;
                Save.set_int(this, "tutorial_last_truck_delivery_seq", tutorial_last_truck_delivery_seq);
            }
        }

        tutorial_step = step;
        Save.set_int(this, "tutorial_step", tutorial_step);
    }

    tutorial_try_advance_once :: method() -> bool {
        if !Game.is_server() {
            return false;
        }

        step := tutorial_step;
        if step >= 11 {
            return false;
        }

        switch step {
            case 0: {
                if tutorial_has_item_id("wood") {
                    tutorial_set_step(1);
                    return true;
                }
            }
            case 1: {
                pm := tutorial_find_owned_paper_mill_lane0();
                if pm != null && pm.stored_wood > 0 {
                    tutorial_set_step(2);
                    return true;
                }
            }
            case 2: {
                if tutorial_has_item_id("paper") {
                    tutorial_set_step(3);
                    return true;
                }
            }
            case 3: {
                press := tutorial_find_owned_blank_bill_press_lane0();
                if press != null && press.stored_paper > 0 {
                    tutorial_set_step(4);
                    return true;
                }
            }
            case 4: {
                if tutorial_has_item_id("blank_bills") {
                    tutorial_set_step(5);
                    return true;
                }
            }
            case 5: {
                press := tutorial_find_owned_colored_bill_press_lane0();
                if press != null && press.stored_blank_bills > 0 {
                    tutorial_set_step(6);
                    return true;
                }
            }
            case 6: {
                if tutorial_has_item_id("colored_bills") {
                    tutorial_set_step(7);
                    return true;
                }
            }
            case 7: {
                press := tutorial_find_owned_finished_bill_press_lane0();
                if press != null && press.stored_colored_bills > 0 {
                    tutorial_set_step(8);
                    return true;
                }
            }
            case 8: {
                if tutorial_has_item_id("finished_bills") {
                    tutorial_set_step(9);
                    return true;
                }
            }
            case 9: {
                v := tutorial_find_owned_vault();
                if v != null && v.stored_finished_bills > 0 {
                    tutorial_set_step(10);
                    return true;
                }
            }
            case 10: {
                truck := tutorial_find_owned_truck();
                if truck != null {
                    // Completion: any new successful delivery.
                    if truck.delivery_seq > tutorial_last_truck_delivery_seq {
                        tutorial_last_truck_delivery_seq = truck.delivery_seq;
                        Save.set_int(this, "tutorial_last_truck_delivery_seq", tutorial_last_truck_delivery_seq);
                        tutorial_set_step(11);
                        return true;
                    }
                }
            }
        }

        return false;
    }

    tutorial_server_tick :: method() {
        if !Game.is_server() {
            return;
        }

        // Allow multiple steps to auto-complete if the player already has items / has already progressed.
        for _i: 0..15 {
            if !tutorial_try_advance_once() {
                break;
            }
        }
    }

    draw_tutorial_hud :: method() {
        // UI is already gated by is_local_or_server() in ao_late_update.
        if tutorial_step >= 11 {
            return;
        }

        UI.push_layer(900);
        defer UI.pop_layer();

        safe := UI.get_safe_screen_rect();

        // Top-center banner.
        banner := safe->top_center_rect()->grow(52, 520, 0, 520)->offset(0, -90);
        UI.quad(banner, core_globals.white_sprite, {0, 0, 0, 0.55});

        ts := UI.default_text_settings();
        ts.size = 52;
        ts.color = {1, 1, 1, 1};
        ts.halign = .CENTER;
        ts.valign = .CENTER;
        ts.do_outline = true;
        ts.outline_thickness = 3;
        ts.outline_color = {0, 0, 0, 1};

        UI.text(banner, ts, "%", {tutorial_step_get_text(tutorial_step)});

        target, ok := tutorial_step_get_target_world(tutorial_step);
        if ok {
            this->DrawArrowToPosition(target);
        }
    }

    ao_end :: method() {
        // Called when this component is destroyed
        if Game.is_server() {
            if projectile_bone_debug_entity != null {
                projectile_bone_debug_entity->destroy();
                projectile_bone_debug_entity = null;
            }
        }

        if Game.is_server() {
            // Safety: ensure movement is re-enabled if the player leaves while UI is open.
            if sell_shop_movement_locked {
                this->remove_disable_movement_input_reason("sell_shop_ui");
                sell_shop_movement_locked = false;
            }
            if weapons_shop_movement_locked {
                this->remove_disable_movement_input_reason("weapons_shop_ui");
                weapons_shop_movement_locked = false;
            }

            gm := get_game_manager();
            if gm != null {
                gm->server_on_player_left(this);
            }
        }
    }

    ao_can_use_ability :: method(ability: Ability_Base) -> bool {
        // Called to determine if the player is allowed to use the given ability
        return true;
    }

    ao_can_use_interactable :: method(interactable: Interactable) -> bool {
        // Called to determine if the player is allowed to use the given interactable
        _ := interactable;

        // Block ALL interactables while dead/dying (until respawn).
        // `death_pickup_lockout` is set server-side at death start and cleared on respawn.
        if death_pickup_lockout return false;
        if CurrentHealth <= 0 return false;

        return true;
    }

    ao_on_interactable_used :: method(interactable: Interactable) {
        // Called when the player uses the given interactable
    }

    ao_on_holding_interactable :: method(interactable: Interactable) {
        // Called once per frame while the player is holding on the interactable
        if interactable == null return;
        if !Game.is_server() return;

        // Only care about the steal interactable (deposit is owner-only).
        if interactable.#type != Vault_Steal_Interactable {
            return;
        }

        vault_entity := interactable.entity;
        if vault_entity == null || vault_entity.self == null return;

        // Touch the "last hold" timestamp so ao_update doesn't clear state mid-hold.
        vault_theft_last_hold_time = get_time();

        // Owner holds are normal deposits; only track non-owner holds.
        if is_owner_of_parent_base(vault_entity, this) {
            return;
        }

        // New target vault? Start timing and allow a fresh notification.
        if vault_theft_target_entity_id != vault_entity.id {
            vault_theft_target_entity_id = vault_entity.id;
            vault_theft_hold_start_time = get_time();
            vault_theft_owner_notified = false;
        }

        // Notify the owner client once, right as stealing begins.
        if !vault_theft_owner_notified {
            pb := get_parent_player_base(vault_entity);
            if pb != null {
                owner := pb->get_owner();
                if owner != null {
                    Notifier.notify(owner, "% is stealing from your Vault!", {this->get_username()});
                }
            }
            vault_theft_owner_notified = true;
        }
    }

   // Configure the base player spine state machine for this player's main animator.
    // This mirrors the C# setup that adds weapon IK, carrying, carpet, and additive
    // gameplay layers on top of the core idle/run locomotion.
    setup_player_spine_state_machine :: proc(player: Player) {
        // Already configured?
        if player.base_state_machine != null {
            return;
        }

        // Require a valid base animator and spine instance.
        if player.animator == null || player.animator.instance == null {
            return;
        }

        sm := State_Machine.create();
        player.base_state_machine = sm;

        // Base locomotion layer ("main" track 0) and additive gameplay layer ("game_layer" track 10).
        ao_layer := sm->create_layer("main", 0);
        game_layer := sm->create_layer("game_layer", 10);

        // --- Base Locomotion States on main layer --- //
        ao_idle_state := ao_layer->create_state("Idle", true, 0.0);
        ao_run_state  := ao_layer->create_state("Run_Fast", true, 0.0);

        // Carrying variants.
        idle_carry := ao_layer->create_state("021MBR/Idle_Hold", true, 0.0);
        run_carry  := ao_layer->create_state("021MBR/Walk_Holding", true, 0.0);

        // Weapon IK locomotion variants (1h / 2h).
        aim_run_1h_fast := ao_layer->create_state("redsun/Run_Fast_mIK", true, 0.0);
        aim_run_2h_fast := ao_layer->create_state("redsun/Run_Fast_mIK_twohands", true, 0.0);
        aim_idle_1h     := ao_layer->create_state("redsun/Idle_mIK", true, 0.0);
        aim_idle_2h     := ao_layer->create_state("redsun/Idle_mIK_twohands", true, 0.0);

        // Carpet locomotion.
        carpet_idle := ao_layer->create_state("021MBR/Carpet_Idle", true, 0.0);
        carpet_move := ao_layer->create_state("021MBR/Carpet_Move", true, 0.0);

        // --- Additive gameplay layer states --- //
        empty := game_layer->create_state("__CLEAR_TRACK__", true, 0.0);
        shoot := game_layer->create_state("redsun/Shoot_Gun_mIK_AL", false, 0.0);
        shoot_fast_state := game_layer->create_state("redsun/Shoot_Gun_mIK_AL_twohands_rapid", true, 0.0);

        // Optional weapon equip states (not directly wired by transitions here, but
        // created to mirror the C# setup).
        pull_out_1h_weapon := game_layer->create_state("redsun/Pull_Out_Weapon", false, 0.0);
        aim_idle_1h_hand   := game_layer->create_state("redsun/Idle_mIK", true, 0.0);
        pull_out_2h_weapon := game_layer->create_state("redsun/Pull_Out_Weapon_twohands", false, 0.0);
        aim_idle_2h_hands  := game_layer->create_state("redsun/Idle_mIK_twohands", true, 0.0);

        // Initial states.
        ao_layer->set_initial_state(ao_idle_state);
        game_layer->set_initial_state(empty);

        // --- State machine variables --- //
        moving_bool := sm->create_variable("moving", State_Machine_Variable.Kind.BOOL);
        mIK_bool := sm->create_variable("mIK", State_Machine_Variable.Kind.BOOL);

        carrying_moving_bool := sm->create_variable("carryingMoving", State_Machine_Variable.Kind.BOOL);

        use_1h_ik := sm->create_variable("use_ik", State_Machine_Variable.Kind.BOOL);
        use_2h_ik := sm->create_variable("use_2h_ik", State_Machine_Variable.Kind.BOOL);

        has_carpet := sm->create_variable("hasCarpet", State_Machine_Variable.Kind.BOOL);

        cancel_all := sm->create_variable("cancel_all", State_Machine_Variable.Kind.TRIGGER);

        // --- Base Idle <-> Run locomotion on main layer --- //
        {
            t := ao_layer->create_transition(ao_idle_state, ao_run_state, false);
            t->create_bool_condition(moving_bool, true);

            t = ao_layer->create_transition(ao_run_state, ao_idle_state, false);
            t->create_bool_condition(moving_bool, false);
        }

        // --- Entry / Cancel-All --- //
        {
            to_idle_from_cancel := ao_layer->create_global_transition(ao_idle_state, false);
            to_idle_from_cancel->create_trigger_condition(cancel_all);

            to_empty_from_cancel := game_layer->create_global_transition(empty, false);
            to_empty_from_cancel->create_trigger_condition(cancel_all);
        }

        // --- Aim entry from base Idle/Run --- //
        {
            t := ao_layer->create_transition(ao_idle_state, aim_idle_1h, false);
            t->create_bool_condition(use_1h_ik, true);

            t = ao_layer->create_transition(ao_idle_state, aim_idle_2h, false);
            t->create_bool_condition(use_2h_ik, true);

            t = ao_layer->create_transition(ao_run_state, aim_run_1h_fast, false);
            t->create_bool_condition(use_1h_ik, true);

            t = ao_layer->create_transition(ao_run_state, aim_run_2h_fast, false);
            t->create_bool_condition(use_2h_ik, true);
        }

        // --- Aim Idle <-> Run (1h / 2h) --- //
        {
            t := ao_layer->create_transition(aim_run_1h_fast, aim_idle_1h, false);
            t->create_bool_condition(moving_bool, false);

            t = ao_layer->create_transition(aim_idle_1h, aim_run_1h_fast, false);
            t->create_bool_condition(moving_bool, true);

            t = ao_layer->create_transition(aim_run_2h_fast, aim_idle_2h, false);
            t->create_bool_condition(moving_bool, false);

            t = ao_layer->create_transition(aim_idle_2h, aim_run_2h_fast, false);
            t->create_bool_condition(moving_bool, true);
        }

        // --- Exit aim back to base Idle/Run --- //
        {
            t := ao_layer->create_transition(aim_idle_1h, ao_idle_state, false);
            t->create_bool_condition(use_1h_ik, false);

            t = ao_layer->create_transition(aim_idle_2h, ao_idle_state, false);
            t->create_bool_condition(use_2h_ik, false);

            t = ao_layer->create_transition(aim_run_1h_fast, ao_run_state, false);
            t->create_bool_condition(use_1h_ik, false);

            t = ao_layer->create_transition(aim_run_2h_fast, ao_run_state, false);
            t->create_bool_condition(use_2h_ik, false);
        }

        // --- 1h <-> 2h swap while aiming --- //
        {
            t := ao_layer->create_transition(aim_idle_1h, aim_idle_2h, false);
            t->create_bool_condition(use_2h_ik, true);

            t = ao_layer->create_transition(aim_idle_2h, aim_idle_1h, false);
            t->create_bool_condition(use_2h_ik, false);

            t = ao_layer->create_transition(aim_run_1h_fast, aim_run_2h_fast, false);
            t->create_bool_condition(use_2h_ik, true);

            t = ao_layer->create_transition(aim_run_2h_fast, aim_run_1h_fast, false);
            t->create_bool_condition(use_2h_ik, false);
        }

        // --- Carrying locomotion --- //
        {
            // Enter/exit carrying from base Idle/Run.
            t := ao_layer->create_transition(ao_idle_state, idle_carry, false);
            t->create_bool_condition(carrying_moving_bool, true);

            t = ao_layer->create_transition(ao_run_state, run_carry, false);
            t->create_bool_condition(carrying_moving_bool, true);

            t = ao_layer->create_transition(idle_carry, ao_idle_state, false);
            t->create_bool_condition(carrying_moving_bool, false);

            t = ao_layer->create_transition(run_carry, ao_run_state, false);
            t->create_bool_condition(carrying_moving_bool, false);

            // Idle_carry <-> Run_carry based on movement.
            t = ao_layer->create_transition(idle_carry, run_carry, false);
            t->create_bool_condition(moving_bool, true);

            t = ao_layer->create_transition(run_carry, idle_carry, false);
            t->create_bool_condition(moving_bool, false);
        }

        // --- Carpet locomotion --- //
        {
            t := ao_layer->create_transition(ao_idle_state, carpet_idle, false);
            t->create_bool_condition(has_carpet, true);

            t = ao_layer->create_transition(carpet_idle, ao_idle_state, false);
            t->create_bool_condition(has_carpet, false);

            t = ao_layer->create_transition(ao_run_state, carpet_move, false);
            t->create_bool_condition(has_carpet, true);

            t = ao_layer->create_transition(carpet_move, ao_run_state, false);
            t->create_bool_condition(has_carpet, false);

            t = ao_layer->create_transition(carpet_idle, carpet_move, false);
            t->create_bool_condition(moving_bool, true);

            t = ao_layer->create_transition(carpet_move, carpet_idle, false);
            t->create_bool_condition(moving_bool, false);
        }

        // --- Additive layer: shoot and simple triggered states --- //
        {
            // Primary shoot (one-shot additive) driven by a trigger variable.
            shoot_var := sm->create_variable("shoot", State_Machine_Variable.Kind.TRIGGER);
            to_shoot := game_layer->create_global_transition(shoot, true);
            to_shoot->create_trigger_condition(shoot_var);

            // Return to empty after the shoot animation finishes.
            game_layer->create_transition(shoot, empty, true);

            // Simple additive one-shots implemented as global transitions with trigger variables.

            // Punch 2
            punch2_state := game_layer->create_state("016ARP/Punch_mIK_AL", false, 0.0);
            punch2_var := sm->create_variable("punch2", State_Machine_Variable.Kind.TRIGGER);
            t := game_layer->create_global_transition(punch2_state, true);
            t->create_trigger_condition(punch2_var);
            game_layer->create_transition(punch2_state, empty, true);

            // Small flinch
            new_flinch_state := game_layer->create_state("016ARP/Flinch", false, 0.0);
            new_flinch_var := sm->create_variable("new_flinch", State_Machine_Variable.Kind.TRIGGER);
            t = game_layer->create_global_transition(new_flinch_state, true);
            t->create_trigger_condition(new_flinch_var);
            game_layer->create_transition(new_flinch_state, empty, true);

            // Use item
            use_item_state := game_layer->create_state("Collect_Item", false, 0.0);
            use_item_var := sm->create_variable("use_item", State_Machine_Variable.Kind.TRIGGER);
            t = game_layer->create_global_transition(use_item_state, true);
            t->create_trigger_condition(use_item_var);
            game_layer->create_transition(use_item_state, empty, true);

            // Cry (additive one-shot, returns to empty)
            cry_state := game_layer->create_state("Emote/crying_loop", false, 0.0);
            cry_var := sm->create_variable("cry", State_Machine_Variable.Kind.TRIGGER);
            t = game_layer->create_global_transition(cry_state, true);
            t->create_trigger_condition(cry_var);
            game_layer->create_transition(cry_state, empty, true);

            // KO (death) – no automatic return to empty.
            ko_state := game_layer->create_state("Death_No_HP", false, 0.0);
            ko_var := sm->create_variable("KO", State_Machine_Variable.Kind.TRIGGER);
            t = game_layer->create_global_transition(ko_state, true);
            t->create_trigger_condition(ko_var);

            // Spawn – one-shot that returns to empty.
            spawn_state := game_layer->create_state("016ARP/Spawn_In", false, 0.0);
            spawn_var := sm->create_variable("Spawn", State_Machine_Variable.Kind.TRIGGER);
            t = game_layer->create_global_transition(spawn_state, true);
            t->create_trigger_condition(spawn_var);
            game_layer->create_transition(spawn_state, empty, true);

            // Flinch (big)
            flinch_big_state := game_layer->create_state("Flinch_Big", false, 0.0);
            flinch_big_var := sm->create_variable("flinch_big", State_Machine_Variable.Kind.TRIGGER);
            t = game_layer->create_global_transition(flinch_big_state, true);
            t->create_trigger_condition(flinch_big_var);
            game_layer->create_transition(flinch_big_state, empty, true);

            // Handless – looping additive state with no automatic return.
            handless_state := game_layer->create_state("Handless", true, 0.0);
            handless_var := sm->create_variable("handless", State_Machine_Variable.Kind.TRIGGER);
            t = game_layer->create_global_transition(handless_state, true);
            t->create_trigger_condition(handless_var);

            // Weapon equipping / unequipping and basic shooting on the additive layer.

            // 1h pull out
            pull_out_1h_var := sm->create_variable("pull_out_1h_weapon", State_Machine_Variable.Kind.TRIGGER);
            t = game_layer->create_global_transition(pull_out_1h_weapon, true);
            t->create_trigger_condition(pull_out_1h_var);
            game_layer->create_transition(pull_out_1h_weapon, empty, true);

            // 2h pull out
            pull_out_2h_var := sm->create_variable("pull_out_2h_weapon", State_Machine_Variable.Kind.TRIGGER);
            t = game_layer->create_global_transition(pull_out_2h_weapon, true);
            t->create_trigger_condition(pull_out_2h_var);
            game_layer->create_transition(pull_out_2h_weapon, empty, true);

            // 1h put away
            put_away_1h_state := game_layer->create_state("redsun/Pull_Away_Weapon", false, 0.0);
            put_away_1h_var := sm->create_variable("put_away_1h_weapon", State_Machine_Variable.Kind.TRIGGER);
            t = game_layer->create_global_transition(put_away_1h_state, true);
            t->create_trigger_condition(put_away_1h_var);
            game_layer->create_transition(put_away_1h_state, empty, true);

            // 2h put away
            put_away_2h_state := game_layer->create_state("redsun/Pull_Away_Weapon_twohands", false, 0.0);
            put_away_2h_var := sm->create_variable("put_away_2h_weapon", State_Machine_Variable.Kind.TRIGGER);
            t = game_layer->create_global_transition(put_away_2h_state, true);
            t->create_trigger_condition(put_away_2h_var);
            game_layer->create_transition(put_away_2h_state, empty, true);

            // Basic weapon shooting (1h / 2h) as additive one-shots.
            shoot_1h_state := game_layer->create_state("redsun/Shoot_Gun_mIK_AL", false, 0.0);
            shoot_1h_var := sm->create_variable("shoot_1h_weapon", State_Machine_Variable.Kind.TRIGGER);
            t = game_layer->create_global_transition(shoot_1h_state, true);
            t->create_trigger_condition(shoot_1h_var);
            game_layer->create_transition(shoot_1h_state, empty, true);

            shoot_2h_state := game_layer->create_state("redsun/Shoot_Gun_mIK_AL_twohands", false, 0.0);
            shoot_2h_var := sm->create_variable("shoot_2h_weapon", State_Machine_Variable.Kind.TRIGGER);
            t = game_layer->create_global_transition(shoot_2h_state, true);
            t->create_trigger_condition(shoot_2h_var);
            game_layer->create_transition(shoot_2h_state, empty, true);

            // Rapid fire two-hand shooting – enter/exit via trigger variables.
            shoot_fast_start := sm->create_variable("shoot_fast_start", State_Machine_Variable.Kind.TRIGGER);
            shoot_fast_end   := sm->create_variable("shoot_fast_end", State_Machine_Variable.Kind.TRIGGER);

            t = game_layer->create_transition(empty, shoot_fast_state, false);
            t->create_trigger_condition(shoot_fast_start);

            t = game_layer->create_transition(shoot_fast_state, empty, false);
            t->create_trigger_condition(shoot_fast_end);
        }

        // Layer-specific looped states on the base layer, entered via trigger-driven global transitions.
        {
            cry_loop_state := ao_layer->create_state("Emote/crying_loop", true, 0.0);
            cry_loop_var := sm->create_variable("cry_loop", State_Machine_Variable.Kind.TRIGGER);
            t := ao_layer->create_global_transition(cry_loop_state, false);
            t->create_trigger_condition(cry_loop_var);

            victory_loop_state := ao_layer->create_state("Emote/Celebrate", true, 0.0);
            victory_loop_var := sm->create_variable("victory_loop", State_Machine_Variable.Kind.TRIGGER);
            t = ao_layer->create_global_transition(victory_loop_state, false);
            t->create_trigger_condition(victory_loop_var);

            // Non-looping jumpscare emote that returns to idle upon completion.
            jumpscare_state := ao_layer->create_state("Emote/Jumpscare", false, 0.0);
            jumpscare_var := sm->create_variable("jumpscare", State_Machine_Variable.Kind.TRIGGER);
            t = ao_layer->create_global_transition(jumpscare_state, false);
            t->create_trigger_condition(jumpscare_var);
            ao_layer->create_transition(jumpscare_state, ao_idle_state, true);
        }

        // Finally, bind this state machine to the base animator.
        player.animator.instance->set_state_machine(sm, true);
    }

    draw_damage_numbers :: proc(using this: Player, dt: float) {
        gm := get_game_manager();
        if gm == null {
            return;
        }

        numbers := gm.damage_numbers;
        if numbers.count == 0 {
            return;
        }

        // World-space drawing context on a mid-level layer.
        UI.push_world_draw_context();
        defer UI.pop_draw_context();

        UI.push_layer(5);
        defer UI.pop_layer();

        // Iterate backwards so we can safely remove finished entries.
        for i: 0..numbers.count-1 #reverse {
            dn := numbers[i];
            if dn == null {
                continue;
            }

            speed := 0.5;

            // Start from the stored text settings (value type copy).
            ts := dn.TextSettings;

            dn.T += dt * speed;

            if dn.T >= 1.0 && dn.DoingFading {
                // Remove this entry and continue.
                gm.damage_numbers->unordered_remove_by_value(dn);
                continue;
            }

            if dn.T >= 1.0 && !dn.DoingFading {
                dn.T = 0.0;
                dn.DoingFading = true;
            }

            if !dn.DoingFading {
                pos := dn.Position;

                // Ease the upward motion over time.
                t := dn.T;
                if t < 0.0 {
                    t = 0.0;
                }
                if t > 1.0 {
                    t = 1.0;
                }

                t1 := 1.0 - t;
                t_eased := 1.0 - t1 * t1 * t1 * t1; // Approximate Ease.OutQuart

                pos.y += lerp(0.0, 0.5, t_eased);

                // Simple fade-in-then-out curve in [0, 1].
                fade_t := t;
                if fade_t < 0.0 {
                    fade_t = 0.0;
                }
                if fade_t > 1.0 {
                    fade_t = 1.0;
                }
                color01 := 1.0 - abs(2.0 * fade_t - 1.0);

                ts.color = lerp(ts.color, dn.Color, color01);
                dn.LastPosition = pos;
            }
            else {
                ts.spacing_multiplier = 1.0;

                zero_color := v4{0, 0, 0, 0};
                ts.color = lerp(ts.color, zero_color, dn.T);
            }

            ts.size = dn.TextSettings.size;

            rect := Rect{dn.LastPosition, dn.LastPosition};
            UI.text(rect, ts, dn.Text);
        }
    }

    // Draw a directional arrow in the HUD pointing from this player toward a world-space target.
    // Note: we keep this as a compatibility wrapper, but the actual implementation
    // is in `DrawArrowToPosition` below (ported from C#).
    draw_arrow_to_position :: proc(using this: Player, target_world: v2) {
        this->DrawArrowToPosition(target_world);
    }

    // Port of the provided C# DrawArrowToPosition.
    // Draws a screen-space arrow pointing toward a world-space `position`.
    DrawArrowToPosition :: proc(using this: Player, position: v2) {
        if this == null return;
        if entity == null || entity.self == null return;

        // Screen-space overlay so it can't be occluded by world sprites.
        UI.push_screen_draw_context();
        defer UI.pop_draw_context();

        // Above almost everything else in the HUD.
        UI.push_layer(800);
        defer UI.pop_layer();

        safe := UI.get_safe_screen_rect();
        h := 1080.0;
        if h <= 0 {
            return;
        }
        aspect := 1920.0 / h;
        if aspect <= 0 {
            aspect = 1.0;
        }

        world_offset := position - entity.world_position;
        distance := length(world_offset);

        target_screen := world_to_screen(position + v2{0, 1.5});
        player_screen := world_to_screen(entity.world_position + v2{0, 1.5});

        delta_screen := target_screen - player_screen;
        dir := normalize(delta_screen);
        if length_squared(dir) < 0.00001 {
            dir = {1, 0};
        }

        arrow_size_px :: 40.0;
        anim := pow(abs(sin(PI * get_time())), 0.75);

        // distanceThreshold = ((dir * threshold) / (1, aspect)).Length
        distance_threshold_world :: 8.5;
        dvec := v2{dir.x * distance_threshold_world, dir.y * distance_threshold_world};
        scaled := v2{dvec.x, dvec.y / aspect};
        distance_threshold := length(scaled);

        #static arrow_tex := get_asset(Texture_Asset, "UI/Arrow.png");
        if arrow_tex == null {
            return;
        }

        if distance >= (distance_threshold + 0.5) {
            t := 1.0 - Ease.T(distance - distance_threshold, 1.0);
            t = clamp(t, 0.0, 1.0);

            arrow_screen := Rect{player_screen, player_screen}->offset_unscaled(dir.x * 300.0, dir.y * 300.0)->center();
            arrow_screen = lerp(arrow_screen, target_screen, t);

            rect := Rect{arrow_screen, arrow_screen}->grow(arrow_size_px);
            rotation := to_degrees(atan2(dir.y, dir.x));

            // Rotate around rect center via UI matrix.
            c := rect->center();
            UI.push_matrix(Matrix4.translate(v3{c.x, c.y, 0}));
            defer UI.pop_matrix();
            UI.push_matrix(Matrix4.rotate(rotation, v3{0, 0, 1}));
            defer UI.pop_matrix();
            UI.push_matrix(Matrix4.translate(v3{-c.x, -c.y, 0}));
            defer UI.pop_matrix();
            UI.quad(rect, arrow_tex, {1, 1, 1, 1});
        }
        else {
            rect := Rect{target_screen, target_screen}->grow(arrow_size_px);
            rect = rect->offset_unscaled(0, anim * 50.0);

            // Near target: fixed "down" arrow (270 degrees).
            c := rect->center();
            UI.push_matrix(Matrix4.translate(v3{c.x, c.y, 0}));
            defer UI.pop_matrix();
            UI.push_matrix(Matrix4.rotate(270, v3{0, 0, 1}));
            defer UI.pop_matrix();
            UI.push_matrix(Matrix4.translate(v3{-c.x, -c.y, 0}));
            defer UI.pop_matrix();
            UI.quad(rect, arrow_tex, {1, 1, 1, 1});
        }
    }

    handle_equipped_item_changing :: method(selected_index: s64) {
        // Resolve item from hotbar index
        selected_item: Item_Instance;
        if selected_index >= 0 && selected_index < default_inventory.capacity {
            selected_item = default_inventory->get_item(selected_index);
        }

        new_def: Item_Definition;
        if selected_item != null {
            new_def = selected_item->get_definition();
        }

        // Skip if nothing changed
        if selected_index == last_selected_index && new_def == equipped_item_def return;
        last_selected_index = selected_index;

        // Skip if same item definition
        if new_def == equipped_item_def return;

        // Unequip old weapon
        if equipped_weapon_type != .NONE {
            weapon_unequip(this, equipped_weapon_type);
            equipped_weapon_type = .NONE;
        }
        equipped_item_def = null;

        // Equip new weapon if it's a registered weapon
        if new_def != null {
            wt := get_weapon_type_for_item(new_def);
            if wt != .NONE {
                weapon_equip(this, wt);
                equipped_weapon_type = wt;
                equipped_item_def = new_def;
            }
        }
    }

    // Apply damage to this player from server-authoritative logic.
    // Track who last dealt damage for kill attribution.
    last_damage_source: Player;

    take_damage :: proc(using this: Player, amount: float, source: Player = null, blocked_by_base_safe_zone: bool = false) {

        if amount <= 0 {
            return;
        }

        // Health should only be modified on the server.
        if !Game.is_server() {
            return;
        }

        // Ignore damage while dead / in death sequence.
        if death_pickup_lockout {
            return;
        }

        // Spawn protection: ignore damage for SPAWN_PROTECTION_SECONDS after respawn.
        if get_time() < spawn_protection_until {
            return;
        }

        _ := blocked_by_base_safe_zone;

        CurrentHealth -= amount;
        if CurrentHealth < 0 {
            CurrentHealth = 0;
        }

        // Track the source for kill attribution.
        if source != null {
            last_damage_source = source;
        }

        // Start a damage flash on this player's rig for visual feedback (replicated via player state).
        damage_flash_start_time = get_time();

        // Spawn a simple damage number above this player.
        gm := get_game_manager();
        if gm != null {
            dn := new(DamageNumbers);
            dn.Text = format_string("-%", {amount.(int)});
            dn.Position = entity.world_position + v2{0, 1.75};
            dn.LastPosition = dn.Position;
            dn.Color = {1, 0.2, 0.2, 1};
            dn.T = 0.0;
            dn.SpaceText = false;
            dn.DoingFading = false;

            ts := UI.default_text_settings();
            ts.size = 0.35;
            ts.halign = .CENTER;
            ts.valign = .CENTER;
            ts.do_outline = true;
            ts.outline_thickness = 2;
            ts.outline_color = {0, 0, 0, 1};
            dn.TextSettings = ts;

            gm.damage_numbers->append(dn);
        }

        // Death trigger.
        if CurrentHealth <= 0 {
            this->server_start_death();
        }
    }

    // Server-only: begin the death sequence (active effect + item drops + lockout).
    server_start_death :: method() {
        if !Game.is_server() return;
        if death_pickup_lockout return; // already dying/dead
        if entity == null || entity.self == null return;

        // Quest: attribute kill to the last damage source.
        if last_damage_source != null && last_damage_source.self != null {
            if last_damage_source != this {
                quest_on_pvp_kill(last_damage_source);
            }
        }
        last_damage_source = null;

        // Set immediately so we can't re-enter via multiple damage events in a single tick.
        death_pickup_lockout = true;

        // Attach the death effect (handles freeze, animation, drops, respawn + fade).
        effect := new(Death_Effect);
        entity->set_active_effect(effect);
    }
}
