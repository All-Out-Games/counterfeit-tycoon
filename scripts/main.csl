// Item drops:
// Use `ItemDrops.spawn(...)` / `ItemDrops.spawn_from_definition(...)` from `scripts/ItemDrops.csl`
// to drop items into the world. Pickups will magnet to nearby players and grant the item.


// Project load

ao_before_scene_load :: proc() {
    // Called before the scene is loaded
    ItemManager.AllItemDefinitions();

    // Reusable weapons item definitions must be registered on BOTH server + clients,
    // and early (before UI/inventories try to resolve icons). If this only runs
    // server-side, clients can end up with null icons after rejoining/restarting.
    init_weapon_items();

    // Economy currency registration (global, safe to call once).
    #static coin_currency_registered: bool;
    if !coin_currency_registered {
        coin_currency_registered = true;
        coin_icon := get_asset(Texture_Asset, "Items/Coin.png");
        Economy.register_currency("Coins", coin_icon);
    }
}

ao_start :: proc() {
    // Called after the scene is loaded
}

ao_update :: proc(dt: float) {
    // Called once per frame
}

// Called by the engine when a purchase is successful.
// Return true if we handled the purchase id.
ao_purchase_handler :: proc(player: Player, id: string) -> bool {
    if player == null return false;
    if id.count == 0 return false;

    log_info("Purchase handler called for %", {id});

    handled := weapons_shop_try_handle_purchase(player, id);
    if !handled {
        handled = harvester_upgrades_try_handle_purchase(player, id);
    }
    if handled {
        // Debug: visible confirmation that the callback is firing (server only).
        if Game.is_server() {
            Notifier.notify(player, "Purchase handled: %", {id});
        }
        return true;
    }

    return false;
}

ao_late_update :: proc(dt: float) {
    // Called once per frame after physics has been resolved
}

COIN_CURRENCY :: "Coins";

STARTER_COINS_AMOUNT :: 500;
STARTER_COINS_GRANTED_SAVE_KEY :: "starter_coins_granted";

// ---------------------------------------------------------------------------
// Lanes progression (per-player, saved)
//
// We store unlocked lanes as a bitmask:
// - bit 0 => Lane 1 unlocked (default)
// - bit 1 => Lane 2 unlocked
// - bit 2 => Lane 3 unlocked
// - bit 3 => Lane 4 unlocked
// ---------------------------------------------------------------------------
LANES_UNLOCK_SAVE_KEY :: "lane_unlock_mask";
LANES_UNLOCK_MASK_DEFAULT :: 1; // Lane 1 unlocked by default
LANES_LANE_COUNT :: 4;

lanes_lane_bit :: proc(lane_index: s64) -> s64 {
    if lane_index < 0 || lane_index >= LANES_LANE_COUNT {
        return 0;
    }
    return 1 << lane_index;
}

lanes_is_unlocked :: proc(player: Player, lane_index: s64) -> bool {
    if player == null return false;
    if lane_index < 0 || lane_index >= LANES_LANE_COUNT return false;
    bit := lanes_lane_bit(lane_index);
    if bit == 0 return false;
    return (player.lane_unlock_mask & bit) != 0;
}

lanes_unlock_cost :: proc(lane_index: s64) -> s64 {
    // lane_index is 0-based. Lane 1 (index 0) is free/default.
    switch lane_index {
        case 1: return 10000;    // Lane 2
        case 2: return 100000;   // Lane 3
        case 3: return 1000000;  // Lane 4
    }
    return 0;
}

server_try_unlock_lane :: proc(player: Player, lane_index: s64) {
    if player == null return;
    if !Game.is_server() return;
    if lane_index < 0 || lane_index >= LANES_LANE_COUNT return;

    // Lane 1 is always unlocked.
    if lane_index == 0 {
        return;
    }

    // Already unlocked?
    if lanes_is_unlocked(player, lane_index) {
        return;
    }

    // Must have previous lane unlocked first.
    if !lanes_is_unlocked(player, lane_index - 1) {
        Notifier.notify(player, "Unlock Lane % first.", {lane_index});
        return;
    }

    cost := lanes_unlock_cost(lane_index);
    if cost <= 0 return;

    if !Economy.can_withdraw_currency(player, COIN_CURRENCY, cost) {
        Notifier.notify(player, "Not enough Coins!");
        return;
    }

    Economy.withdraw_currency(player, COIN_CURRENCY, cost);

    // Update mask (always keep Lane 1 bit set).
    bit := lanes_lane_bit(lane_index);
    new_mask := (player.lane_unlock_mask | bit) | LANES_UNLOCK_MASK_DEFAULT;
    // Clamp to 4 lanes.
    new_mask = new_mask & 15;
    player.lane_unlock_mask = new_mask;
    Save.set_int(player, LANES_UNLOCK_SAVE_KEY, new_mask);

    Notifier.notify(player, "Unlocked Lane %.", {lane_index + 1});

    // Quest tracking: lane unlocked.
    quest_on_lane_unlock(player, lane_index);

    // Spawn the lane prefab under their PlayerBase.
    gm := get_game_manager();
    if gm != null {
        gm->server_spawn_lane_for_player(player, lane_index);
        // Keep the world "Unlock Lane" prompt in sync immediately.
        gm->server_reconcile_lane_unlock_prompt_for_player(player);
    }
}

// Cheat: grant an item directly into the caller's inventory.
// Usage:
// - /g <item_id>
// - /g <item_id> <count>   (count only applies if the item is stackable)
g :: proc(player: Player, item_id: string, count: s64 = 1) {
    if player == null return;
    if !Game.is_server() return;

    if item_id == "" {
        Notifier.notify(player, "Usage: /g <item_id> [count]");
        return;
    }

    if count < 1 {
        count = 1;
    }

    defn := ItemManager.TryFindItem(item_id);
    if defn == null {
        Notifier.notify(player, "Unknown item_id: %", {item_id});
        return;
    }

    inv := player.default_inventory;
    if inv == null || inv.self == null {
        Notifier.notify(player, "No inventory available.");
        return;
    }

    // Create an instance with the requested quantity.
    item := Items.create_item_instance(defn, count);
    if item == null || item.self == null {
        Notifier.notify(player, "Failed to create item: %", {item_id});
        return;
    }

    // If the engine clamps quantity, treat it as non-stackable and only give 1.
    if count > 1 && item.quantity != count {
        Items.destroy_item_instance(item);
        count = 1;
        item = Items.create_item_instance(defn, 1);
        Notifier.notify(player, "Item % is not stackable; giving 1.", {item_id});
    }

    destroyed_item: bool;
    moved := Items.move_as_many_items_as_possible_to_inventory(item, inv, ref destroyed_item);

    if moved <= 0 {
        // Inventory full → clean up the instance we created (if it still exists).
        if item != null && item.self != null {
            Items.destroy_item_instance(item);
        }
        Notifier.notify(player, "Inventory full.");
        return;
    }

    if moved < count {
        Notifier.notify(player, "Gave % x% (inventory full).", {item_id, moved});
    }
    else if count > 1 {
        Notifier.notify(player, "Gave % x%.", {item_id, moved});
    }
    else {
        Notifier.notify(player, "Gave %.", {item_id});
    }
} @chat_command @youtuber

// Cheat: grant Coins currency to the caller.
// Usage:
// - /coins <amount>
coins :: proc(player: Player, amount: s64) {
    if player == null return;
    if !Game.is_server() return;

    if amount <= 0 {
        Notifier.notify(player, "Usage: /coins <amount> (must be > 0)");
        return;
    }

    Economy.deposit_currency(player, COIN_CURRENCY, amount);
    Notifier.notify(player, "Gave yourself % Coins.", {amount});
} @chat_command @youtuber

// Convert any legacy "coin" item stacks into Coin currency.
// (We used to award Coins as an Item_Definition; now it's a currency.)
migrate_legacy_coin_items_to_currency :: proc(player: Player) {
    if player == null return;
    if !Game.is_server() return;

    inv := player.default_inventory;
    if inv == null || inv.self == null return;
    if inv.capacity <= 0 return;

    total_converted: s64 = 0;
    MAX_STEPS :: 20000;

    for slot: 0..inv.capacity-1 {
        item := inv->get_item(slot);
        if item == null continue;
        if item.self == null continue;

        defn := item->get_definition();
        if defn == null continue;
        if defn->get_id() != "coin" continue;

        // Destroy 1 at a time to count the stack.
        for step: 0..MAX_STEPS {
            cur := inv->get_item(slot);
            if cur == null break;
            if cur.self == null break;
            cur_defn := cur->get_definition();
            if cur_defn == null break;
            if cur_defn->get_id() != "coin" break;

            Items.destroy_item_instance(cur, 1);
            total_converted += 1;
        }
    }

    if total_converted > 0 {
        Economy.deposit_currency(player, COIN_CURRENCY, total_converted);
        Notifier.notify(player, "Converted legacy Coin items into % Coins.", {total_converted});
    }
}

draw_finished_bills_per_sec_hud :: proc(player: Player) {
    if player == null return;
    if !player->is_local_or_server() return;

    // Sum production rate across all Finished_Bill_Press instances owned by this player.
    total_rate := 0.0;
    foreach press: component_iterator(Finished_Bill_Press) {
        if press == null continue;
        if press.entity == null || press.entity.self == null continue;
        if !press.entity->get_world_enabled() continue;
        if !is_owner_of_parent_base(press.entity, player) continue;

        // When the Vault is full we pause production entirely.
        if vault_owner_has_full_vault(press.entity) continue;

        // A press only produces when it has colored bills queued.
        if press.stored_colored_bills <= 0 continue;
        if press.seconds_per_finished_bill <= 0 continue;

        total_rate += 1.0 / press.seconds_per_finished_bill;
    }

    safe := UI.get_safe_screen_rect();

    // Position just above the coin HUD panel.
    panel := safe->bottom_left_rect()->grow(28, 100, 28, 100)->offset(150, 170);
    UI.quad(panel, core_globals.white_sprite, {0.06, 0.06, 0.06, 0.7});

    inner := panel->inset(8);
    icon_rect := inner->cut_left_unscaled(40);
    _ := inner->cut_left_unscaled(8);

    #static fb_icon := get_asset(Texture_Asset, "Items/FinishedBills.png");
    if fb_icon != null {
        UI.quad(icon_rect->fit_aspect(fb_icon->get_aspect()), fb_icon);
    }

    ts := UI.default_text_settings();
    ts.size = 28;
    ts.halign = .LEFT;
    ts.valign = .CENTER;
    ts.do_outline = true;
    ts.outline_thickness = 2;
    ts.outline_color = {0, 0, 0, 1};
    UI.text(inner, ts, "%/s", {format_float(total_rate, decimals=1)});
}

draw_coin_currency_hud :: proc(player: Player) {
    if player == null return;
    if !player->is_local_or_server() return;

    safe := UI.get_safe_screen_rect();

    // Top-right coin panel
    panel := safe->bottom_left_rect()->grow(50, 100, 50, 100)->offset(150, 70);
    UI.quad(panel, get_asset(Texture_Asset, "UI/GoldFrame.png"), {0.5, 0.5, 0.5, 1});

    inner := panel->inset(12);
    icon_rect := inner->cut_left_unscaled(54);
    _ := inner->cut_left_unscaled(12);

    #static coin_icon := get_asset(Texture_Asset, "Items/Coin.png");
    if coin_icon != null {
        UI.quad(icon_rect->fit_aspect(coin_icon->get_aspect()), coin_icon);
    }

    balance := Economy.get_balance(player, COIN_CURRENCY);

    ts := UI.default_text_settings();
    ts.size = 36;
    ts.halign = .LEFT;
    ts.valign = .CENTER;
    ts.do_outline = true;
    ts.outline_thickness = 3;
    ts.outline_color = {0, 0, 0, 1};
    UI.text(inner, ts, "%", {balance});
}

coin_currency_hud_get_text_anchor :: proc(player: Player) -> v2 {
    // Returns the center position of the coin currency TEXT rect (screen-space).
    // Keep layout logic identical to draw_coin_currency_hud.
    if player == null return {};
    if !player->is_local_or_server() return {};

    safe := UI.get_safe_screen_rect();
    panel := safe->bottom_left_rect()->grow(50, 100, 50, 100)->offset(150, 70);

    inner := panel->inset(12);
    _ := inner->cut_left_unscaled(54);
    _ := inner->cut_left_unscaled(12);
    return inner->center();
}

// Base safe zone:
// If a player is within this axis-aligned box (width/height) centered on their own `base_entity`,
// they regenerate health over time.
BASE_SAFE_ZONE_BOX_SIZE :: 15.0;
BASE_SAFE_ZONE_BOX_HALF :: (BASE_SAFE_ZONE_BOX_SIZE * 0.5);
BASE_SAFE_ZONE_REGEN_HP_PER_SEC :: 15.0;
SPAWN_PROTECTION_SECONDS :: 10.0;

player_is_in_own_base_safe_zone :: proc(player: Player) -> bool {
    if player == null return false;
    if player.entity == null || player.entity.self == null return false;
    if player.base_entity == null || player.base_entity.self == null return false;

    base_pos := player.base_entity.world_position;
    p_pos := player.entity.world_position;

    dx := abs(p_pos.x - base_pos.x);
    dy := abs(p_pos.y - base_pos.y);

    return dx <= BASE_SAFE_ZONE_BOX_HALF && dy <= BASE_SAFE_ZONE_BOX_HALF;
}



Player :: class : Player_Base {

    MaxHealth: float;
    CurrentHealth: float;

    base_state_machine: State_Machine;

    // Cosmetic: flash the base animator red briefly after taking damage.
    // Set server-side in take_damage; clients use replicated start time to drive flicker.
    damage_flash_start_time: float;

    equipped_weapon_type: Weapon_Type;
    // Reusable weapons: per-player spawned attachment for Boomwheel.
    boomwheel_cannon: Boomwheel_Cannon;
    equipped_item_def: Item_Definition;
    last_selected_index: s64;

    // Debug: local-only marker that follows the "PROJECTILE" bone.
    projectile_bone_debug_entity: Entity;

    // UI state (per-player, multiplayer safe)
    sell_shop_open: bool;
    sell_shop_movement_locked: bool;

    // Screen-space UI particles (per-player, local-only draw)
    ui_directed_particle_handler: UI_Directed_Particle_Handler;

    // Cosmetic: purchase FX (server sets these; local client plays particles + SFX)
    purchase_fx_seq: s64;
    purchase_fx_icon_path: string;

    // Reusable weapons shop UI (per-player, multiplayer safe)
    weapons_shop_open: bool;
    weapons_shop_movement_locked: bool;
    weapons_shop_tab: s64;          // Weapons_Shop_Tab enum as s64 (0=Weapons, 1=Ammo)
    weapons_shop_weapon_page: s64;
    weapons_shop_ammo_page: s64;

    // Managers UI state + unlocks (per-player, multiplayer safe)
    managers_open: bool;
    managers_selected_lane: s64;          // 0-based
    managers_lane_masks: [4]s64;          // 4 lanes, 4 bits used per lane

    // Harvester upgrades UI + unlocks (per-player, multiplayer safe)
    harvester_upgrades_open: bool;
    harvester_level: s64;                 // 1..10
    harvester_manager_unlocked: bool;     // one-time unlock

    // Station upgrades UI + levels (per-player, multiplayer safe)
    upgrades_open: bool;
    upgrades_selected_lane: s64;          // 0-based
    // Flat storage: index = lane_index * 4 + station_index (0..3). Values are 1..10.
    station_upgrade_levels: [16]s64;

    // Vault upgrade level (per-player, multiplayer safe; NOT lane-based — one vault per player)
    vault_level: s64;                     // 1..6

    // Quest system (per-player, server authoritative, replicated)
    quest_slots: [3]Quest_Instance;       // 3 active quests
    quests_completed: s64;                // lifetime total quests claimed
    quest_rewards_earned: s64;            // lifetime total reward coins from quests
    quests_panel_open: bool;              // UI toggle

    // Quest cumulative stats (server authoritative, saved)
    quest_stat_bank_runs: s64;
    quest_stat_total_earned: s64;
    quest_stat_managers_hired: s64;
    quest_stat_pvp_kills: s64;
    quest_stat_trucks_destroyed: s64;
    quest_stat_vaults_robbed: s64;

    // Truck upgrades UI + levels (per-player, multiplayer safe)
    truck_upgrades_open: bool;
    truck_upgrades_selected_kind: s64;    // 0=Capacity, 1=HP, 2=Speed
    truck_upgrade_levels: [3]s64;         // Values are 1..10 (same order as selected_kind)

    // Tutorial progression (per-player, server authoritative, replicated)
    tutorial_step: s64;
    tutorial_last_truck_delivery_seq: s64;

    // Lane unlock progression (per-player, server authoritative, replicated)
    // lane_unlock_mask uses bits for lanes 0..3 (see helpers above).
    lane_unlock_mask: s64;
    // Runtime: spawned lane prefab instances (Lane 2-4 are indices 1..3).
    lane_entities: [4]Entity;
    // Runtime: spawned lane unlock prompt instance (one per player, next locked lane only).
    lane_unlock_prompt_entity: Entity;
    lane_unlock_prompt_lane_index: s64;
    // Runtime: spawned manager unlock prompts (4 lanes * 4 managers).
    // Indexing: idx = lane_index * 4 + manager_index (manager_index matches `manager_kind_from_index` ordering).
    manager_unlock_prompt_entities: [16]Entity;
    // Runtime: spawned woodchipper (harvester manager) unlock prompt (one per player).
    woodchipper_unlock_prompt_entity: Entity;

    // PlayerBase ownership state (per-player, multiplayer safe)
    base_entity: Entity;
    base_spawn_index: s64;

    // Vault theft hold tracking (per-player, multiplayer safe; server authoritative)
    vault_theft_target_entity_id: u64; // entity.id of the vault currently being stolen from (0 if none)
    vault_theft_hold_start_time: float;
    vault_theft_last_hold_time: float;
    vault_theft_owner_notified: bool;

    // Client-side fallback notification (local-only via #static in method)
    client_check_vault_theft_notifications :: method() {
        // Purely cosmetic: only do this on the local client's player.
        if !this->is_local() {
            return;
        }

        // We want the toast on the client even if the server RPC is delayed/missed.
        // This is a best-effort local UI notification using replicated thief hold state.

        Theft_Notify_Entry :: struct {
            thief_user_id: string;
            vault_entity_id: u64;
            time: float;
        }

        #static entries: [8]Theft_Notify_Entry;
        #static cursor: s64;

        // Helper: check whether `vault_entity_id` is one of OUR vault entities.
        local_owns_vault_id :: proc(owner: Player, vault_entity_id: u64) -> bool {
            if owner == null return false;
            if vault_entity_id == 0 return false;
            foreach v: component_iterator(Vault) {
                if v == null continue;
                if v.entity == null || v.entity.self == null continue;
                if v.entity.id != vault_entity_id continue;
                return is_owner_of_parent_base(v.entity, owner);
            }
            return false;
        }

        now := get_time();
        THROTTLE_SECONDS :: 2.5;

        foreach thief: component_iterator(Player) {
            if thief == null continue;
            if thief == this continue;
            if thief.self == null continue;

            vault_id := thief.vault_theft_target_entity_id;
            if vault_id == 0 continue;

            if !local_owns_vault_id(this, vault_id) {
                continue;
            }

            // Throttle per (thief, vault).
            already_notified := false;
            for i: 0..entries.count-1 {
                if entries[i].thief_user_id.count == 0 continue;
                if entries[i].thief_user_id != thief->get_user_id() continue;
                if entries[i].vault_entity_id != vault_id continue;
                if now - entries[i].time < THROTTLE_SECONDS {
                    already_notified = true;
                }
                break;
            }
            if already_notified continue;

            msg := format_string("% is stealing from your Vault!", {thief->get_username()});
            Notifier.notify(msg);

            // Record.
            if cursor < 0 {
                cursor = 0;
            }
            idx := cursor % entries.count;
            entries[idx].thief_user_id = thief->get_user_id();
            entries[idx].vault_entity_id = vault_id;
            entries[idx].time = now;
            cursor += 1;
        }
    }

    client_coin_gain_particles_tick :: method() {
        // Cosmetic-only: local feedback when our Coin balance increases.
        if !this->is_local_or_server() {
            return;
        }

        uid := this->get_user_id();
        if uid.count == 0 {
            return;
        }

        Balance_Entry :: struct {
            user_id: string;
            last_balance: s64;
            initialized: bool;
        }

        #static entries: [8]Balance_Entry;

        idx := -1;
        for i: 0..entries.count-1 {
            if entries[i].user_id.count == 0 continue;
            if entries[i].user_id == uid {
                idx = i;
                break;
            }
        }
        if idx < 0 {
            // Allocate slot
            for i: 0..entries.count-1 {
                if entries[i].user_id.count == 0 {
                    idx = i;
                    break;
                }
            }
            if idx < 0 {
                idx = 0; // overwrite oldest slot if full
            }
            entries[idx].user_id = uid;
            entries[idx].initialized = false;
            entries[idx].last_balance = 0;
        }

        cur := Economy.get_balance(this, COIN_CURRENCY);
        if !entries[idx].initialized {
            entries[idx].initialized = true;
            entries[idx].last_balance = cur;
            return;
        }

        prev := entries[idx].last_balance;
        if cur > prev {
            delta := cur - prev;

            // Local SFX for coin gain (once per tick).
            #static coin_gain_sfx := get_asset(SFX_Asset, "SFX/PurchaseSFX.wav");
            if coin_gain_sfx != null {
                desc := SFX.default_sfx_desc();
                desc.entity_to_follow = entity.id;
                desc.volume = 0.8;
                desc.volume_perturb = 0.05;
                desc.speed_perturb = 0.05;
                SFX.play(coin_gain_sfx, desc);
            }

            // Compute spawn count from delta (clamped).
            spawn_count: s64 = 1;
            if delta <= 5 {
                spawn_count = delta;
            }
            else if delta <= 50 {
                spawn_count = 5 + (delta / 10);
            }
            else {
                spawn_count = 10 + (delta / 100);
            }
            if spawn_count < 1 spawn_count = 1;
            if spawn_count > 24 spawn_count = 24;

            // Start: from player world position projected to screen.
            start_world := entity.world_position + v2{0, 0.9};
            start := world_to_screen(start_world);

            // Destination: coin currency text area.
            dest := coin_currency_hud_get_text_anchor(this);

            rng := rng_seed_time();
            for n: 0..spawn_count-1 {
                // Small random jitter for a nicer "spray" feel.
                jitter := v2{
                    rng_range_float(ref rng, -86.0, 86.0),
                    rng_range_float(ref rng, -86.0, 86.0)
                };
                jitter_dest := v2{
                    rng_range_float(ref rng, -40.0, 40.0),
                    rng_range_float(ref rng, -40.0, 40.0)
                };

                ui_directed_particles_spawn_from_path(
                    this,
                    "Items/Coin.png",
                    start + jitter,
                    dest + jitter_dest,
                    size_px = {64, 64},
                    speed_px_per_sec = 1200.0,
                    kill_radius_px = 14.0,
                    layer = 700,
                    color = {1, 1, 1, 1}
                );
            }
        }

        entries[idx].last_balance = cur;
    }

    client_purchase_fx_tick :: method(hotbar_rect: Rect) {
        // Cosmetic-only: local feedback when we successfully buy weapons/ammo.
        if !this->is_local_or_server() {
            return;
        }

        uid := this->get_user_id();
        if uid.count == 0 {
            return;
        }

        Purchase_FX_Entry :: struct {
            user_id: string;
            last_seq: s64;
            initialized: bool;
        }

        #static entries: [8]Purchase_FX_Entry;

        idx := -1;
        for i: 0..entries.count-1 {
            if entries[i].user_id.count == 0 continue;
            if entries[i].user_id == uid {
                idx = i;
                break;
            }
        }
        if idx < 0 {
            // Allocate slot
            for i: 0..entries.count-1 {
                if entries[i].user_id.count == 0 {
                    idx = i;
                    break;
                }
            }
            if idx < 0 {
                idx = 0;
            }
            entries[idx].user_id = uid;
            entries[idx].initialized = false;
            entries[idx].last_seq = 0;
        }

        cur_seq := purchase_fx_seq;
        if !entries[idx].initialized {
            entries[idx].initialized = true;
            entries[idx].last_seq = cur_seq;
            return;
        }

        if cur_seq == entries[idx].last_seq {
            return;
        }
        entries[idx].last_seq = cur_seq;

        if purchase_fx_icon_path.count == 0 {
            return;
        }

        // Local purchase SFX
        #static purchase_sfx := get_asset(SFX_Asset, "SFX/PurchaseSFX.wav");
        if purchase_sfx != null {
            desc := SFX.default_sfx_desc();
            desc.entity_to_follow = entity.id;
            desc.volume = 0.9;
            desc.volume_perturb = 0.05;
            desc.speed_perturb = 0.05;
            SFX.play(purchase_sfx, desc);
        }

        // Start from screen center -> hotbar
        safe := UI.get_safe_screen_rect();
        start := safe->center();
        dest := hotbar_rect->center();

        ui_directed_particles_spawn_from_path(
            this,
            purchase_fx_icon_path,
            start,
            dest,
            size_px = {128, 128},
            speed_px_per_sec = 1400.0,
            kill_radius_px = 14.0,
            layer = 750,
            color = {1, 1, 1, 1}
        );
    }

    // Death / respawn state (per-player, server authoritative)
    death_pickup_lockout: bool;
    spawn_protection_until: float; // game time when spawn protection expires

    // Spawn shield VFX (local cosmetic)
    shield_entity: Entity;
    shield_spine: Spine_Animator;
    shield_playing_disappear: bool;
    shield_created_time: float;
    shield_disappear_start_time: float;

    give_item :: proc(player: Player, item_id: string) {
    item := Items.create_item_instance(ItemManager.FindItem(item_id), 1);

    will_destroy: bool;
    if Items.can_move_item_to_inventory(item, player.default_inventory, ref will_destroy) {
        Items.move_item_to_inventory(item, player.default_inventory);
    }
    else {
        // Inventory full → destroy the instance we created
        Items.destroy_item_instance(item);
    }
}

    ao_start :: method() {
        // Called when this component is created
        MaxHealth = 100;
        CurrentHealth = MaxHealth;

        // Local-only: start background music once per client.
        if this->is_local() {
            #static music_manager_spawned: bool;
            if !music_manager_spawned {
                music_manager_spawned = true;
                music_entity := Scene.create_entity();
                _ := music_entity->add_component(MusicManager);
            }
        }

        // Per-player UI particle handler (cosmetic-only; draws locally).
        ui_directed_particle_handler = entity->add_component(UI_Directed_Particle_Handler);

        // Server authoritative init (replicated to clients).
        if Game.is_server() {
            purchase_fx_seq = 0;
            purchase_fx_icon_path = "";
        }

        sell_shop_open = false;
        sell_shop_movement_locked = false;

        weapons_shop_open = false;
        weapons_shop_movement_locked = false;
        weapons_shop_tab = 0;
        weapons_shop_weapon_page = 0;
        weapons_shop_ammo_page = 0;

        managers_open = false;
        managers_selected_lane = 0; // Lane 1 auto-selected
        // Server syncs these to clients; don't clobber already-synced values on clients.
        if Game.is_server() {
            for i: 0..3 {
                managers_lane_masks[i] = 0;
            }
        }

        // Lanes progression (server authoritative, loaded from Save and replicated).
        if Game.is_server() {
            lane_unlock_mask = LANES_UNLOCK_MASK_DEFAULT;
            for i: 0..3 {
                lane_entities[i] = null;
            }
            lane_unlock_prompt_entity = null;
            lane_unlock_prompt_lane_index = -1;
            for i: 0..15 {
                manager_unlock_prompt_entities[i] = null;
            }
            woodchipper_unlock_prompt_entity = null;
        }

        // Tutorial (server authoritative, loaded from Save and replicated).
        if Game.is_server() {
            tutorial_step = 0;
            tutorial_last_truck_delivery_seq = 0;
        }

        harvester_upgrades_open = false;
        // Server authoritative (loaded from Save and replicated).
        if Game.is_server() {
            harvester_level = 1;
            harvester_manager_unlocked = false;
        }

        upgrades_open = false;
        upgrades_selected_lane = 0; // Lane 1 auto-selected
        // Server authoritative (loaded from Save and replicated).
        if Game.is_server() {
            for i: 0..15 {
                station_upgrade_levels[i] = 1;
            }
            vault_level = 1;

            // Quest system init.
            for i: 0..2 {
                quest_slots[i].def_id = -1;
                quest_slots[i].progress = 0;
                quest_slots[i].completed = false;
                quest_slots[i].claimed = false;
                quest_slots[i].is_challenge = false;
            }
            quests_completed = 0;
            quest_rewards_earned = 0;
            quest_stat_bank_runs = 0;
            quest_stat_total_earned = 0;
            quest_stat_managers_hired = 0;
            quest_stat_pvp_kills = 0;
            quest_stat_trucks_destroyed = 0;
            quest_stat_vaults_robbed = 0;
        }
        quests_panel_open = false;

        truck_upgrades_open = false;
        truck_upgrades_selected_kind = 0; // Capacity auto-selected
        // Server authoritative (loaded from Save and replicated).
        if Game.is_server() {
            for i: 0..2 {
                truck_upgrade_levels[i] = 1;
            }
        }

        base_entity = null;
        base_spawn_index = -1;

        death_pickup_lockout = false;

        last_selected_index = -1;

        // One-time migration: convert any legacy Coin items into Coin currency.
        if Game.is_server() {

            init_weapon_items();

            migrate_legacy_coin_items_to_currency(this);

            // First-ever join bonus:
            // Grant starter Coins only for players with no existing save data yet.
            // (We use presence of older per-player keys as a proxy for "has played before".)
            if Save.get_int(this, STARTER_COINS_GRANTED_SAVE_KEY, 0) == 0 {
                has_tutorial_key := Save.get_int(this, "tutorial_step", -1) != -1;
                has_lanes_key := Save.get_int(this, LANES_UNLOCK_SAVE_KEY, -1) != -1;
                cur_coins := Economy.get_balance(this, COIN_CURRENCY);

                if !has_tutorial_key && !has_lanes_key && cur_coins <= 0 {
                    Economy.deposit_currency(this, COIN_CURRENCY, STARTER_COINS_AMOUNT);
                }

                // Always set so existing players don't ever get the bonus later.
                Save.set_int(this, STARTER_COINS_GRANTED_SAVE_KEY, 1);
            }

            // Load per-player lane unlock mask (server authoritative, replicates to clients).
            {
                mask := Save.get_int(this, LANES_UNLOCK_SAVE_KEY, LANES_UNLOCK_MASK_DEFAULT);
                if mask < 0 {
                    mask = 0;
                }
                // Always keep Lane 1 unlocked.
                mask = mask | LANES_UNLOCK_MASK_DEFAULT;
                // Clamp to 4 lanes.
                mask = mask & 15;
                lane_unlock_mask = mask;
                // Ensure key exists for new players / migrations.
                Save.set_int(this, LANES_UNLOCK_SAVE_KEY, mask);
            }

            // Load per-player Managers unlock masks (server authoritative, replicates to clients).
            for lane: 0..3 {
                key := format_string("managers_lane_%_mask", {lane});
                mask := Save.get_int(this, key, 0);
                if mask < 0 {
                    mask = 0;
                }
                // Only 4 managers exist currently (lowest 4 bits).
                mask = mask & 15;
                managers_lane_masks[lane] = mask;
            }

            // Load Harvester upgrades (server authoritative, replicates to clients).
            {
                lvl := Save.get_int(this, "harvester_level", 1);
                if lvl < 1 {
                    lvl = 1;
                }
                if lvl > 10 {
                    lvl = 10;
                }
                harvester_level = lvl;

                unlocked_int := Save.get_int(this, "harvester_manager_unlocked", 0);
                harvester_manager_unlocked = unlocked_int != 0;
            }

            // Load station upgrade levels (server authoritative, replicates to clients).
            // 4 lanes (0..3), 4 stations (0..3), levels 1..10.
            for lane: 0..3 {
                for station: 0..3 {
                    key := format_string("station_lane_%_station_%_level", {lane, station});
                    lvl := Save.get_int(this, key, 1);
                    if lvl < 1 {
                        lvl = 1;
                    }
                    if lvl > 10 {
                        lvl = 10;
                    }
                    idx := lane * 4 + station;
                    if idx >= 0 && idx < 16 {
                        station_upgrade_levels[idx] = lvl;
                    }
                }
            }

            // Load vault upgrade level (server authoritative, replicates to clients).
            {
                vlvl := Save.get_int(this, "vault_level", 1);
                if vlvl < 1 vlvl = 1;
                if vlvl > 6 vlvl = 6;
                vault_level = vlvl;
            }

            // Load truck upgrade levels (server authoritative, replicates to clients).
            // 3 categories (Capacity/HP/Speed), levels 1..10.
            {
                cap_lvl := Save.get_int(this, "truck_capacity_level", 1);
                if cap_lvl < 1 cap_lvl = 1;
                if cap_lvl > 10 cap_lvl = 10;
                truck_upgrade_levels[0] = cap_lvl;

                hp_lvl := Save.get_int(this, "truck_hp_level", 1);
                if hp_lvl < 1 hp_lvl = 1;
                if hp_lvl > 10 hp_lvl = 10;
                truck_upgrade_levels[1] = hp_lvl;

                spd_lvl := Save.get_int(this, "truck_speed_level", 1);
                if spd_lvl < 1 spd_lvl = 1;
                if spd_lvl > 10 spd_lvl = 10;
                truck_upgrade_levels[2] = spd_lvl;
            }

            // Load quest system (server authoritative, replicates to clients).
            quest_load_active(this);

            // Load tutorial progression (server authoritative, replicates to clients).
            {
                // 0..11, where 11 == done.
                step := Save.get_int(this, "tutorial_step", 0);
                if step < 0 { step = 0; }
                if step > 11 { step = 11; }
                tutorial_step = step;
                Save.set_int(this, "tutorial_step", step);

                seq := Save.get_int(this, "tutorial_last_truck_delivery_seq", 0);
                if seq < 0 { seq = 0; }
                tutorial_last_truck_delivery_seq = seq;
                Save.set_int(this, "tutorial_last_truck_delivery_seq", seq);
            }

            // Joining player: ask the GameManager to assign bases (or warp to 0,0 if full).
            gm := get_game_manager();
            if gm != null {
                gm->request_base_reconcile();
            }
        }

        // Lock player movement to the main navmesh (both server + clients).
        // This prevents players from walking outside navigable areas.
        {
            gm := get_game_manager();
            if gm != null && gm.navmesh != null {
                movement_agent := entity->get_component(Movement_Agent);
                if movement_agent != null {
                    movement_agent->set_navmesh_to_lock_to(gm.navmesh);
                }
            }
        }

        // Camera tuning:
        // `camera.size` is an orthographic size where larger values zoom OUT.
        // We increase it a bit to avoid feeling overly zoomed-in.
        {
            CAMERA_SIZE_MULT :: 1.25;
            CAMERA_SIZE_MIN  :: 7.5;

            new_size := camera.size * CAMERA_SIZE_MULT;
            if new_size < CAMERA_SIZE_MIN {
                new_size = CAMERA_SIZE_MIN;
            }

            camera.size = new_size;
            camera.follow_player = true;
        }

        // Configure the main player spine state machine on the base animator.
        //this->setup_player_spine_state_machine();
        setup_reusable_weapons_player_state_machine(this);


        // Debug marker showing the current PROJECTILE bone position.
        // Spawn on the server so the marker exists and replicates for everyone.
        /*if Game.is_server() {
            if projectile_bone_debug_entity == null {
                e := Scene.create_entity();
                e->set_local_position(entity.world_position);
                dbg := e->add_component(Projectile_Bone_Debug);
                dbg.player = this;
                projectile_bone_debug_entity = e;
            }
        }
        */
    }

    ao_update :: method(dt: float) {
        // Called once per frame

        // No weapon equipped: ensure mouse IK/facing is disabled (it can otherwise remain enabled after unequip).
        if equipped_weapon_type == .NONE {
            this->set_mouse_ik_enabled(false);
        }

        // Base safe zone regen (server-authoritative).
        if Game.is_server() {
            if !death_pickup_lockout && CurrentHealth > 0 && CurrentHealth < MaxHealth {
                if player_is_in_own_base_safe_zone(this) {
                    CurrentHealth += BASE_SAFE_ZONE_REGEN_HP_PER_SEC * dt;
                    if CurrentHealth > MaxHealth {
                        CurrentHealth = MaxHealth;
                    }
                }
            }
        }

        // Damage flash (runs on server + clients so everyone sees it).
        {
            FLASH_DURATION :: 0.5;
            FLASH_HZ :: 20.0; // toggles ~10 times over 0.5s

            now := get_time();
            flashing := (damage_flash_start_time > 0.0) && (now - damage_flash_start_time <= FLASH_DURATION);

            if animator != null && animator.instance != null {
                if flashing {
                    tick := ((now - damage_flash_start_time) * FLASH_HZ).(int);
                    if (tick % 2) == 0 {
                        animator.instance.color_multiplier = {1, 1, 1, 1};
                    }
                    else {
                        animator.instance.color_multiplier = {1, 0.2, 0.2, 1};
                    }
                }
                else {
                    animator.instance.color_multiplier = {1, 1, 1, 1};
                }
            }
        }

        // Spawn shield VFX (runs on all clients so everyone sees it).
        {
            now := get_time();
            is_protected := now < spawn_protection_until && !death_pickup_lockout;
            SHIELD_INTRO_DURATION :: 0.6;   // seconds for intro anim
            DISAPPEAR_LEAD :: 0.8;          // start disappear this long before expiry
            DISAPPEAR_DURATION :: 0.8;      // seconds for disappear anim

            should_disappear := !is_protected || (spawn_protection_until - now) < DISAPPEAR_LEAD;

            if is_protected && !should_disappear {
                // Shield should be visible.
                if shield_entity == null || shield_entity.self == null {
                    shield_entity = Scene.create_entity();
                    shield_spine = shield_entity->add_component(Spine_Animator);
                    shield_spine->awaken();
                    shield_asset := get_asset(Spine_Asset, "Animations/008BED_Shield_spine/008BED_Shield.spine");
                    shield_spine.instance->set_skeleton(shield_asset);
                    shield_spine.instance->set_animation("intro", false, 0);
                    shield_spine.depth_offset = -5.0; // render on top of player
                    shield_playing_disappear = false;
                    shield_created_time = now;
                }

                // After intro duration, switch to idle_loop.
                if !shield_playing_disappear && (now - shield_created_time) >= SHIELD_INTRO_DURATION {
                    if shield_spine != null && shield_spine.instance != null {
                        // Only set once (check if we haven't already switched).
                        if (now - shield_created_time) < SHIELD_INTRO_DURATION + dt + 0.05 {
                            shield_spine.instance->set_animation("idle_loop", true, 0);
                        }
                    }
                }

                // Follow player position (offset up to center on body).
                if entity != null && entity.self != null && shield_entity != null && shield_entity.self != null {
                    shield_entity->set_local_position(entity.world_position + v2{0, 0.5});
                }
            }
            else if shield_entity != null && shield_entity.self != null {
                // Play disappear then destroy.
                if !shield_playing_disappear {
                    shield_playing_disappear = true;
                    shield_disappear_start_time = now;
                    if shield_spine != null && shield_spine.instance != null {
                        shield_spine.instance->set_animation("disappear", false, 0);
                    }
                }

                // Destroy after disappear duration.
                if shield_playing_disappear && (now - shield_disappear_start_time) >= DISAPPEAR_DURATION {
                    shield_entity->destroy();
                    shield_entity = null;
                    shield_spine = null;
                    shield_playing_disappear = false;
                }

                // Keep following player while disappearing.
                if entity != null && entity.self != null && shield_entity != null && shield_entity.self != null {
                    shield_entity->set_local_position(entity.world_position + v2{0, 0.5});
                }
            }
        }

        // Ensure the player can't move while the Sell Shop modal is open.
        // Do this server-side so movement is authoritatively blocked.
        if Game.is_server() {
            if sell_shop_open {
                if !sell_shop_movement_locked {
                    this->add_disable_movement_input_reason("sell_shop_ui");
                    sell_shop_movement_locked = true;
                }
            }
            else {
                if sell_shop_movement_locked {
                    this->remove_disable_movement_input_reason("sell_shop_ui");
                    sell_shop_movement_locked = false;
                }
            }

            // Ensure the player can't move while the Weapons Shop modal is open.
            if weapons_shop_open {
                if !weapons_shop_movement_locked {
                    this->add_disable_movement_input_reason("weapons_shop_ui");
                    weapons_shop_movement_locked = true;
                }
            }
            else {
                if weapons_shop_movement_locked {
                    this->remove_disable_movement_input_reason("weapons_shop_ui");
                    weapons_shop_movement_locked = false;
                }
            }

            // Clear "holding interactable" theft state shortly after the player stops holding.
            // (There's no explicit "hold ended" callback.)
            VAULT_HOLD_CLEAR_GRACE :: 0.25;
            if vault_theft_target_entity_id != 0 && vault_theft_last_hold_time > 0 {
                if get_time() - vault_theft_last_hold_time > VAULT_HOLD_CLEAR_GRACE {
                    vault_theft_target_entity_id = 0;
                    vault_theft_hold_start_time = 0;
                    vault_theft_last_hold_time = 0;
                    vault_theft_owner_notified = false;
                }
            }

            // Server-authoritative tutorial progression.
            tutorial_server_tick();
        }

        // Compute a shared "is_moving" flag from the movement agent's velocity.
        is_moving := false;
        if #alive(agent) {
            vel := agent.velocity;
            speed_sq := vel.x * vel.x + vel.y * vel.y;
            if speed_sq > 0.0001 {
                is_moving = true;
            }
        }

     // Drive the base player state machine's "moving" variable, if present.
        if base_state_machine != null {
            base_state_machine->set_bool("moving", is_moving);
        }

    }

    // Called on clients immediately after this Player's state sync is applied.
    // Use this to update local-only derived station tuning so station world UI shows correct levels/speed.
    ao_on_state_sync :: method() {
        gm := get_game_manager();
        if gm != null {
            gm->apply_station_upgrade_levels_for_player(this);
            gm->apply_vault_level_for_player(this);
        }
    }

    ao_late_update :: method(dt: float) {
        // Called once per frame after physics has been resolved

         // UI should only be drawn for the local player (and on server for validation if needed)
        if !this->is_local_or_server() {
            return;
        }

        // Client-side toast if someone starts stealing our vault.
        client_check_vault_theft_notifications();

        // Draw world-space player health bars locally (cosmetic-only).
        // Do it here (late update) so it's stable and not tied to replicated/nameplate rect state.
        if this->is_local() {
            draw_all_players_health_bars_local();
            draw_all_players_carried_bills_local();
            draw_all_truck_health_bars_local();
        }

         // Draw floating combat text damage numbers in world space.
        this->draw_damage_numbers(dt);

        // Draw fire ability button based on equipped weapon
        if equipped_weapon_type != .NONE {
            config := get_weapon_config(equipped_weapon_type);
            switch config.fire_mode {
                case .CONTINUOUS:  { draw_ability_button(this, Continuous_Fire_Ability, 0); }
                case .SINGLE_SHOT: { draw_ability_button(this, Single_Shot_Ability, 0); }
                case .SPREAD:      { draw_ability_button(this, Spread_Shot_Ability, 0); }
                case .LOBBED:      { draw_ability_button(this, Lobbed_Shot_Ability, 0); }
                case .BEAM:        { draw_ability_button(this, Beam_Ability, 0); }
                case .SPECIAL:     { draw_ability_button(this, Special_Ability, 0); }
            }
        }

        // Draw hotbar and handle equip/unequip
        options := Inventory_Draw_Options.default();
        hotbar := Items.draw_hotbar(this, default_inventory, options);
        handle_equipped_item_changing(hotbar.selected_item_index);
        client_purchase_fx_tick(hotbar.entire_rect);

        // Allow dropping items from the hotbar. Apply server-side so it is authoritative.
        if Game.is_server() {
            if hotbar.dropped_item != null {
                drop_pos := entity.world_position + v2{0, 0.5};
                _ := ItemDrops.spawn_from_inventory_item_with_dropper_lockout(drop_pos, hotbar.dropped_item, this, 7.0);
            }
        }

        // Currency HUD
        draw_coin_currency_hud(this);
        draw_finished_bills_per_sec_hud(this);
        client_coin_gain_particles_tick();

        // Draw weapons shop button + modal UI.
        draw_weapons_shop_ui(this);

        // Draw sell shop button + modal UI.
        draw_sell_shop_ui(this);

        // Draw managers button + modal UI.
        draw_managers_ui(this);

        // Draw harvester upgrades button + modal UI.
        draw_harvester_upgrades_ui(this);

        // Draw truck upgrades button + modal UI.
        draw_truck_upgrades_ui(this);

        // Draw station upgrades button + modal UI.
        draw_upgrades_ui(this);

        // Quest panel UI.
        // Only show quests after the player finishes the tutorial (step 11 = complete).
        if tutorial_step >= 11 {
            draw_quests_ui(this);
        }

        // Tutorial HUD (text + arrow).
        draw_tutorial_hud();

        // Cosmetic: draw per-player screen-space particles on top.
        if ui_directed_particle_handler != null {
            ui_directed_particle_handler->update_and_draw(dt);
        }
    }

    tutorial_has_item_id :: method(item_id: string) -> bool {
        if item_id.count <= 0 return false;
        inv := default_inventory;
        if inv == null || inv.self == null || inv.capacity <= 0 {
            return false;
        }

        for i: 0..inv.capacity-1 {
            item := inv->get_item(i);
            if item == null continue;
            if item.self == null continue;
            defn := item->get_definition();
            if defn == null continue;
            if defn->get_id() == item_id {
                return true;
            }
        }

        return false;
    }

    tutorial_find_owned_paper_mill_lane0 :: method() -> Paper_Mill {
        foreach m: component_iterator(Paper_Mill) {
            if m == null continue;
            if m.entity == null || m.entity.self == null continue;
            if !m.entity->get_world_enabled() continue;
            if m.lane_index != 0 continue;
            if is_owner_of_parent_base(m.entity, this) {
                return m;
            }
        }
        return null;
    }

