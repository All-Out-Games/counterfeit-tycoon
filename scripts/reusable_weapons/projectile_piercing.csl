Piercing_Projectile :: class : Component {
    damage: float;
    lifetime: float;
    direction: v2;
    owner_id: u64;
    speed: float;
    max_lifetime: float;
    hit_ids: [32]u64;
    hit_count: s64;
    mute_hit_sound: bool;

    ao_update :: method(dt: float) {
        lifetime += dt;
        if max_lifetime <= 0 {
            max_lifetime = 3.0;
        }
        if lifetime > max_lifetime {
            entity.destroy();
            return;
        }

        move := v2{direction.x * speed * dt, direction.y * speed * dt};
        entity.add_local_position(move);

        if Game.is_server() {
            pos := entity.world_position + v2{0, -0.5};
            nearby: [..]Player;
            Scene.get_all_components_in_range(pos, 0.8, ref nearby);

            for hit_player: nearby {
                if hit_player.entity.id == owner_id continue;

                // Check if already hit
                already_hit := false;
                j := 0;
                while j < hit_count {
                    if hit_ids[j] == hit_player.entity.id {
                        already_hit = true;
                    }
                    j += 1;
                }
                if already_hit continue;

                did_damage := hit_player.take_damage(damage, null, true);
                if did_damage {
                    // Record hit only if damage was accepted (spawn protection, death, etc. can block).
                    if hit_count < 32 {
                        hit_ids[hit_count] = hit_player.entity.id;
                        hit_count += 1;
                    }

                    if !mute_hit_sound {
                        hit_sfx := get_asset(SFX_Asset, "reusable_weapons/sounds/reusable-weapons/bullet_hit.wav");
                        sfx_desc := SFX.default_sfx_desc();
                        sfx_desc.set_position(pos);
                        sfx_desc.range_multiplier = 2.0;
                        SFX.play(hit_sfx, sfx_desc);
                    }
                }
            }

            // Truck hit registration (only when carrying bills, and never by its owner)
            nearby_trucks: [..]Truck;
            Scene.get_all_components_in_range(pos, 1.25, ref nearby_trucks);

            for hit_truck: nearby_trucks {
                if hit_truck == null continue;
                if hit_truck.entity == null || !#alive(hit_truck.entity) continue;

                // Check if already hit
                already_hit := false;
                j := 0;
                while j < hit_count {
                    if hit_ids[j] == hit_truck.entity.id {
                        already_hit = true;
                    }
                    j += 1;
                }
                if already_hit continue;

                if hit_truck.server_register_weapon_hit(owner_id, damage) {
                    // Record hit (only if the hit was accepted)
                    if hit_count < 32 {
                        hit_ids[hit_count] = hit_truck.entity.id;
                        hit_count += 1;
                    }

                    if !mute_hit_sound {
                        hit_sfx := get_asset(SFX_Asset, "reusable_weapons/sounds/reusable-weapons/bullet_hit.wav");
                        sfx_desc := SFX.default_sfx_desc();
                        sfx_desc.set_position(pos);
                        sfx_desc.range_multiplier = 2.0;
                        SFX.play(hit_sfx, sfx_desc);
                    }
                }
            }

            // Turret hit registration (piercing: can hit multiple unique targets).
            nearby_turrets: [..]Turret;
            Scene.get_all_components_in_range(pos, 1.25, ref nearby_turrets);

            for hit_turret: nearby_turrets {
                if hit_turret == null continue;
                if hit_turret.entity == null || !#alive(hit_turret.entity) continue;

                // Check if already hit
                already_hit := false;
                j := 0;
                while j < hit_count {
                    if hit_ids[j] == hit_turret.entity.id {
                        already_hit = true;
                    }
                    j += 1;
                }
                if already_hit continue;

                if hit_turret.server_register_weapon_hit(owner_id, damage) {
                    // Record hit (only if the hit was accepted)
                    if hit_count < 32 {
                        hit_ids[hit_count] = hit_turret.entity.id;
                        hit_count += 1;
                    }

                    if !mute_hit_sound {
                        hit_sfx := get_asset(SFX_Asset, "reusable_weapons/sounds/reusable-weapons/bullet_hit.wav");
                        sfx_desc := SFX.default_sfx_desc();
                        sfx_desc.set_position(pos);
                        sfx_desc.range_multiplier = 2.0;
                        SFX.play(hit_sfx, sfx_desc);
                    }
                }
            }
        }
    }
}

spawn_piercing_projectile :: proc(player: Player, direction: v2, wt: Weapon_Type) {
    if !Game.is_server() return;

    config := get_weapon_config(wt);
    spawn_pos := get_projectile_spawn_pos(player, direction);

    proj_entity := Scene.create_entity();
    proj_entity.set_local_position(spawn_pos);

    angle := atan2(direction.y, direction.x);
    proj_entity.set_local_rotation(to_degrees(angle));

    bullet_texture := get_asset(Texture_Asset, "reusable_weapons/sprites/reusable-weapons/projectiles/MachineGunBullet.png");
    sprite := proj_entity.add_component(Sprite_Renderer);
    sprite.set_texture(bullet_texture);
    proj_entity.set_local_scale({2, 2});

    proj := proj_entity.add_component(Piercing_Projectile);
    proj.damage = config.base_damage;
    proj.direction = safe_normalize_v2(direction, v2{1, 0});
    proj.owner_id = player.entity.id;
    proj.speed = config.projectile_speed;
    proj.max_lifetime = config.projectile_lifetime;
}
