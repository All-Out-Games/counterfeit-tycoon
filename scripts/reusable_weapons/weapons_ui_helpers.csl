draw_all_players_health_bars_local :: proc() {
    // Purely cosmetic: draw world-space bars locally on each client.
    UI.push_world_draw_context();
    defer UI.pop_draw_context();

    foreach p: component_iterator(Player) {
        if p == null continue;
        if p.entity == null || p.entity.self == null continue;
        draw_health_bar_in_world_context(p);
    }
}

draw_health_bar_in_world_context :: proc(player: Player) {
    if player == null return;
    if player.entity == null || player.entity.self == null return;

    // Anchor directly to player world position (do not depend on nameplate rects, which can be unstable).
    pos := player.entity.world_position + v2{0, 1.75};

    UI.push_z(pos.y - 0.0001);
    defer UI.pop_z();

    // World-space sizing (meters)
    // Tuned to be closer to the old scaled UI size.
    health_rect := Rect{pos, pos}->grow(0.06, 0.60, 0.06, 0.60); // ~1.2m wide, ~0.12m tall
    border_rect := health_rect->grow(0.02, 0.02, 0.02, 0.02);

    back := get_asset(Texture_Asset, "reusable_weapons/sprites/reusable-weapons/hud_elements/health_bar_green/healthbar_back.png");
    fill := get_asset(Texture_Asset, "reusable_weapons/sprites/reusable-weapons/hud_elements/health_bar_green/healthbar_fill.png");
    pip := get_asset(Texture_Asset, "reusable_weapons/sprites/reusable-weapons/hud_elements/health_bar_green/healthbar_pip.png");

    // Background
    UI.quad(border_rect, back, {1, 1, 1, 1});

    // Health fill
    health_pct := 0.0;
    if player.MaxHealth > 0 {
        health_pct = player.CurrentHealth / player.MaxHealth;
        if health_pct < 0 { health_pct = 0; }
        if health_pct > 1 { health_pct = 1; }
    }
    fill_rect := health_rect->subrect(0, 0, health_pct, 1);
    UI.quad(fill_rect, fill, {1, 1, 1, 1});

    // Pip markers
    total_pips :: 6;
    health_per_pip := 0.0;
    if total_pips > 0 {
        health_per_pip = player.MaxHealth / total_pips.(float);
    }

    left_offset :: 0.05;
    right_offset :: 0.05;
    available_width := 1.0 - left_offset - right_offset;
    pip_width := available_width / total_pips.(float);
    shrink :: 0.3;

    i := 0;
    while i < total_pips {
        pip_threshold := (i + 1).(float) * health_per_pip;
        if player.CurrentHealth >= pip_threshold {
            x_min := left_offset + i.(float) * pip_width;
            new_width := pip_width * shrink;
            new_x_min := x_min + (pip_width - new_width) / 2.0;
            new_x_max := new_x_min + new_width;
            pip_rect := health_rect->subrect(new_x_min, 0, new_x_max, 1);
            UI.quad(pip_rect, pip, {1, 1, 1, 1});
        }
        i += 1;
    }
}

// Backwards-compatible single-player draw (still local-only if you call it from client code).
draw_health_bar :: proc(player: Player) {
    UI.push_world_draw_context();
    defer UI.pop_draw_context();
    draw_health_bar_in_world_context(player);
}
