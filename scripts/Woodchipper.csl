import "core:ao"

// Woodchipper:
// - Spawned via prefab and assigned to a specific owner (PlayerBase parent).
// - Acts as a "Harvester Manager":
//   - Dispatches the owner's Harvester to gather wood.
//   - Collects wood directly from the Harvester when it returns home (server-authoritative).
//   - Also picks up nearby Wood world drops (exclusive-aware).
//   - Deposits collected wood into the "most empty" Paper_Mill belonging to the owner's lanes:
//     chooses the Paper_Mill with the lowest stored_wood (ties -> lowest lane index).
//     If no mills are found, defaults to lane 0 (Lane 1).
// - Despawns automatically if its owning player disconnects.
//
// Setup:
// - Add `Woodchipper` to an entity that has a `Movement_Agent` component.
// - The Woodchipper entity should be parented under the owning PlayerBase entity.
// - A server-side spawner should call `server_init(owner_user_id)` after instantiation.

Woodchipper_State :: enum {
    TO_HARVESTER;
    WAIT_AT_HARVESTER;
    TO_MILL;
    WAIT_AT_MILL;
    PAUSE_BEFORE_TO_MILL;
    PAUSE_BEFORE_TO_HARVESTER;
}

woodchipper_find_paper_mill_for_base_and_lane :: proc(base: PlayerBase, lane_index: s64) -> Paper_Mill {
    if base == null return null;
    if base.entity == null || base.entity.self == null return null;

    foreach m: component_iterator(Paper_Mill) {
        if m == null continue;
        if m.entity == null || m.entity.self == null continue;
        if !m.entity->get_world_enabled() continue;
        if m.lane_index != lane_index continue;

        pb := get_parent_player_base(m.entity);
        if pb == base {
            return m;
        }
    }
    return null;
}

woodchipper_choose_best_paper_mill_lane :: proc(base: PlayerBase) -> s64 {
    if base == null return 0;
    if base.entity == null || base.entity.self == null return 0;

    best_lane: s64 = 0;
    best_wood: s64 = 0;
    found: bool = false;

    foreach m: component_iterator(Paper_Mill) {
        if m == null continue;
        if m.entity == null || m.entity.self == null continue;
        if !m.entity->get_world_enabled() continue;

        pb := get_parent_player_base(m.entity);
        if pb != base continue;

        lane := m.lane_index;
        if lane < 0 || lane > 3 continue;

        // Prefer mills with lower stored_wood (i.e. "more empty").
        wood := m.stored_wood;
        if wood < 0 wood = 0;

        if !found {
            found = true;
            best_lane = lane;
            best_wood = wood;
            continue;
        }

        if wood < best_wood {
            best_lane = lane;
            best_wood = wood;
        }
        else if wood == best_wood && lane < best_lane {
            best_lane = lane;
        }
    }

    return best_lane;
}

Woodchipper :: class : Component {
    // Tuning
    move_speed: float @ao_serialize;
    arrive_radius: float @ao_serialize;
    max_drive_seconds: float @ao_serialize; // Safety timeout to prevent soft-locks.

    max_wood_capacity: s64 @ao_serialize;
    collect_interval: float @ao_serialize;  // seconds between collect attempts while waiting at harvester
    deposit_interval: float @ao_serialize;  // seconds between deposit attempts while waiting at mill
    path_wait_seconds: float @ao_serialize; // downtime between travel legs
    pickup_radius: float @ao_serialize;     // radius to pick up nearby Wood drops

    // Spine visuals (same pattern as Colorist)
    spine_animator: Spine_Animator @ao_serialize;
    spine_entity: Entity @ao_serialize;

    // World UI
    ui_offset: v2 @ao_serialize;

    // Synced / runtime
    owner_user_id: string;
    state: Woodchipper_State;
    carried_wood: s64;
    target_mill_lane_index: s64; // 0-based

    // Runtime
    agent: Movement_Agent;
    drive_start_time: float;
    last_action_time: float;
    pause_until_time: float;
    break_variant: s64; // 1 or 2, controls Idle_Break_1 vs Idle_Break_2

    // Cache the spot we were standing when we FIRST successfully dispatched the Harvester.
    // When returning to "wait for Harvester", we go back to this point.
    harvester_dispatch_origin_world_pos: v2;
    harvester_dispatch_origin_set: bool;

    spine: Spine_Animator;
    spine_sm: State_Machine;
    spine_base_scale: v2;
    spine_scale_initialized: bool;

    last_world_pos: v2;
    last_world_pos_initialized: bool;

    ao_start :: method() {
        // Defaults (only if not set in editor)
        if move_speed <= 0 {
            move_speed = 3.75;
        }
        if arrive_radius <= 0 {
            arrive_radius = 0.6;
        }
        if max_drive_seconds <= 0 {
            max_drive_seconds = 60.0;
        }
        if max_wood_capacity <= 0 {
            max_wood_capacity = 64;
        }
        if collect_interval <= 0 {
            collect_interval = 0.35;
        }
        if deposit_interval <= 0 {
            deposit_interval = 0.25;
        }
        if path_wait_seconds <= 0 {
            path_wait_seconds = 3.0;
        }
        if pickup_radius <= 0 {
            pickup_radius = 1.8;
        }
        if ui_offset.x == 0 && ui_offset.y == 0 {
            ui_offset = {0, 1.35};
        }
        if target_mill_lane_index < 0 {
            target_mill_lane_index = 0;
        }

        agent = entity->get_component(Movement_Agent);
        if agent == null {
            log_warning("Woodchipper: missing Movement_Agent on Woodchipper entity", {});
        }

        last_world_pos = entity.world_position;
        last_world_pos_initialized = true;

        resolve_spine();
        setup_spine_state_machine();
        update_visuals(); // ensure correct initial anim + facing

        // Best-effort default ownership if we were already parented under a PlayerBase.
        pb := get_parent_player_base(entity);
        if pb != null {
            owner_user_id = pb.owner_user_id;
        }

        // Start by heading to the Harvester.
        if state != .TO_HARVESTER && state != .WAIT_AT_HARVESTER && state != .TO_MILL && state != .WAIT_AT_MILL {
            state = .TO_HARVESTER;
        }
        if Game.is_server() {
            drive_start_time = get_time();
            last_action_time = 0;
            pause_until_time = 0;
            break_variant = 0;
            harvester_dispatch_origin_set = false;
            harvester_dispatch_origin_world_pos = entity.world_position;
        }
    }

    // Called by the server-side spawner after instantiation.
    server_init :: method(owner_id: string) {
        if !Game.is_server() {
            return;
        }
        owner_user_id = owner_id;
        state = .TO_HARVESTER;
        carried_wood = 0;
        target_mill_lane_index = 0;
        drive_start_time = get_time();
        last_action_time = 0;
        pause_until_time = 0;
        break_variant = 0;
        harvester_dispatch_origin_set = false;
        harvester_dispatch_origin_world_pos = entity.world_position;
    }

    target_pos_for_harvester :: method(h: Harvester) -> v2 {
        if h == null return entity.world_position;
        // Path to the Harvester "home" location so we don't chase it while it works.
        return h.home_world_pos + v2{0, -1.0};
    }

    target_pos_for_waiting_on_harvester :: method(h: Harvester) -> v2 {
        if harvester_dispatch_origin_set {
            return harvester_dispatch_origin_world_pos;
        }
        return target_pos_for_harvester(h);
    }

    target_pos_for_mill :: method(m: Paper_Mill) -> v2 {
        if m == null return entity.world_position;
        if m.entity == null || m.entity.self == null return entity.world_position;
        return m.entity.world_position + v2{0, -1.0};
    }

    is_moving :: method() -> bool {
        return state == .TO_HARVESTER || state == .TO_MILL;
    }

    is_pausing :: method() -> bool {
        return state == .PAUSE_BEFORE_TO_MILL || state == .PAUSE_BEFORE_TO_HARVESTER;
    }

    should_play_bored_idle :: method() -> bool {
        // Only play bored idle when we're waiting at a station with no output to pick up.
        // (Not when we're pausing between path legs.)
        if state != .WAIT_AT_HARVESTER return false;
        if carried_wood > 0 return false;

        pb := get_parent_player_base(entity);
        if pb == null return false;

        harvester := find_harvester_for_base(pb);
        if harvester == null return false;
        return harvester.carried_wood <= 0;
    }

    server_begin_pause :: method(next_state: Woodchipper_State) {
        if !Game.is_server() return;

        if path_wait_seconds <= 0 {
            state = next_state;
            drive_start_time = get_time();
            last_action_time = 0;
            pause_until_time = 0;
            break_variant = 0;
            return;
        }

        rng := rng_seed_time();
        choice := rng_range_int(ref rng, 1, 2);

        break_variant = choice;
        pause_until_time = get_time() + path_wait_seconds;
        last_action_time = get_time();
        drive_start_time = 0;

        if next_state == .TO_MILL {
            state = .PAUSE_BEFORE_TO_MILL;
        }
        else {
            state = .PAUSE_BEFORE_TO_HARVESTER;
        }
    }

    resolve_spine :: method() {
        spine = null;
        target_entity := entity;

        if spine_animator != null {
            spine = spine_animator;
            if spine_animator.entity != null && spine_animator.entity.self != null {
                target_entity = spine_animator.entity;
            }
        }
        else if spine_entity != null && spine_entity.self != null {
            spine = spine_entity->get_component(Spine_Animator);
            target_entity = spine_entity;
        }
        else if target_entity != null && target_entity.self != null {
            spine = target_entity->get_component(Spine_Animator);
        }

        if spine != null {
            spine->awaken();
        }

        // Cache initial scale for flip logic.
        if !spine_scale_initialized {
            if target_entity != null && target_entity.self != null {
                spine_base_scale = target_entity.local_scale;
                if spine_base_scale.x == 0 {
                    spine_base_scale.x = 1;
                }
                if spine_base_scale.y == 0 {
                    spine_base_scale.y = 1;
                }
                spine_scale_initialized = true;
            }
        }
    }

    setup_spine_state_machine :: method() {
        if spine == null return;
        if spine.instance == null return;
        if spine_sm != null return;

        spine_sm = State_Machine.create();

        mode_var := spine_sm->create_variable("anim_mode", .INT);
        push_var := spine_sm->create_variable("push", .TRIGGER);
        layer := spine_sm->create_layer("main", 0);

        // anim_mode mapping:
        // 0 = Idle
        // 1 = Run
        // 2 = Idle_Break_1
        // 3 = Idle_Break_2
        idle_state := layer->create_state("Idle", true);
        run_state := layer->create_state("Run", true);
        break1_state := layer->create_state("Idle_Break_1", true);
        break2_state := layer->create_state("Idle_Break_2", true);
        push_state := layer->create_state("Push", false);
        layer->set_initial_state(idle_state);

        idle_to_run := layer->create_transition(idle_state, run_state, false);
        idle_to_run->create_int_condition(mode_var, 1, .EQUAL);

        idle_to_b1 := layer->create_transition(idle_state, break1_state, false);
        idle_to_b1->create_int_condition(mode_var, 2, .EQUAL);

        idle_to_b2 := layer->create_transition(idle_state, break2_state, false);
        idle_to_b2->create_int_condition(mode_var, 3, .EQUAL);

        run_to_idle := layer->create_transition(run_state, idle_state, false);
        run_to_idle->create_int_condition(mode_var, 0, .EQUAL);

        run_to_b1 := layer->create_transition(run_state, break1_state, false);
        run_to_b1->create_int_condition(mode_var, 2, .EQUAL);

        run_to_b2 := layer->create_transition(run_state, break2_state, false);
        run_to_b2->create_int_condition(mode_var, 3, .EQUAL);

        b1_to_idle := layer->create_transition(break1_state, idle_state, false);
        b1_to_idle->create_int_condition(mode_var, 0, .EQUAL);

        b1_to_run := layer->create_transition(break1_state, run_state, false);
        b1_to_run->create_int_condition(mode_var, 1, .EQUAL);

        b1_to_b2 := layer->create_transition(break1_state, break2_state, false);
        b1_to_b2->create_int_condition(mode_var, 3, .EQUAL);

        b2_to_idle := layer->create_transition(break2_state, idle_state, false);
        b2_to_idle->create_int_condition(mode_var, 0, .EQUAL);

        b2_to_run := layer->create_transition(break2_state, run_state, false);
        b2_to_run->create_int_condition(mode_var, 1, .EQUAL);

        b2_to_b1 := layer->create_transition(break2_state, break1_state, false);
        b2_to_b1->create_int_condition(mode_var, 2, .EQUAL);

        to_push := layer->create_global_transition(push_state, false);
        to_push->create_trigger_condition(push_var);
        _ := to_push;
        push_to_idle := layer->create_transition(push_state, idle_state, true);
        _ := push_to_idle;

        spine.instance->set_state_machine(spine_sm, true); // transfer ownership
    }

    try_play_push_when_placing_items :: method() {
        if state != .WAIT_AT_MILL return;
        if spine == null return;
        if spine.instance == null return;
        if spine.instance.state_machine == null return;

        Push_Seen_Entry :: struct {
            id: u64;
            carried: s64;
        }
        #static seen: [64]Push_Seen_Entry;

        slot: s64 = -1;
        empty: s64 = -1;
        for i: 0..63 {
            if seen[i].id == entity.id {
                slot = i;
                break;
            }
            if seen[i].id == 0 && empty < 0 {
                empty = i;
            }
        }
        if slot < 0 {
            slot = (empty >= 0) ? empty : 0;
            seen[slot].id = entity.id;
            seen[slot].carried = carried_wood;
            return;
        }

        prev := seen[slot].carried;
        if carried_wood < prev && prev > 0 {
            spine.instance.state_machine->set_trigger("push");
        }
        seen[slot].carried = carried_wood;
    }

    update_spine_state :: method() {
        if spine == null return;
        if spine.instance == null return;
        if spine.instance.state_machine == null return;

        mode := 0;
        if is_moving() {
            mode = 1;
        }
        else if should_play_bored_idle() {
            mode = (break_variant == 1) ? 2 : 3;
        }
        spine.instance.state_machine->set_int("anim_mode", mode);
    }

    update_visuals :: method() {
        if spine == null {
            resolve_spine();
            setup_spine_state_machine();
        }

        cur := entity.world_position;
        if !last_world_pos_initialized {
            last_world_pos = cur;
            last_world_pos_initialized = true;
        }
        delta := cur - last_world_pos;
        last_world_pos = cur;

        if spine_scale_initialized {
            target_entity := entity;
            if spine_entity != null && spine_entity.self != null {
                target_entity = spine_entity;
            }

            if target_entity != null && target_entity.self != null {
                if delta.x > 0.001 {
                    target_entity->set_local_scale({abs(spine_base_scale.x), spine_base_scale.y});
                }
                else if delta.x < -0.001 {
                    target_entity->set_local_scale({-abs(spine_base_scale.x), spine_base_scale.y});
                }
            }
        }

        update_spine_state();
        apply_depth_sort_from_owner();
    }

    apply_depth_sort_from_owner :: method() {
        if spine == null return;
        pb := get_parent_player_base(entity);
        if pb == null return;
        owner := pb->get_owner();
        if owner == null return;
        if owner.self == null return;
        if owner.animator == null return;

        spine.layer = owner.animator.layer;
        spine.depth_offset = owner.animator.depth_offset;
    }

    has_arrived :: method(target: v2) -> bool {
        delta := entity.world_position - target;
        return length_squared(delta) <= arrive_radius * arrive_radius;
    }

    server_should_despawn :: method() -> bool {
        if owner_user_id.count == 0 {
            return true;
        }

        pb := get_parent_player_base(entity);
        if pb == null {
            return true;
        }
        if pb.owner_user_id.count == 0 {
            return true;
        }
        if pb.owner_user_id != owner_user_id {
            return true;
        }

        owner := pb->get_owner();
        if owner == null {
            return true;
        }
        return false;
    }

    collect_nearby_wood_drops :: method() {
        if !Game.is_server() return;
        if pickup_radius <= 0 {
            pickup_radius = 1.8;
        }
        if carried_wood >= max_wood_capacity {
            return;
        }

        origin := entity.world_position;
        max_d2 := pickup_radius * pickup_radius;

        foreach d: component_iterator(Item_Drop_Magnet) {
            if d == null continue;
            if d.entity == null || d.entity.self == null continue;
            if !d.entity->get_world_enabled() continue;
            if d.defn == null continue;
            if d.count <= 0 continue;
            if d.defn->get_id() != "wood" continue;

            // Respect exclusivity: don't steal another player's exclusive drop.
            if d.exclusive_to_player.count > 0 && d.exclusive_to_player != owner_user_id {
                continue;
            }

            d2 := length_squared(d.entity.world_position - origin);
            if d2 > max_d2 continue;

            room := max_wood_capacity - carried_wood;
            if room <= 0 break;

            take := d.count;
            if take > room {
                take = room;
            }
            if take <= 0 continue;

            carried_wood += take;
            d.count -= take;

            if d.count <= 0 {
                d.claimed = true;
                d.time_claimed = get_time();
                d.entity->queue_for_destruction(1);
            }

            if carried_wood >= max_wood_capacity {
                break;
            }
        }
    }

    ao_update :: method(dt: float) {
        _ := dt;

        // Visuals/animation should run on all peers (server + clients).
        update_visuals();
        try_play_push_when_placing_items();

        if agent == null {
            agent = entity->get_component(Movement_Agent);
        }

        pb := get_parent_player_base(entity);
        harvester := (pb != null) ? find_harvester_for_base(pb) : null;
        mill := woodchipper_find_paper_mill_for_base_and_lane(pb, target_mill_lane_index);

        // Client+server: drive movement targets for smoother replicated motion.
        if agent != null {
            switch state {
                case .TO_HARVESTER: {
                    if harvester != null {
                        _ := agent->set_path_target(target_pos_for_waiting_on_harvester(harvester), move_speed);
                    }
                }
                case .TO_MILL: {
                    if mill != null {
                        _ := agent->set_path_target(target_pos_for_mill(mill), move_speed);
                    }
                }
            }
        }

        // Server-authoritative logic (state changes + storage transfer).
        if !Game.is_server() {
            return;
        }

        if server_should_despawn() {
            entity->destroy();
            return;
        }

        if carried_wood < 0 carried_wood = 0;
        if carried_wood > max_wood_capacity carried_wood = max_wood_capacity;

        // Timeout safety: if we get stuck, reset toward the Harvester as "home".
        if (state == .TO_HARVESTER || state == .TO_MILL) && drive_start_time > 0 && max_drive_seconds > 0 {
            if get_time() - drive_start_time > max_drive_seconds {
                state = .TO_HARVESTER;
                drive_start_time = get_time();
                last_action_time = 0;
                pause_until_time = 0;
                break_variant = 0;
            }
        }

        switch state {
            case .TO_HARVESTER: {
                if harvester == null {
                    state = .WAIT_AT_HARVESTER;
                    drive_start_time = 0;
                    last_action_time = 0;
                    return;
                }
                if has_arrived(target_pos_for_waiting_on_harvester(harvester)) {
                    state = .WAIT_AT_HARVESTER;
                    drive_start_time = 0;
                    last_action_time = 0;
                }
            }
            case .WAIT_AT_HARVESTER: {
                if harvester == null {
                    return;
                }

                // Choose a break variant only when we're truly waiting on empty output.
                // This prevents "bored" idles from being associated with path pauses.
                if carried_wood <= 0 && harvester.carried_wood <= 0 {
                    if break_variant == 0 {
                        rng := rng_seed_time();
                        break_variant = rng_range_int(ref rng, 1, 2);
                    }
                }
                else {
                    break_variant = 0;
                }

                // Opportunistically pick up nearby wood drops.
                collect_nearby_wood_drops();

                // Always try to keep the Harvester working if it's idle+empty at home.
                // (This is cheap after the first dispatch since the method will early-out while busy.)
                dispatched := harvester->server_dispatch_for_manager(owner_user_id);
                if dispatched && !harvester_dispatch_origin_set {
                    harvester_dispatch_origin_world_pos = entity.world_position;
                    harvester_dispatch_origin_set = true;
                }

                // If we have room, try to collect wood from the Harvester when it's home.
                if last_action_time <= 0 || get_time() - last_action_time >= collect_interval {
                    if carried_wood < max_wood_capacity {
                        room := max_wood_capacity - carried_wood;
                        taken := harvester->server_collect_wood_for_manager(owner_user_id, room);
                        if taken > 0 {
                            carried_wood += taken;
                        }
                    }
                    last_action_time = get_time();
                }

                // Decide whether to head to a mill:
                // - If we have any wood and either we're full, or the Harvester can't give us more right now.
                if carried_wood > 0 {
                    // If the Harvester isn't currently home/idle, we can't top up more this moment.
                    harvester_ready := harvester->server_is_ready_for_manager(owner_user_id);
                    if carried_wood >= max_wood_capacity || !harvester_ready {
                        target_mill_lane_index = woodchipper_choose_best_paper_mill_lane(pb);
                        server_begin_pause(.TO_MILL);
                    }
                }
            }
            case .TO_MILL: {
                if mill == null {
                    // Re-choose a target lane and try again next tick.
                    target_mill_lane_index = woodchipper_choose_best_paper_mill_lane(pb);
                    mill = woodchipper_find_paper_mill_for_base_and_lane(pb, target_mill_lane_index);
                    if mill == null {
                        state = .TO_HARVESTER;
                        drive_start_time = get_time();
                        last_action_time = 0;
                        return;
                    }
                }
                if has_arrived(target_pos_for_mill(mill)) {
                    state = .WAIT_AT_MILL;
                    drive_start_time = 0;
                    last_action_time = 0;
                }
            }
            case .WAIT_AT_MILL: {
                if mill == null {
                    return;
                }

                // Also pick up any nearby loose wood around the mill.
                collect_nearby_wood_drops();

                if carried_wood <= 0 {
                    server_begin_pause(.TO_HARVESTER);
                    return;
                }

                if last_action_time <= 0 || get_time() - last_action_time >= deposit_interval {
                    deposited := mill->server_deposit_wood_from_manager(owner_user_id, carried_wood);
                    if deposited > 0 {
                        carried_wood -= deposited;
                        if carried_wood < 0 carried_wood = 0;
                    }
                    last_action_time = get_time();
                }

                if carried_wood <= 0 {
                    server_begin_pause(.TO_HARVESTER);
                }
            }
            case .PAUSE_BEFORE_TO_MILL: {
                if pause_until_time > 0 && get_time() >= pause_until_time {
                    state = .TO_MILL;
                    drive_start_time = get_time();
                    last_action_time = 0;
                    pause_until_time = 0;
                    break_variant = 0;
                }
            }
            case .PAUSE_BEFORE_TO_HARVESTER: {
                if pause_until_time > 0 && get_time() >= pause_until_time {
                    state = .TO_HARVESTER;
                    drive_start_time = get_time();
                    last_action_time = 0;
                    pause_until_time = 0;
                    break_variant = 0;
                }
            }
        }
    }

    ao_late_update :: method(dt: float) {
        _ := dt;
        draw_carried_ui();
    }

    draw_carried_ui :: method() {
        UI.push_world_draw_context();
        defer UI.pop_draw_context();

        UI.push_layer(5);
        defer UI.pop_layer();

        UI.push_z(entity.world_position.y - 0.002);
        defer UI.pop_z();

        pos := entity.world_position + ui_offset;

        rect := Rect{pos, pos}->grow(0.18, 0.55, 0.18, 0.55);
        icon_rect := rect->cut_left(0.22)->inset(0.01);
        text_rect := rect;

        #static wood_icon := get_asset(Texture_Asset, "Items/Wood.png");
        if wood_icon != null {
            UI.quad(icon_rect->fit_aspect(wood_icon->get_aspect()), wood_icon);
        }

        ts := UI.default_text_settings();
        ts.size = 0.34;
        ts.halign = .LEFT;
        ts.valign = .CENTER;
        ts.do_outline = true;
        ts.outline_thickness = 2;
        ts.outline_color = {0, 0, 0, 1};
        ts.color = {1, 1, 1, 1};
        ts.offset = {0.05, 0};

        UI.text(text_rect, ts, "x%", {carried_wood});
    }
}

