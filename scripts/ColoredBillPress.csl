import "core:ao"

colored_bill_press_save_key_blank_bills :: proc(lane_index: s64) -> string {
    // lane_index is 0-based
    return format_string("station_lane_%_colored_bill_press_blank_bills", {lane_index});
}

colored_bill_press_save_key_colored_bills :: proc(lane_index: s64) -> string {
    // lane_index is 0-based
    return format_string("station_lane_%_colored_bill_press_colored_bills", {lane_index});
}

// Colored Bill Press:
// - Players can interact to deposit Blank Bills from their inventory.
// - Deposited Blank Bills are converted into Colored Bills over time (server-authoritative).
// - Colored Bills are automatically granted to the closest player who enters collect radius.
// - Renders a small in-world UI panel with blank/colored bill counts + a timer bar.
//
// Setup:
// - Add `Colored_Bill_Press` to an entity in the editor.
// - Tune `radius` (inherited) for interaction range and `collect_radius` for auto-collection.
Colored_Bill_Press :: class : Interactable {
    // Tuning
    seconds_per_colored_bill: float @ao_serialize; // 1 blank bill -> 1 colored bill every N seconds
    deposit_per_interact: s64 @ao_serialize;       // how many blank bills to deposit per interaction (best-effort)
    collect_radius: float @ao_serialize;           // auto-collect radius (player proximity)
    collect_cooldown: float @ao_serialize;         // seconds between auto-collect attempts
    loot_spawn_radius: float @ao_serialize;        // radius around player where output spawns (edge of circle)
    lane_index: s64 @ao_serialize;                 // 0-based lane index (Lane 1 = 0)

    // Upgrades (server authoritative, replicated)
    upgrade_level: s64;                    // 1..10
    base_seconds_per_colored_bill: float;  // captured from editor/default tuning at ao_start

    // World UI
    ui_offset: v2 @ao_serialize;

    // Stored resources (synced)
    stored_blank_bills: s64;
    stored_colored_bills: s64;
    convert_timer: float;

    // Client-side UI smoothing (timer bar). These are re-initialized on clients
    // after every state sync via ao_on_state_sync.
    ui_timer_last_sync_time: float;
    ui_timer_last_synced_convert_timer: float;
    ui_timer_inited: bool;

    // Runtime
    last_collect_time: float;

    // Save/load (server only)
    loaded_from_save: bool;
    loaded_for_user_id: string;
    save_dirty: bool;
    last_save_time: float;

    ao_start :: method() {
        this->set_listener(this);

        // Defaults (only if not set in editor)
        if seconds_per_colored_bill <= 0 {
            seconds_per_colored_bill = 2.0;
        }
        if deposit_per_interact <= 0 {
            deposit_per_interact = 5;
        }
        if collect_radius <= 0 {
            collect_radius = 1.5;
        }
        if collect_cooldown <= 0 {
            collect_cooldown = 0.25;
        }
        if loot_spawn_radius <= 0 {
            loot_spawn_radius = 1.25;
        }
        if ui_offset.x == 0 && ui_offset.y == 0 {
            ui_offset = {0, 1.25};
        }
        if lane_index < 0 {
            lane_index = 0;
        }

        // Capture base tuning for upgrade scaling.
        base_seconds_per_colored_bill = seconds_per_colored_bill;
        if base_seconds_per_colored_bill <= 0 {
            base_seconds_per_colored_bill = 1.0;
        }
        // If we've already received replicated state from the server (common on clients),
        // don't clobber it here.
        if upgrade_level < 1 {
            upgrade_level = 1;
        }

        // Interaction prompt
        this->set_text("Deposit blank bills");
        this->set_hold_text("Depositing...");

        // Interactable defaults if not set
        if radius <= 0 {
            radius = 1.25;
        }
        if prompt_offset.x == 0 && prompt_offset.y == 0 {
            prompt_offset = ui_offset;
        }

        loaded_from_save = false;
        loaded_for_user_id = {};
        save_dirty = false;
        last_save_time = 0;

        // If ownership was already assigned during spawn, load immediately.
        server_try_load_from_save();

        // Ensure our derived speed is consistent with the current upgrade level.
        // This covers cases where the GameManager applies upgrades before ao_start runs.
        apply_upgrade_level(upgrade_level);
    }

    // Server-only: apply upgrade level to processing speed.
    server_set_upgrade_level :: method(level: s64) {
        if !Game.is_server() {
            return;
        }
        apply_upgrade_level(level);
    }

    // Apply upgrade level locally (client or server). This is safe on clients because it only
    // affects local presentation (e.g., world UI timer bar), while the server remains authoritative.
    apply_upgrade_level :: method(level: s64) {

        if level < 1 {
            level = 1;
        }
        if level > 10 {
            level = 10;
        }

        upgrade_level = level;

        // If our base tuning hasn't been initialized yet (ao_start not run),
        // don't attempt to recompute speed yet.
        if base_seconds_per_colored_bill <= 0 {
            return;
        }

        SPEED_MULT_PER_LEVEL :: 0.12;
        lvl_f := (level - 1).(float);
        mult := 1.0 + lvl_f * SPEED_MULT_PER_LEVEL;
        if mult <= 0 {
            mult = 1.0;
        }

        seconds_per_colored_bill = base_seconds_per_colored_bill / mult;
        if seconds_per_colored_bill < 0.05 {
            seconds_per_colored_bill = 0.05;
        }
    }

    can_use :: method(player: Player) -> bool {
        // Only the owning player (from our parent entity's PlayerBase) may use this press.
        return is_owner_of_parent_base(entity, player);
    }

    on_interact :: method(player: Player) {
        if player == null return;

        // Server-authoritative safety check (in case client-side can_use is bypassed).
        if Game.is_server() && !is_owner_of_parent_base(entity, player) {
            Notifier.notify(player, "This machine belongs to someone else.");
            return;
        }

        // Server authoritative inventory changes + stored counts.
        if !Game.is_server() {
            return;
        }

        // Ensure we don't overwrite an existing save with a default 0.
        server_try_load_from_save();

        taken := 0;
        for i: 1..deposit_per_interact {
            _ := i;
            if !try_take_one_blank_bill(player) {
                break;
            }
            taken += 1;
        }

        if taken <= 0 {
            Notifier.notify(player, "No blank bills to deposit!");
            return;
        }

        stored_blank_bills += taken;
        Notifier.notify(player, "Deposited Blank Bills x%", {taken});

        save_dirty = true;
        server_try_save_to_save(force=true);
    }

    ao_update :: method(dt: float) {
        // Server authoritative conversion + collection.
        if Game.is_server() {
            server_try_load_from_save();
            update_conversion(dt);
            try_auto_collect();
            server_try_save_to_save(force=false);
        }
    }

    // Client-only hook: called immediately after this component's state sync.
    // Used to make the timer bar advance smoothly between syncs.
    ao_on_state_sync :: method() {
        ui_timer_last_sync_time = get_time();
        ui_timer_last_synced_convert_timer = convert_timer;
        ui_timer_inited = true;
    }

    // Server-only: allow a non-player "manager" (e.g., Stamper) to collect colored bills directly
    // from this press' stored output, as long as it belongs to the same PlayerBase owner.
    server_collect_colored_bills_for_manager :: method(requesting_owner_user_id: string, amount: s64) -> s64 {
        if !Game.is_server() {
            return 0;
        }
        if requesting_owner_user_id.count == 0 {
            return 0;
        }
        if amount <= 0 {
            return 0;
        }

        pb := get_parent_player_base(entity);
        if pb == null {
            return 0;
        }
        if pb.owner_user_id.count == 0 {
            return 0;
        }
        if pb.owner_user_id != requesting_owner_user_id {
            return 0;
        }

        server_try_load_from_save();

        if stored_colored_bills <= 0 {
            return 0;
        }

        taken := amount;
        if taken > stored_colored_bills {
            taken = stored_colored_bills;
        }
        if taken <= 0 {
            return 0;
        }

        stored_colored_bills -= taken;
        if stored_colored_bills < 0 {
            stored_colored_bills = 0;
        }
        save_dirty = true;
        return taken;
    }

    // Server-only: allow a non-player "manager" (e.g., Colorist) to deposit blank bills directly
    // into this press' stored input, as long as it belongs to the same PlayerBase owner.
    server_deposit_blank_bills_from_manager :: method(requesting_owner_user_id: string, amount: s64) -> s64 {
        if !Game.is_server() {
            return 0;
        }
        if requesting_owner_user_id.count == 0 {
            return 0;
        }
        if amount <= 0 {
            return 0;
        }

        pb := get_parent_player_base(entity);
        if pb == null {
            return 0;
        }
        if pb.owner_user_id.count == 0 {
            return 0;
        }
        if pb.owner_user_id != requesting_owner_user_id {
            return 0;
        }

        server_try_load_from_save();

        stored_blank_bills += amount;
        if stored_blank_bills < 0 {
            stored_blank_bills = 0;
        }
        save_dirty = true;
        return amount;
    }

    ao_late_update :: method(dt: float) {
        _ := dt;
        draw_world_status();
    }

    update_conversion :: method(dt: float) {
        if stored_blank_bills <= 0 {
            convert_timer = 0;
            return;
        }

        if seconds_per_colored_bill <= 0 {
            seconds_per_colored_bill = 1.0;
        }

        convert_timer += dt;

        // Convert as many as possible this frame (handles hitching).
        did_change: bool = false;
        while true {
            if stored_blank_bills <= 0 break;
            if convert_timer < seconds_per_colored_bill break;

            stored_blank_bills -= 1;
            stored_colored_bills += 1;
            convert_timer -= seconds_per_colored_bill;
            did_change = true;
        }

        if did_change {
            save_dirty = true;
        }
    }

    try_auto_collect :: method() {
        if stored_colored_bills <= 0 {
            return;
        }

        if get_time() - last_collect_time < collect_cooldown {
            return;
        }

        player := find_owner_in_collect_radius();
        if player == null {
            return;
        }

        bills_defn := ItemManager.TryFindItem("colored_bills");
        if bills_defn == null {
            // Back-compat / alternate naming if the project ever used this id.
            bills_defn = ItemManager.TryFindItem("ColoredBills");
        }
        if bills_defn == null {
            log_warning("Colored_Bill_Press: couldn't find Colored Bills item definition", {});
            return;
        }

        inv := player.default_inventory;
        if inv == null || inv.self == null || inv.capacity <= 0 {
            return;
        }

        room := Items.calculate_room_in_inventory_for_item(bills_defn, inv);
        if room <= 0 {
            return;
        }

        // Only ever grant a single stack per collect attempt.
        // (The engine will panic if we try to create a stack larger than the definition's stack size.)
        MAX_STACK :: 64;

        to_give := stored_colored_bills;
        if to_give > room {
            to_give = room;
        }
        if to_give > MAX_STACK {
            to_give = MAX_STACK;
        }
        if to_give <= 0 {
            return;
        }

        // Spawn a magnetized world drop and lock it to this player.
        rng := rng_seed_time();
        for i: 1..to_give {
            _ := i;
            spawn_pos := ItemDrops.random_point_on_circle_edge(player.entity.world_position, loot_spawn_radius, ref rng);
            drop := ItemDrops.spawn_from_definition(spawn_pos, bills_defn, 1);
            if drop != null {
                drop->set_exclusive(player);
            }
        }
        stored_colored_bills -= to_give;
        last_collect_time = get_time();
        save_dirty = true;
    }

    server_try_load_from_save :: method() {
        if !Game.is_server() {
            return;
        }

        pb := get_parent_player_base(entity);
        if pb == null {
            return;
        }

        // Only attempt load once per owner assignment.
        if loaded_from_save && loaded_for_user_id == pb.owner_user_id {
            return;
        }

        owner := pb->get_owner();
        if owner == null {
            return; // owner not connected yet
        }

        lane := lane_index;
        if lane < 0 {
            lane = 0;
        }

        saved_blank := Save.get_int(owner, colored_bill_press_save_key_blank_bills(lane), 0);
        saved_colored := Save.get_int(owner, colored_bill_press_save_key_colored_bills(lane), 0);
        if saved_blank < 0 saved_blank = 0;
        if saved_colored < 0 saved_colored = 0;

        // Don't overwrite non-zero runtime state with an older save (defensive).
        if stored_blank_bills < saved_blank {
            stored_blank_bills = saved_blank;
        }
        if stored_colored_bills < saved_colored {
            stored_colored_bills = saved_colored;
        }
        if stored_blank_bills < 0 stored_blank_bills = 0;
        if stored_colored_bills < 0 stored_colored_bills = 0;

        loaded_from_save = true;
        loaded_for_user_id = pb.owner_user_id;

        // Ensure save reflects the authoritative in-world value.
        if stored_blank_bills != saved_blank {
            Save.set_int(owner, colored_bill_press_save_key_blank_bills(lane), stored_blank_bills);
        }
        if stored_colored_bills != saved_colored {
            Save.set_int(owner, colored_bill_press_save_key_colored_bills(lane), stored_colored_bills);
        }
    }

    server_try_save_to_save :: method(force: bool) {
        if !Game.is_server() {
            return;
        }

        if !force && !save_dirty {
            return;
        }

        pb := get_parent_player_base(entity);
        if pb == null {
            return;
        }
        owner := pb->get_owner();
        if owner == null {
            return;
        }

        // Throttle background saving since conversion ticks can be frequent.
        SAVE_INTERVAL :: 2.0;
        if !force && last_save_time > 0 && get_time() - last_save_time < SAVE_INTERVAL {
            return;
        }

        lane := lane_index;
        if lane < 0 {
            lane = 0;
        }

        if stored_blank_bills < 0 stored_blank_bills = 0;
        if stored_colored_bills < 0 stored_colored_bills = 0;

        Save.set_int(owner, colored_bill_press_save_key_blank_bills(lane), stored_blank_bills);
        Save.set_int(owner, colored_bill_press_save_key_colored_bills(lane), stored_colored_bills);

        last_save_time = get_time();
        save_dirty = false;
    }

    spawn_pickup_text :: method(player: Player, bill_count: s64) {
        if player == null return;
        if player.entity == null return;
        if player.entity.self == null return;
        if bill_count <= 0 return;

        gm := get_game_manager();
        if gm == null {
            return;
        }

        dn := new(DamageNumbers);
        dn.Text = format_string("x% Colored Bills", {bill_count});
        dn.Position = player.entity.world_position + v2{0, 1.75};
        dn.LastPosition = dn.Position;
        dn.Color = {1, 1, 1, 1};
        dn.T = 0.0;
        dn.SpaceText = false;
        dn.DoingFading = false;

        ts := UI.default_text_settings();
        ts.size = 0.35;
        ts.halign = .CENTER;
        ts.valign = .CENTER;
        ts.do_outline = true;
        ts.outline_thickness = 2;
        ts.outline_color = {0, 0, 0, 1};
        ts.color = {1, 1, 1, 1};
        dn.TextSettings = ts;

        gm.damage_numbers->append(dn);
    }

    find_closest_player_in_collect_radius :: method() -> Player {
        // Backwards compat: keep old behavior if something still calls this.
        origin := entity.world_position;
        best: Player;
        best_d2 := collect_radius * collect_radius;

        foreach p: component_iterator(Player) {
            if p == null continue;
            if p.entity == null continue;
            if p.entity.self == null continue;
            if !p.entity->get_world_enabled() continue;

            delta := p.entity.world_position - origin;
            d2 := length_squared(delta);
            if d2 > best_d2 continue;

            best = p;
            best_d2 = d2;
        }

        return best;
    }

    // Only auto-collect for the owning player.
    find_owner_in_collect_radius :: method() -> Player {
        pb := get_parent_player_base(entity);
        if pb == null {
            return null;
        }

        owner := pb->get_owner();
        if owner == null return null;
        if owner.entity == null return null;
        if owner.entity.self == null return null;
        if !owner.entity->get_world_enabled() return null;

        origin := entity.world_position;
        delta := owner.entity.world_position - origin;
        if length_squared(delta) > collect_radius * collect_radius {
            return null;
        }

        return owner;
    }

    try_take_one_blank_bill :: method(player: Player) -> bool {
        if player == null return false;

        inv := player.default_inventory;
        if inv == null return false;
        if inv.self == null return false;
        if inv.capacity <= 0 return false;

        for i: 0..inv.capacity-1 {
            item := inv->get_item(i);
            if item == null continue;
            if item.self == null continue;

            defn := item->get_definition();
            if defn == null continue;

            id := defn->get_id();
            if id == "blank_bills" || id == "BlankBills" {
                // Remove exactly 1 blank bill from this stack (engine will destroy stack if it hits 0).
                Items.destroy_item_instance(item, 1);
                return true;
            }
        }

        return false;
    }

    draw_world_status :: method() {
        UI.push_world_draw_context();
        defer UI.pop_draw_context();

        // Ensure we draw above most sprites nearby.
        UI.push_layer(5);
        defer UI.pop_layer();

        UI.push_z(entity.world_position.y - 0.002);
        defer UI.pop_z();

        pos := entity.world_position + ui_offset;

        // Panel rect in world units (meters).
        // Vertical station UI:
        // - Header: Lv X
        // - Input icon + count
        // - UI/into.png
        // - Timer bar (progress)
        // - Output icon + stored output count
        // Scaled down ~15%
        PANEL_HALF_H :: 0.816;
        PANEL_BG_HALF_W :: 1.037;       // reduced width
        PANEL_CONTENT_HALF_W :: 0.85;   // stable content width (reduced width)

        panel_bg := Rect{pos, pos}->grow(PANEL_HALF_H, PANEL_BG_HALF_W, PANEL_HALF_H, PANEL_BG_HALF_W);
        panel_content := Rect{pos, pos}->grow(PANEL_HALF_H, PANEL_CONTENT_HALF_W, PANEL_HALF_H, PANEL_CONTENT_HALF_W);

        // "Slate" background (tinted quad).
        UI.quad(panel_bg, core_globals.white_sprite, {0.08, 0.09, 0.10, 0.468});

        content := panel_content->inset(0.051);

        gap :: 0.0595;
        into_timer_gap :: 0.0255;
        header_h :: 0.272;
        input_h :: 0.323;
        into_h :: 0.2465;
        timer_h :: 0.136;
        output_h :: 0.323;
        ICON_HALF :: 0.167;

        header := content->cut_top(header_h);
        _ := content->cut_top(gap);
        input_row := content->cut_top(input_h);
        _ := content->cut_top(gap);
        into_row := content->cut_top(into_h);
        _ := content->cut_top(into_timer_gap);
        timer_row := content->cut_top(timer_h);
        _ := content->cut_top(gap);
        output_row := content->cut_top(output_h);

        // Header background strip
        UI.quad(header, core_globals.white_sprite, {0.12, 0.13, 0.15, 0.552});

        ts_header := UI.default_text_settings();
        ts_header.size = 0.391;
        ts_header.halign = .CENTER;
        ts_header.valign = .CENTER;
        ts_header.do_outline = true;
        ts_header.outline_thickness = 3;
        ts_header.outline_color = {0, 0, 0, 1};
        ts_header.color = {1, 1, 1, 1};
        UI.text(header, ts_header, "Lv %", {upgrade_level});

        ts_row := UI.default_text_settings();
        ts_row.size = 0.391;
        ts_row.halign = .CENTER;
        ts_row.valign = .CENTER;
        ts_row.do_outline = true;
        ts_row.outline_thickness = 3;
        ts_row.outline_color = {0, 0, 0, 1};
        ts_row.color = {1, 1, 1, 1};
        ts_row.offset = {0, 0};

        // Input: Blank Bills
        {
            r := input_row->inset(0.017);
            icon_box_w := ICON_HALF * 2 + 0.085;
            icon_box := r->cut_left(icon_box_w);
            icon_rect := icon_box->center_rect()->grow(ICON_HALF);
            text_rect := r;

            #static blank_icon := get_asset(Texture_Asset, "Items/BlankBills.png");
            if blank_icon != null {
                UI.quad(icon_rect->fit_aspect(blank_icon->get_aspect()), blank_icon);
            }
            UI.text(text_rect, ts_row, "x%", {stored_blank_bills});
        }

        // Into arrow
        {
            r := into_row->inset(0.017);
            #static into_icon := get_asset(Texture_Asset, "UI/into.png");
            if into_icon != null {
                icon_rect := r->center_rect()->grow(ICON_HALF);
                UI.quad(icon_rect->fit_aspect(into_icon->get_aspect()), into_icon);
            }
        }

        // Timer bar (progress toward next colored bill)
        {
            bar := timer_row->inset(0.0255);
            UI.quad(bar, core_globals.white_sprite, {0, 0, 0, 0.65});

            timer_val := convert_timer;
            if !Game.is_server() {
                if !ui_timer_inited {
                    ui_timer_last_sync_time = get_time();
                    ui_timer_last_synced_convert_timer = convert_timer;
                    ui_timer_inited = true;
                }

                if stored_blank_bills > 0 && seconds_per_colored_bill > 0 {
                    elapsed := get_time() - ui_timer_last_sync_time;
                    if elapsed < 0 {
                        elapsed = 0;
                    }
                    timer_val = ui_timer_last_synced_convert_timer + elapsed;
                    timer_val = clamp(timer_val, 0.0, seconds_per_colored_bill);
                }
            }

            progress := 0.0;
            if stored_blank_bills > 0 && seconds_per_colored_bill > 0 {
                progress = clamp(timer_val / seconds_per_colored_bill, 0.0, 1.0);
            }
            fill := bar->subrect(0, 0, progress, 1);
            UI.quad(fill, core_globals.white_sprite, {0.2, 0.85, 0.25, 1});
        }

        // Output: Colored Bills
        {
            r := output_row->inset(0.017);
            icon_box_w := ICON_HALF * 2 + 0.085;
            icon_box := r->cut_left(icon_box_w);
            icon_rect := icon_box->center_rect()->grow(ICON_HALF);
            text_rect := r;

            #static colored_icon := get_asset(Texture_Asset, "Items/ColoredBills.png");
            if colored_icon != null {
                UI.quad(icon_rect->fit_aspect(colored_icon->get_aspect()), colored_icon);
            }
            UI.text(text_rect, ts_row, "x%", {stored_colored_bills});
        }
    }
}

