import "core:ao"

// PlayerBase:
// Attach this to a "base" / parent entity in the scene and assign ownership at runtime.
// Child machines (mills/presses) can read the parent PlayerBase to determine who may use them.
//
// Ownership is stored as a user id string (stable + safe to sync), but exposed via helpers that
// work with the Player component type.
PlayerBase :: class : Component {
    owner_user_id: string;

    // Optional: a sprite to tint for ownership feedback.
    // If `sprite_entity` is set in-editor, we resolve the Sprite_Renderer from it.
    // Otherwise we try to use a Sprite_Renderer on this same entity.
    sprite_entity: Entity @ao_serialize;
    sprite_renderer: Sprite_Renderer;

    // Base layout mirroring support:
    // Some child entities need their local Y snapped depending on which player spawn index this base uses.
    // - Players 1/2/3 (spawn 0/1/2): local Y = -5.5
    // - Players 4/5/6 (spawn 3/4/5): local Y =  5.5
    layout_mirror_entities: [5]Entity @ao_serialize;

    // Optional: plot sign UI entity (assigned in PlayerBase prefab).
    // We keep this as an Entity reference so the prefab can point at a child easily.
    plot_sign_entity: Entity @ao_serialize;
    plot_sign: PlotSign;
    plot_sign_base_local_y: float;
    plot_sign_base_local_y_initialized: bool;

    // Assign ownership using a Player.
    set_owner :: method(owner: Player) {
        owner_user_id = {};
        if owner != null {
            owner_user_id = owner.get_user_id();
        }

        // Best-effort: if the owner's spawn index is already assigned, reflect it to the plot sign.
        resolve_plot_sign();
        if plot_sign != null && owner != null {
            if owner.base_spawn_index >= 0 {
                plot_sign.plot_index = owner.base_spawn_index;
            }
        }
    }

    apply_layout_mirror_y_for_spawn_index :: method(spawn_index: s64) {
        target_y := -5.5;
        if spawn_index >= 3 {
            target_y = 7.5;
        }

        for i: 0..layout_mirror_entities.count-1 {
            e := layout_mirror_entities[i];
            if e == null continue;
            if e.self == null continue;

            lp := e.local_position;
            if lp.y == target_y continue;
            lp.y = target_y;
            e.set_local_position(lp);
        }

        // Move PlotSign entity using the same mirroring rule and keep its index in sync.
        resolve_plot_sign();
        if plot_sign != null {
            plot_sign.plot_index = spawn_index;
        }

        if plot_sign_entity != null && plot_sign_entity.self != null {
            // Mirror the sign the same way we do for Truck/Harvester:
            // - Players 1/2/3 (spawn 0/1/2): keep prefab-authored local Y
            // - Players 4/5/6 (spawn 3/4/5): force local Y to 10.0
            if !plot_sign_base_local_y_initialized {
                plot_sign_base_local_y_initialized = true;
                plot_sign_base_local_y = plot_sign_entity.local_position.y;
            }

            desired_y := plot_sign_base_local_y;
            if spawn_index >= 3 {
                desired_y = 10.0;
            }

            lp := plot_sign_entity.local_position;
            if lp.y != desired_y {
                lp.y = desired_y;
                plot_sign_entity.set_local_position(lp);
            }
        }
    }

    ao_start :: method() {
        resolve_sprite_renderer();
        resolve_plot_sign();
    }

    ao_late_update :: method(dt: float) {
        _ := dt;

        // Cosmetic-only: run on clients so we can show per-player ownership colors.
        // If we do this on the server, the color would replicate and all players would see the same tint.
        if Game.is_server() {
            return;
        }

        if sprite_renderer == null {
            resolve_sprite_renderer();
        }
        if sprite_renderer == null {
            return;
        }

        local_player := get_local_player();
        if local_player == null {
            return;
        }

        // Green if this client owns the base, red otherwise.
        if is_owner(local_player) {
            sprite_renderer.color = v4{0, 1, 0.5, 0.4};
        }
        else {
            sprite_renderer.color = v4{1, 0, 0, 0.4};
        }
    }

    // Returns the owning Player component if currently connected; otherwise null.
    get_owner :: method() -> Player {
        if owner_user_id.count == 0 {
            return null;
        }

        foreach p: component_iterator(Player) {
            if p == null continue;
            if p.get_user_id() == owner_user_id {
                return p;
            }
        }
        return null;
    }

    // Checks if the given player is the owner.
    is_owner :: method(player: Player) -> bool {
        if player == null return false;
        if owner_user_id.count == 0 return false;
        return player.get_user_id() == owner_user_id;
    }

    resolve_sprite_renderer :: method() {
        sprite_renderer = null;

        if sprite_entity != null && sprite_entity.self != null {
            sprite_renderer = sprite_entity.get_component(Sprite_Renderer);
        }
        if sprite_renderer == null && entity != null && entity.self != null {
            sprite_renderer = entity.get_component(Sprite_Renderer);
        }
    }

    resolve_plot_sign :: method() {
        plot_sign = null;

        if plot_sign_entity != null && plot_sign_entity.self != null {
            plot_sign = plot_sign_entity.get_component(PlotSign);

            // Cache the prefab-authored local Y once so mirroring is idempotent.
            if !plot_sign_base_local_y_initialized {
                plot_sign_base_local_y_initialized = true;
                plot_sign_base_local_y = plot_sign_entity.local_position.y;
            }
        }

        // Allow attaching PlotSign directly to the base entity as a fallback.
        if plot_sign == null && entity != null && entity.self != null {
            plot_sign = entity.get_component(PlotSign);
        }
    }
}

// Best-effort: find the local player's Player component on this client.
get_local_player :: proc() -> Player {
    foreach p: component_iterator(Player) {
        if p == null continue;

        // On clients, only the local player returns true for is_local_or_server().
        if p.is_local_or_server() {
            return p;
        }
    }
    return null;
}

// Returns the closest PlayerBase component in the parent chain (if any).
get_parent_player_base :: proc(child_entity: Entity) -> PlayerBase {
    if child_entity == null return null;
    if child_entity.self == null return null;

    // NOTE: The "in-world Parent entity" is the entity transform parent.
    // Walk up the chain so prefabs can add intermediate grouping entities (e.g. Lane.prefab)
    // without breaking ownership checks or station upgrade application.
    cur := child_entity.get_parent();
    for step: 0..31 {
        _ := step;
        if cur == null break;
        if cur.self == null break;

        pb := cur.get_component(PlayerBase);
        if pb != null {
            return pb;
        }
        cur = cur.get_parent();
    }

    return null;
}

// Convenience: check if `player` owns the parent base of `child_entity`.
is_owner_of_parent_base :: proc(child_entity: Entity, player: Player) -> bool {
    pb := get_parent_player_base(child_entity);
    if pb == null return false;
    return pb.is_owner(player);
}

// Convenience: check if `player` has at least one item with the given `item_id` in their inventory.
player_has_item_id :: proc(player: Player, item_id: string) -> bool {
    if player == null return false;
    if item_id.count <= 0 return false;

    inv := player.default_inventory;
    if inv == null || inv.self == null || inv.capacity <= 0 {
        return false;
    }

    for i: 0..inv.capacity-1 {
        item := inv.get_item(i);
        if item == null continue;
        if item.self == null continue;
        defn := item.get_definition();
        if defn == null continue;
        if defn.get_id() == item_id {
            return true;
        }
    }

    return false;
}
