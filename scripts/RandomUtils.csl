import "core:ao"

safe_normalize_v2 :: proc(value: v2, fallback: v2) -> v2 {
    if length_squared(value) <= 0.000001 {
        return fallback;
    }
    return normalize(value);
}

make_frame_rng :: proc(salt: u64) -> u64 {
    frame := get_frame_number().(u64);
    return rng_root_seed()
        + (salt + 1) * 6364136223846793005
        + (frame + 1) * 1442695040888963407;
}
