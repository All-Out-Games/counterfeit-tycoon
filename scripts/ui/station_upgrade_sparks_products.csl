blank_bill_press_upgrade_sparks_product_id_for_level :: proc(lane_index: s64, target_level: s64) -> string {
    if lane_index < 0 || lane_index > 3 return "";
    if target_level < 2 || target_level > 10 return "";
    idx := lane_index * 9 + (target_level - 2);
    ids := blank_bill_press_sparks_products();
    if idx < 0 || idx >= ids.count return "";
    return ids[idx];
}

colored_bill_press_upgrade_sparks_product_id_for_level :: proc(lane_index: s64, target_level: s64) -> string {
    if lane_index < 0 || lane_index > 3 return "";
    if target_level < 2 || target_level > 10 return "";
    idx := lane_index * 9 + (target_level - 2);
    ids := colored_bill_press_sparks_products();
    if idx < 0 || idx >= ids.count return "";
    return ids[idx];
}

finished_bill_press_upgrade_sparks_product_id_for_level :: proc(lane_index: s64, target_level: s64) -> string {
    if lane_index < 0 || lane_index > 3 return "";
    if target_level < 2 || target_level > 10 return "";
    idx := lane_index * 9 + (target_level - 2);
    ids := finished_bill_press_sparks_products();
    if idx < 0 || idx >= ids.count return "";
    return ids[idx];
}

blank_bill_press_upgrade_sparks_fallback_price_for_level :: proc(target_level: s64) -> s64 {
    switch target_level {
        case 2:  return 5;
        case 3:  return 5;
        case 4:  return 10;
        case 5:  return 25;
        case 6:  return 50;
        case 7:  return 100;
        case 8:  return 150;
        case 9:  return 200;
        case 10: return 350;
    }
    return 0;
}

colored_bill_press_upgrade_sparks_fallback_price_for_level :: proc(target_level: s64) -> s64 {
    switch target_level {
        case 2:  return 5;
