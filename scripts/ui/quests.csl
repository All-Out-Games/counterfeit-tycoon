import "core:ao"

// =============================================================================
// Quest System
// =============================================================================
// Rolling 3-quest panel. Complete -> Claim -> New quest replaces it.
// Categories: Production, Upgrade, Economy, Expansion, PvP
// 5 tiers that scale with total quests completed.
// All quest state is server-authoritative, stored on the Player, saved per-player.
// =============================================================================

QUEST_COIN_CURRENCY :: "Coins";
QUEST_ACTIVE_COUNT :: 3;
QUEST_MAX_TIER :: 5;

// ---- Categories ----
Quest_Category :: enum {
    PRODUCTION;
    UPGRADE;
    ECONOMY;
    EXPANSION;
    PVP;
}

quest_category_name :: proc(cat: Quest_Category) -> string {
    switch cat {
        case .PRODUCTION: return "PRODUCTION";
        case .UPGRADE:    return "UPGRADE";
        case .ECONOMY:    return "ECONOMY";
        case .EXPANSION:  return "EXPANSION";
        case .PVP:        return "PVP";
    }
    return "QUEST";
}

quest_category_color :: proc(cat: Quest_Category) -> v4 {
    switch cat {
        case .PRODUCTION: return {0.2, 0.8, 0.3, 1};   // Green
        case .UPGRADE:    return {0.3, 0.5, 1.0, 1};    // Blue
        case .ECONOMY:    return {1.0, 0.85, 0.2, 1};   // Yellow
        case .EXPANSION:  return {0.7, 0.3, 0.9, 1};    // Purple
        case .PVP:        return {1.0, 0.25, 0.25, 1};  // Red
    }
    return {1, 1, 1, 1};
}

// ---- Quest tracking types ----
Quest_Track_Type :: enum {
    PRODUCE_FINISHED_BILLS;
    PRODUCE_RAW_PAPER;
    PRODUCE_BLANK_BILLS;
    PRODUCE_COLORED_BILLS;
    FILL_VAULT_PERCENT;         // target = 1 means fill to 25%, etc. (one-shot check)
    UPGRADE_ANY_MACHINE;        // target = level to reach
    UPGRADE_STAMP_MACHINE;      // target = level to reach
    UPGRADE_COLOR_MACHINE;
    UPGRADE_HARVESTER;
    UPGRADE_TRUCK_CAPACITY;
    UPGRADE_TRUCK_HP;
    UPGRADE_TRUCK_SPEED;
    UPGRADE_VAULT;
    UPGRADE_ALL_LANE_TO;        // special: target encodes lane + level
    MAX_ANY_MACHINE;            // any machine reaches level 10
    COMPLETE_BANK_RUNS;
    EARN_TOTAL_COINS;
    FILL_VAULT_TIMES;
    DEPOSIT_COINS_IN_RUN;       // single run deposit
    UNLOCK_LANE;                // target = lane index (1-based)
    HIRE_MANAGERS;              // target = count
    AUTOMATE_LANE;              // target = count of fully automated lanes
    BUY_WEAPON;
    SEND_TRUCK;
    KILL_PLAYERS;
    DEFEND_VAULT;
    ROB_VAULT;
    DESTROY_TRUCK;
    STEAL_COINS_FROM_PLAYERS;   // value in coins stolen via trucks
    RUN_LANES_AT_FULL;          // target = # of lanes running simultaneously
}

// ---- Quest definition (static template) ----
Quest_Def :: struct {
    id: s64;
    title: string;
    category: Quest_Category;
    track_type: Quest_Track_Type;
    target: s64;
    reward: s64;
    tier: s64;
}

// ---- Active quest instance (per-player runtime state) ----
Quest_Instance :: struct {
    def_id: s64;       // index into quest pool
    progress: s64;      // current progress toward target
    completed: bool;    // ready to claim
    claimed: bool;      // already claimed (slot is free)
    is_challenge: bool; // 2x reward, harder target
}

// =============================================================================
// Quest Pool — All quest definitions across 5 tiers
// =============================================================================

// We define quest pool as a large flat array. Each quest has a unique id.
// The quest pool is built once (lazily) and cached in a #static.

QUEST_POOL_COUNT :: 76;

get_quest_pool :: proc() -> [QUEST_POOL_COUNT]Quest_Def {
    #static pool: [QUEST_POOL_COUNT]Quest_Def;
    #static initialized: bool;
    if initialized return pool;
    initialized = true;

    i := 0;

    // ---- TIER 1: Starter (quests 1-10) ----
    // Titles use % as placeholder for the target number (rendered via quest_get_display_title).
    // Quests without a number in the title use a plain string (no %).
    pool[i] = {i, "Produce % Finished Bills",       .PRODUCTION, .PRODUCE_FINISHED_BILLS,  5,    200,  1}; i += 1;
    pool[i] = {i, "Produce % Finished Bills",       .PRODUCTION, .PRODUCE_FINISHED_BILLS,  20,   400,  1}; i += 1;
    pool[i] = {i, "Produce % Raw Paper",            .PRODUCTION, .PRODUCE_RAW_PAPER,       50,   150,  1}; i += 1;
    pool[i] = {i, "Fill your Piggy Bank to %0%%",    .PRODUCTION, .FILL_VAULT_PERCENT,      25,   350,  1}; i += 1;
    pool[i] = {i, "Upgrade any machine to Lv %",    .UPGRADE,    .UPGRADE_ANY_MACHINE,     2,    250,  1}; i += 1;
    pool[i] = {i, "Upgrade your Stamp Machine",     .UPGRADE,    .UPGRADE_STAMP_MACHINE,   2,    300,  1}; i += 1;
    pool[i] = {i, "Upgrade your Harvester",         .UPGRADE,    .UPGRADE_HARVESTER,       2,    250,  1}; i += 1;
    pool[i] = {i, "Complete % bank run",            .ECONOMY,    .COMPLETE_BANK_RUNS,      1,    500,  1}; i += 1;
    pool[i] = {i, "Earn $% total",                  .ECONOMY,    .EARN_TOTAL_COINS,        1000, 400,  1}; i += 1;
    pool[i] = {i, "Hire % manager",                 .EXPANSION,  .HIRE_MANAGERS,            1,    350,  1}; i += 1;
    pool[i] = {i, "Buy any weapon",                 .EXPANSION,  .BUY_WEAPON,               1,    250,  1}; i += 1;
    pool[i] = {i, "Send your truck to the bank",    .ECONOMY,    .SEND_TRUCK,               1,    300,  1}; i += 1;

    // ---- TIER 2: Early (quests 11-30) ----
    pool[i] = {i, "Produce % Finished Bills",       .PRODUCTION, .PRODUCE_FINISHED_BILLS,  100,  1200, 2}; i += 1;
    pool[i] = {i, "Produce % Finished Bills",       .PRODUCTION, .PRODUCE_FINISHED_BILLS,  250,  2000, 2}; i += 1;
    pool[i] = {i, "Produce % Raw Paper",            .PRODUCTION, .PRODUCE_RAW_PAPER,       500,  800,  2}; i += 1;
    pool[i] = {i, "Produce % Blank Bills",          .PRODUCTION, .PRODUCE_BLANK_BILLS,     200,  1000, 2}; i += 1;
    pool[i] = {i, "Upgrade any machine to Lv %",    .UPGRADE,    .UPGRADE_ANY_MACHINE,     4,    1500, 2}; i += 1;
    pool[i] = {i, "Upgrade Stamp to Lv %",          .UPGRADE,    .UPGRADE_STAMP_MACHINE,   3,    1200, 2}; i += 1;
    pool[i] = {i, "Upgrade Color Machine to Lv %",  .UPGRADE,    .UPGRADE_COLOR_MACHINE,   3,    1000, 2}; i += 1;
    pool[i] = {i, "Upgrade Truck Capacity",         .UPGRADE,    .UPGRADE_TRUCK_CAPACITY,  2,    800,  2}; i += 1;
    pool[i] = {i, "Upgrade Harvester to Lv %",      .UPGRADE,    .UPGRADE_HARVESTER,       3,    600,  2}; i += 1;
    pool[i] = {i, "Complete % bank runs",           .ECONOMY,    .COMPLETE_BANK_RUNS,      5,    2500, 2}; i += 1;
    pool[i] = {i, "Earn $% total",                  .ECONOMY,    .EARN_TOTAL_COINS,        5000, 2000, 2}; i += 1;
    pool[i] = {i, "Fill your Piggy Bank % times",    .ECONOMY,    .FILL_VAULT_TIMES,        3,    1800, 2}; i += 1;
    pool[i] = {i, "Deposit $% at the bank",         .ECONOMY,    .DEPOSIT_COINS_IN_RUN,    3000, 1500, 2}; i += 1;
    pool[i] = {i, "Unlock Lane %",                  .EXPANSION,  .UNLOCK_LANE,             2,    1500, 2}; i += 1;
    pool[i] = {i, "Hire % managers",                .EXPANSION,  .HIRE_MANAGERS,            3,    2000, 2}; i += 1;
    pool[i] = {i, "Fully automate Lane %",          .EXPANSION,  .AUTOMATE_LANE,            1,    2500, 2}; i += 1;
    pool[i] = {i, "Upgrade Piggy Bank to Lv %",      .UPGRADE,    .UPGRADE_VAULT,           3,    1000, 2}; i += 1;
    pool[i] = {i, "Kill % player",                  .PVP,        .KILL_PLAYERS,             1,    1200, 2}; i += 1;
    pool[i] = {i, "Defend your Piggy Bank",          .PVP,        .DEFEND_VAULT,             1,    1800, 2}; i += 1;

    // ---- TIER 3: Mid (quests 31-60) ----
    pool[i] = {i, "Produce % Finished Bills",       .PRODUCTION, .PRODUCE_FINISHED_BILLS,  1000,  8000,  3}; i += 1;
    pool[i] = {i, "Produce % Finished Bills",       .PRODUCTION, .PRODUCE_FINISHED_BILLS,  2500,  12000, 3}; i += 1;
    pool[i] = {i, "Produce % Colored Bills",        .PRODUCTION, .PRODUCE_COLORED_BILLS,   5000,  6000,  3}; i += 1;
    pool[i] = {i, "Run % lanes at full speed",      .PRODUCTION, .RUN_LANES_AT_FULL,       2,     10000, 3}; i += 1;
    pool[i] = {i, "Upgrade any machine to Lv %",    .UPGRADE,    .UPGRADE_ANY_MACHINE,     6,     8000,  3}; i += 1;
    pool[i] = {i, "Upgrade Stamp to Lv %",          .UPGRADE,    .UPGRADE_STAMP_MACHINE,   5,     5000,  3}; i += 1;
    pool[i] = {i, "Upgrade Piggy Bank to Lv %",     .UPGRADE,    .UPGRADE_VAULT,           5,     12000, 3}; i += 1;
    pool[i] = {i, "Upgrade Piggy Bank to Lv %",     .UPGRADE,    .UPGRADE_VAULT,           7,     15000, 3}; i += 1;
    pool[i] = {i, "Complete % bank runs",           .ECONOMY,    .COMPLETE_BANK_RUNS,      15,    15000, 3}; i += 1;
    pool[i] = {i, "Earn $% total",                  .ECONOMY,    .EARN_TOTAL_COINS,        50000, 10000, 3}; i += 1;
    pool[i] = {i, "Deposit $% in one run",          .ECONOMY,    .DEPOSIT_COINS_IN_RUN,    25000, 8000,  3}; i += 1;
    pool[i] = {i, "Unlock Lane %",                  .EXPANSION,  .UNLOCK_LANE,             3,     8000,  3}; i += 1;
    pool[i] = {i, "Unlock Lane %",                  .EXPANSION,  .UNLOCK_LANE,             4,     15000, 3}; i += 1;
    pool[i] = {i, "Automate % lanes",               .EXPANSION,  .AUTOMATE_LANE,            2,     10000, 3}; i += 1;
    pool[i] = {i, "Rob % Piggy Bank",               .PVP,        .ROB_VAULT,                1,     8000,  3}; i += 1;
    pool[i] = {i, "Destroy % enemy truck",          .PVP,        .DESTROY_TRUCK,            1,     12000, 3}; i += 1;
    pool[i] = {i, "Kill % players",                 .PVP,        .KILL_PLAYERS,             5,     10000, 3}; i += 1;

    // ---- TIER 4: Late (quests 61-100) ----
    pool[i] = {i, "Produce % Finished Bills",       .PRODUCTION, .PRODUCE_FINISHED_BILLS,  10000,  40000, 4}; i += 1;
    pool[i] = {i, "Produce % Finished Bills",       .PRODUCTION, .PRODUCE_FINISHED_BILLS,  25000,  60000, 4}; i += 1;
    pool[i] = {i, "Run % lanes simultaneously",     .PRODUCTION, .RUN_LANES_AT_FULL,       4,      35000, 4}; i += 1;
    pool[i] = {i, "Max any machine (Lv %)",         .UPGRADE,    .MAX_ANY_MACHINE,         10,     50000, 4}; i += 1;
    pool[i] = {i, "Upgrade Piggy Bank to Lv %",     .UPGRADE,    .UPGRADE_VAULT,           8,      45000, 4}; i += 1;
    pool[i] = {i, "Complete % bank runs",           .ECONOMY,    .COMPLETE_BANK_RUNS,      50,     50000, 4}; i += 1;
    pool[i] = {i, "Earn $% total",                  .ECONOMY,    .EARN_TOTAL_COINS,        500000, 75000, 4}; i += 1;
    pool[i] = {i, "Deposit $% in one run",          .ECONOMY,    .DEPOSIT_COINS_IN_RUN,    100000, 40000, 4}; i += 1;
    pool[i] = {i, "Fully automate % lanes",         .EXPANSION,  .AUTOMATE_LANE,            3,      60000, 4}; i += 1;
    pool[i] = {i, "Destroy % enemy trucks",         .PVP,        .DESTROY_TRUCK,            10,     45000, 4}; i += 1;
    pool[i] = {i, "Rob % Piggy Banks",              .PVP,        .ROB_VAULT,                5,      35000, 4}; i += 1;
    pool[i] = {i, "Kill % players",                 .PVP,        .KILL_PLAYERS,             25,     50000, 4}; i += 1;

    // ---- TIER 5: Endgame (quests 100+) ----
    pool[i] = {i, "Produce % Finished Bills",       .PRODUCTION, .PRODUCE_FINISHED_BILLS,  100000,  150000, 5}; i += 1;
    pool[i] = {i, "Max all machines in any lane",   .UPGRADE,    .MAX_ANY_MACHINE,         10,      175000, 5}; i += 1;
    pool[i] = {i, "Max your Piggy Bank (Lv %)",     .UPGRADE,    .UPGRADE_VAULT,           12,      250000, 5}; i += 1;
    pool[i] = {i, "Max your Harvester",             .UPGRADE,    .UPGRADE_HARVESTER,       10,      125000, 5}; i += 1;
    pool[i] = {i, "Earn $% total",                  .ECONOMY,    .EARN_TOTAL_COINS,        5000000, 300000, 5}; i += 1;
    pool[i] = {i, "Complete % bank runs",           .ECONOMY,    .COMPLETE_BANK_RUNS,      200,     275000, 5}; i += 1;
    pool[i] = {i, "Destroy % enemy trucks",         .PVP,        .DESTROY_TRUCK,            50,      175000, 5}; i += 1;
    pool[i] = {i, "Rob % Piggy Banks",              .PVP,        .ROB_VAULT,                25,      125000, 5}; i += 1;
    pool[i] = {i, "Kill % players",                 .PVP,        .KILL_PLAYERS,             100,     225000, 5}; i += 1;

    return pool;
}

// Build the display title for a quest, substituting the actual target into the
// format-string title. Titles that contain % get the comma-formatted target
// inserted; titles without % (e.g. "Buy any weapon") are returned as-is.
quest_get_display_title :: proc(def: Quest_Def, target: s64) -> string {
    has_placeholder := false;
    for i: 0..def.title.count-1 {
        if def.title[i] == '%' {
            has_placeholder = true;
            break;
        }
    }
    if !has_placeholder return def.title;
    return format_string(def.title, {format_int_with_commas(target)});
}

// =============================================================================
// Tier logic
// =============================================================================
quest_tier_for_completed_count :: proc(count: s64) -> s64 {
    if count >= 100 return 5;
    if count >= 60  return 4;
    if count >= 30  return 3;
    if count >= 10  return 2;
    return 1;
}

quest_tier_name :: proc(tier: s64) -> string {
    switch tier {
        case 1: return "Starter";
        case 2: return "Early";
        case 3: return "Mid";
        case 4: return "Late";
        case 5: return "Endgame";
    }
    return "Starter";
}

quest_tier_quest_range :: proc(tier: s64) -> string {
    switch tier {
        case 1: return "1-10";
        case 2: return "11-30";
        case 3: return "31-60";
        case 4: return "61-100";
        case 5: return "100+";
    }
    return "1-10";
}

// =============================================================================
// Quest Selection — pick a new quest for a slot
// =============================================================================
quest_pick_new :: proc(player: Player, slot: s64) {
    if player == null return;
    if !Game.is_server() return;
    if slot < 0 || slot >= QUEST_ACTIVE_COUNT return;

    pool := get_quest_pool();
    tier := quest_tier_for_completed_count(player.quests_completed);

    // Gather categories already used by other active slots.
    used_cats: [5]bool; // indexed by category enum
    for s: 0..QUEST_ACTIVE_COUNT-1 {
        if s == slot continue;
        q := player.quest_slots[s];
        if q.def_id < 0 continue;
        if q.claimed continue;
        if q.def_id >= QUEST_POOL_COUNT continue;
        cat_idx := pool[q.def_id].category.(s64);
        if cat_idx >= 0 && cat_idx < 5 {
            used_cats[cat_idx] = true;
        }
    }

    // Also gather def_ids already active (to avoid duplicates).
    active_ids: [3]s64;
    for s: 0..QUEST_ACTIVE_COUNT-1 {
        if s == slot {
            active_ids[s] = -1;
        } else {
            active_ids[s] = player.quest_slots[s].def_id;
        }
    }

    // Collect candidates from current tier.
    candidates: [..]s64;
    for q: 0..QUEST_POOL_COUNT-1 {
        def := pool[q];
        if def.tier != tier continue;

        // No PvP in tier 1.
        if tier < 2 && def.category == .PVP continue;

        // No duplicate categories.
        cat_idx := def.category.(s64);
        if cat_idx >= 0 && cat_idx < 5 {
            if used_cats[cat_idx] continue;
        }

        // No duplicate quest defs.
        dupe := false;
        for s: 0..QUEST_ACTIVE_COUNT-1 {
            if active_ids[s] == q {
                dupe = true;
            }
        }
        if dupe continue;

        candidates.append(q);
    }

    // If no candidates found (pool exhausted for tier), try any tier quest.
    if candidates.count == 0 {
        for q: 0..QUEST_POOL_COUNT-1 {
            def := pool[q];
            if def.tier > tier continue;

            cat_idx := def.category.(s64);
            if cat_idx >= 0 && cat_idx < 5 {
                if used_cats[cat_idx] continue;
            }

            dupe := false;
            for s: 0..QUEST_ACTIVE_COUNT-1 {
                if active_ids[s] == q {
                    dupe = true;
                }
            }
            if dupe continue;

            candidates.append(q);
        }
    }

    if candidates.count == 0 {
        // Absolute fallback: just pick any quest from current tier, ignore category constraint.
        for q: 0..QUEST_POOL_COUNT-1 {
            if pool[q].tier == tier {
                candidates.append(q);
                break;
            }
        }
    }

    if candidates.count == 0 return;

    // Random pick.
    rng: u64 = make_frame_rng(player.entity.id + 341);
    pick_idx := rng_range_int(ref rng, 0, candidates.count - 1);
    chosen_id := candidates[pick_idx];

    // 10% chance for challenge variant (2x target and reward).
    is_challenge := rng_range_int(ref rng, 1, 10) == 1;

    inst: Quest_Instance;
    inst.def_id = chosen_id;
    inst.progress = 0;
    inst.completed = false;
    inst.claimed = false;
    inst.is_challenge = is_challenge;

    player.quest_slots[slot] = inst;

    // Check if already satisfied (e.g. "upgrade any machine to lv 2" when already lv 5).
    quest_check_instant_completion(player, slot);
}

// =============================================================================
// Quest progress tracking
// =============================================================================
quest_get_target :: proc(player: Player, slot: s64) -> s64 {
    if player == null return 1;
    if slot < 0 || slot >= QUEST_ACTIVE_COUNT return 1;
    q := player.quest_slots[slot];
    if q.def_id < 0 || q.def_id >= QUEST_POOL_COUNT return 1;
    pool := get_quest_pool();
    t := pool[q.def_id].target;
    if q.is_challenge {
        t = t * 2;
    }
    if t < 1 t = 1;
    return t;
}

quest_get_reward :: proc(player: Player, slot: s64) -> s64 {
    if player == null return 0;
    if slot < 0 || slot >= QUEST_ACTIVE_COUNT return 0;
    q := player.quest_slots[slot];
    if q.def_id < 0 || q.def_id >= QUEST_POOL_COUNT return 0;
    pool := get_quest_pool();
    r := pool[q.def_id].reward;
    if q.is_challenge {
        r = r * 2;
    }
    return r;
}

// Increment progress on a quest slot and check completion.
quest_add_progress :: proc(player: Player, slot: s64, amount: s64) {
    if player == null return;
    if !Game.is_server() return;
    if slot < 0 || slot >= QUEST_ACTIVE_COUNT return;

    q := player.quest_slots[slot];
    if q.def_id < 0 return;
    if q.completed return;
    if q.claimed return;

    q.progress += amount;
    target := quest_get_target(player, slot);
    if q.progress >= target {
        q.progress = target;
        q.completed = true;
    }
    player.quest_slots[slot] = q;
}

// Set progress to an absolute value (used for "check current state" quests).
quest_set_progress :: proc(player: Player, slot: s64, value: s64) {
    if player == null return;
    if !Game.is_server() return;
    if slot < 0 || slot >= QUEST_ACTIVE_COUNT return;

    q := player.quest_slots[slot];
    if q.def_id < 0 return;
    if q.completed return;
    if q.claimed return;

    q.progress = value;
    target := quest_get_target(player, slot);
    if q.progress >= target {
        q.progress = target;
        q.completed = true;
    }
    player.quest_slots[slot] = q;
}

// Check if a quest is instantly satisfied based on current game state.
quest_check_instant_completion :: proc(player: Player, slot: s64) {
    if player == null return;
    if !Game.is_server() return;
    if slot < 0 || slot >= QUEST_ACTIVE_COUNT return;
    q := player.quest_slots[slot];
    if q.def_id < 0 return;
    if q.completed return;

    pool := get_quest_pool();
    def := pool[q.def_id];

    switch def.track_type {
        case .UPGRADE_ANY_MACHINE: {
            // Check all station levels.
            max_lvl: s64 = 0;
            for i: 0..15 {
                lvl := player.station_upgrade_levels[i];
                if lvl > max_lvl { max_lvl = lvl; }
            }
            quest_set_progress(player, slot, max_lvl);
        }
        case .UPGRADE_STAMP_MACHINE: {
            max_lvl: s64 = 0;
            for lane: 0..3 {
                lvl := get_player_station_level(player, lane, .STAMP_MACHINE);
                if lvl > max_lvl { max_lvl = lvl; }
            }
            quest_set_progress(player, slot, max_lvl);
        }
        case .UPGRADE_COLOR_MACHINE: {
            max_lvl: s64 = 0;
            for lane: 0..3 {
                lvl := get_player_station_level(player, lane, .COLOR_MACHINE);
                if lvl > max_lvl { max_lvl = lvl; }
            }
            quest_set_progress(player, slot, max_lvl);
        }
        case .UPGRADE_HARVESTER: {
            quest_set_progress(player, slot, player.harvester_level);
        }
        case .UPGRADE_TRUCK_CAPACITY: {
            quest_set_progress(player, slot, player.truck_upgrade_levels[0]);
        }
        case .UPGRADE_TRUCK_HP: {
            quest_set_progress(player, slot, player.truck_upgrade_levels[1]);
        }
        case .UPGRADE_TRUCK_SPEED: {
            quest_set_progress(player, slot, player.truck_upgrade_levels[2]);
        }
        case .UPGRADE_VAULT: {
            quest_set_progress(player, slot, player.vault_level);
        }
        case .MAX_ANY_MACHINE: {
            max_lvl: s64 = 0;
            for i: 0..15 {
                lvl := player.station_upgrade_levels[i];
                if lvl > max_lvl { max_lvl = lvl; }
            }
            quest_set_progress(player, slot, max_lvl);
        }
        case .UNLOCK_LANE: {
            // target is 1-based lane number. Check if unlocked.
            target := quest_get_target(player, slot);
            lane_idx := target - 1;
            if lanes_is_unlocked(player, lane_idx) {
                quest_set_progress(player, slot, target);
            }
        }
        case .EARN_TOTAL_COINS: {
            quest_set_progress(player, slot, player.quest_stat_total_earned);
        }
        case .AUTOMATE_LANE: {
            // Count how many lanes are fully automated (all 4 managers unlocked).
            ALL_MANAGERS_MASK :: 15; // bits 1+2+4+8
            count: s64 = 0;
            for lane: 0..MANAGERS_LANE_COUNT-1 {
                if lanes_is_unlocked(player, lane) && player.managers_lane_masks[lane] == ALL_MANAGERS_MASK {
                    count += 1;
                }
            }
            quest_set_progress(player, slot, count);
        }
        case .RUN_LANES_AT_FULL: {
            // Count how many lanes have all 4 stations at max level.
            count: s64 = 0;
            for lane: 0..UPGRADES_LANE_COUNT-1 {
                if !lanes_is_unlocked(player, lane) continue;
                all_max := true;
                for st: 0..UPGRADES_STATION_COUNT-1 {
                    kind := station_kind_from_index(st);
                    lvl := get_player_station_level(player, lane, kind);
                    if lvl < UPGRADES_MAX_LEVEL {
                        all_max = false;
                    }
                }
                if all_max {
                    count += 1;
                }
            }
            quest_set_progress(player, slot, count);
        }
    }
}

// =============================================================================
// Quest Event Hooks — called from game systems
// =============================================================================

// Called when a machine produces an output item.
quest_on_produce :: proc(player: Player, track_type: Quest_Track_Type, amount: s64) {
    if player == null return;
    if !Game.is_server() return;

    pool := get_quest_pool();
    for s: 0..QUEST_ACTIVE_COUNT-1 {
        q := player.quest_slots[s];
        if q.def_id < 0 continue;
        if q.completed continue;
        if q.claimed continue;
        if q.def_id >= QUEST_POOL_COUNT continue;
        if pool[q.def_id].track_type == track_type {
            quest_add_progress(player, s, amount);
        }
    }
}

// Called on upgrade events (machine, harvester, truck, vault).
quest_on_upgrade :: proc(player: Player) {
    if player == null return;
    if !Game.is_server() return;

    pool := get_quest_pool();
    for s: 0..QUEST_ACTIVE_COUNT-1 {
        q := player.quest_slots[s];
        if q.def_id < 0 continue;
        if q.completed continue;
        if q.claimed continue;
        if q.def_id >= QUEST_POOL_COUNT continue;
        quest_check_instant_completion(player, s);
    }
}

// Called when a bank run completes.
quest_on_bank_run :: proc(player: Player, coins_deposited: s64) {
    if player == null return;
    if !Game.is_server() return;

    player.quest_stat_bank_runs += 1;
    player.quest_stat_total_earned += coins_deposited;
    Save.set_int(player, "quest_stat_bank_runs", player.quest_stat_bank_runs);
    Save.set_int(player, "quest_stat_total_earned", player.quest_stat_total_earned);

    pool := get_quest_pool();
    for s: 0..QUEST_ACTIVE_COUNT-1 {
        q := player.quest_slots[s];
        if q.def_id < 0 continue;
        if q.completed continue;
        if q.claimed continue;
        if q.def_id >= QUEST_POOL_COUNT continue;
        def := pool[q.def_id];
        switch def.track_type {
            case .COMPLETE_BANK_RUNS: {
                quest_add_progress(player, s, 1);
            }
            case .EARN_TOTAL_COINS: {
                quest_set_progress(player, s, player.quest_stat_total_earned);
            }
            case .DEPOSIT_COINS_IN_RUN: {
                // Single-run deposit check.
                if coins_deposited >= quest_get_target(player, s) {
                    quest_set_progress(player, s, quest_get_target(player, s));
                }
            }
            case .SEND_TRUCK: {
                quest_add_progress(player, s, 1);
            }
        }
    }
}

// Called when a lane is unlocked.
quest_on_lane_unlock :: proc(player: Player, lane_index: s64) {
    if player == null return;
    if !Game.is_server() return;

    pool := get_quest_pool();
    for s: 0..QUEST_ACTIVE_COUNT-1 {
        q := player.quest_slots[s];
        if q.def_id < 0 continue;
        if q.completed continue;
        if q.claimed continue;
        if q.def_id >= QUEST_POOL_COUNT continue;
        def := pool[q.def_id];
        if def.track_type == .UNLOCK_LANE {
            target_lane := quest_get_target(player, s);
            if (lane_index + 1) >= target_lane {
                quest_set_progress(player, s, target_lane);
            }
        }
    }
}

// Called when a manager is hired.
quest_on_manager_hired :: proc(player: Player) {
    if player == null return;
    if !Game.is_server() return;

    player.quest_stat_managers_hired += 1;
    Save.set_int(player, "quest_stat_managers_hired", player.quest_stat_managers_hired);

    pool := get_quest_pool();
    for s: 0..QUEST_ACTIVE_COUNT-1 {
