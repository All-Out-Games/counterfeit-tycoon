// Called when vault fill percent changes (check fill_vault_percent quests).
quest_on_vault_deposit :: proc(player: Player) {
    if player == null return;
    if !Game.is_server() return;

    // Find player's vault.
    fill_pct: s64 = 0;
    for v: component_iterator(Vault) {
        if v == null continue;
        if v.entity == null || !#alive(v.entity) continue;
        if !is_owner_of_parent_base(v.entity, player) continue;
        if v.max_capacity > 0 {
            fill_pct = (v.stored_finished_bills * 100) / v.max_capacity;
        }
        break;
    }

    pool := get_quest_pool();
    for s: 0..QUEST_ACTIVE_COUNT-1 {
        q := player.quest_slots[s];
        if q.def_id < 0 continue;
        if q.completed continue;
        if q.claimed continue;
        if q.def_id >= QUEST_POOL_COUNT continue;
        def := pool[q.def_id];
        if def.track_type == .FILL_VAULT_PERCENT {
            if fill_pct >= quest_get_target(player, s) {
                quest_set_progress(player, s, quest_get_target(player, s));
            }
        }
        if def.track_type == .FILL_VAULT_TIMES {
            if fill_pct >= 95 {
                quest_add_progress(player, s, 1);
            }
        }
    }
}

// =============================================================================
// Quest Claim — player presses claim button
// =============================================================================
server_quest_claim :: proc(player: Player, slot: s64) {
    if player == null return;
    if !Game.is_server() return;
    if slot < 0 || slot >= QUEST_ACTIVE_COUNT return;

    q := player.quest_slots[slot];
    if q.def_id < 0 return;
    if !q.completed return;
    if q.claimed return;

    reward := quest_get_reward(player, slot);
    Economy.deposit_currency(player, QUEST_COIN_CURRENCY, reward);

    q.claimed = true;
    player.quest_slots[slot] = q;
    player.quests_completed += 1;
    player.quest_rewards_earned += reward;

    Save.set_int(player, "quests_completed", player.quests_completed);
    Save.set_int(player, "quest_rewards_earned", player.quest_rewards_earned);

    // Show reward notification.
    //Notifier.notify(player, "+$% Quest Reward!", {format_int_with_commas(reward)});

    // Pick a new quest for this slot.
    quest_pick_new(player, slot);

    // Save active quests.
    quest_save_active(player);
}

// =============================================================================
// Quest Save/Load
// =============================================================================
quest_save_active :: proc(player: Player) {
    if player == null return;
    if !Game.is_server() return;

    for s: 0..QUEST_ACTIVE_COUNT-1 {
        q := player.quest_slots[s];
        prefix := format_string("quest_%", {s});
        Save.set_int(player, format_string("%_def_id", {prefix}), q.def_id);
        Save.set_int(player, format_string("%_progress", {prefix}), q.progress);
        Save.set_int(player, format_string("%_completed", {prefix}), q.completed ? 1 : 0);
        Save.set_int(player, format_string("%_challenge", {prefix}), q.is_challenge ? 1 : 0);
    }
}

quest_load_active :: proc(player: Player) {
    if player == null return;
    if !Game.is_server() return;

    player.quests_completed = Save.get_int(player, "quests_completed", 0);
    player.quest_rewards_earned = Save.get_int(player, "quest_rewards_earned", 0);

    // Load cumulative stats.
    player.quest_stat_bank_runs = Save.get_int(player, "quest_stat_bank_runs", 0);
    player.quest_stat_total_earned = Save.get_int(player, "quest_stat_total_earned", 0);
    player.quest_stat_managers_hired = Save.get_int(player, "quest_stat_managers_hired", 0);
    player.quest_stat_pvp_kills = Save.get_int(player, "quest_stat_pvp_kills", 0);
    player.quest_stat_trucks_destroyed = Save.get_int(player, "quest_stat_trucks_destroyed", 0);
    player.quest_stat_vaults_robbed = Save.get_int(player, "quest_stat_vaults_robbed", 0);
    player.quest_stat_vault_defended = Save.get_int(player, "quest_stat_vault_defended", 0);

    any_loaded := false;
    for s: 0..QUEST_ACTIVE_COUNT-1 {
        prefix := format_string("quest_%", {s});
        def_id := Save.get_int(player, format_string("%_def_id", {prefix}), -1);
        if def_id >= 0 && def_id < QUEST_POOL_COUNT {
            q: Quest_Instance;
            q.def_id = def_id;
            q.progress = Save.get_int(player, format_string("%_progress", {prefix}), 0);
            q.completed = Save.get_int(player, format_string("%_completed", {prefix}), 0) != 0;
            q.claimed = false;
            q.is_challenge = Save.get_int(player, format_string("%_challenge", {prefix}), 0) != 0;
            player.quest_slots[s] = q;
            any_loaded = true;
        } else {
            player.quest_slots[s].def_id = -1;
        }
    }

    if !any_loaded {
        // First time: populate all 3 slots.
        for s: 0..QUEST_ACTIVE_COUNT-1 {
            quest_pick_new(player, s);
        }
        quest_save_active(player);
    } else {
        // Re-check any empty slots.
        for s: 0..QUEST_ACTIVE_COUNT-1 {
            if player.quest_slots[s].def_id < 0 {
                quest_pick_new(player, s);
            }
        }
        // Re-evaluate instant-completion quests (player may have progressed offline).
        for s: 0..QUEST_ACTIVE_COUNT-1 {
            if !player.quest_slots[s].completed {
                quest_check_instant_completion(player, s);
            }
        }
        quest_save_active(player);
    }
}

// =============================================================================
// Quest UI — Always-visible top-center horizontal bar with 3 quest cards
// Styled like clean white card boxes with title, progress, and coin reward.
// =============================================================================

draw_quests_ui :: proc(player: Player) {
    if player == null return;
    if !player.is_local_or_server() return;
    // Gate quest UI until tutorial completion (step 11 = "Tutorial Complete").
    if player.tutorial_step < 11 return;

    UI.push_screen_draw_context();
    defer UI.pop_draw_context();

    UI.push_layer(100);
    defer UI.pop_layer();

    safe := UI.get_safe_screen_rect();

    // Padding from the top of the screen.
    _ := safe.cut_top(20);

    // Top-center strip: half the old width (40% of screen), 50% taller (120px).
    top_strip := safe.cut_top(120).inset(0, 6, 0, 6);
    bar := top_strip.subrect(0.30, 0, 0.70, 1);

    // 3 equal cards side-by-side.
    THIRD :: 0.3333;
    for s: 0..QUEST_ACTIVE_COUNT-1 {
        UI.push_id("quest_card_%", {s});
        defer UI.pop_id();

        x1 := THIRD * s.(float);
        x2 := x1 + THIRD;
        card_rect := bar.subrect(x1, 0, x2, 1).inset(2, 4, 2, 4);
        draw_quest_card(player, card_rect, s);
    }
}

draw_quest_card :: proc(player: Player, rect: Rect, slot: s64) {
    if slot < 0 || slot >= QUEST_ACTIVE_COUNT return;
    q := player.quest_slots[slot];
    if q.def_id < 0 || q.def_id >= QUEST_POOL_COUNT return;

    pool := get_quest_pool();
    def := pool[q.def_id];
    target := quest_get_target(player, slot);
    reward := quest_get_reward(player, slot);

    bold_font := get_asset(Font_Asset, "$AO/fonts/Barlow-Black.ttf");

    // ---- Card background (white rounded button sprite) ----
    card_bg := get_asset(Texture_Asset, "$AO/new/modal/buttons_2/button_9.png");
    if q.completed && !q.claimed {
        UI.quad(rect, card_bg, {0.7, 1.0, 0.75, 0.97});
    } else {
        UI.quad(rect, card_bg, {1, 1, 1, 0.97});
    }

    inner := rect.inset(10, 12, 10, 12);

    // Split: left content | right reward column.
    reward_area := inner.cut_right(56);
    _ := inner.cut_right(6); // gap between content and reward
    content := inner;

    // ---- Left: Title ----
    title_row := content.cut_top(34);
    ts_title := UI.default_text_settings();
    ts_title.size = 22;
    ts_title.halign = .LEFT;
    ts_title.valign = .CENTER;
    ts_title.color = {1, 1, 1, 1};
    ts_title.do_outline = false;
    ts_title.word_wrap = true;
    ts_title.font = bold_font;
    UI.text(title_row, ts_title, quest_get_display_title(def, target));

    _ := content.cut_top(4);

    // ---- Left: "Progress:" label ----
    label_row := content.cut_top(22);
    ts_label := UI.default_text_settings();
    ts_label.size = 18;
    ts_label.halign = .LEFT;
    ts_label.valign = .CENTER;
    ts_label.color = {0.4, 0.4, 0.45, 1};
    ts_label.do_outline = false;
    UI.text(label_row, ts_label, "Progress:");

    _ := content.cut_top(2);

    // ---- Left: Progress numbers (large bold) ----
    num_row := content;
    ts_num := UI.default_text_settings();
    ts_num.size = 28;
    ts_num.halign = .LEFT;
    ts_num.valign = .CENTER;
    ts_num.color = {1.0, 0.85, 0.2, 1};
    ts_num.do_outline = false;
    ts_num.font = bold_font;

    if q.completed && !q.claimed {
        ts_num.color = {0.1, 0.55, 0.15, 1};
        UI.text(num_row, ts_num, "% / %", {format_int_with_commas(target), format_int_with_commas(target)});
    } else {
        UI.text(num_row, ts_num, "% / %", {format_int_with_commas(q.progress), format_int_with_commas(target)});
    }

    // ---- Right: Coin icon + reward (or Claim button) ----
    if q.completed && !q.claimed {
        // Pulse animation: gentle scale bounce so the button is eye-catching.
        t := get_time() * 3.0;               // speed of pulse
        pulse := sin(t) * 0.5 + 0.5;         // 0..1 wave
        grow_amt := pulse * 3.0;              // up to 3px extra each side
        bright := 0.85 + pulse * 0.15;        // 0.85..1.0 brightness

        claim_rect := reward_area.inset(2).grow_unscaled(grow_amt, grow_amt, grow_amt, grow_amt);

        bs_claim := UI.default_button_settings();
        bs_claim.sprite = get_asset(Texture_Asset, "$AO/new/modal/buttons_2/button_2.png");
        bs_claim.press_scaling = 0.4;
        bs_claim.color = {bright, 1, bright, 1};

        ts_btn := UI.default_text_settings();
        ts_btn.size = 18;
        ts_btn.halign = .CENTER;
        ts_btn.valign = .CENTER;
        ts_btn.do_outline = true;
        ts_btn.outline_thickness = 1;
        ts_btn.outline_color = {0, 0, 0, 1};

        if UI.button(claim_rect, bs_claim, ts_btn, "Claim").clicked {
            server_quest_claim(player, slot);
        }
    } else {
        // Coin icon (top 60%).
        coin_tex := get_asset(Texture_Asset, "Items/Coin.png");
        if coin_tex != null {
            icon_area := reward_area.subrect(0, 0.38, 1, 1).inset(4);
            UI.quad(icon_area.fit_aspect(coin_tex.get_aspect()), coin_tex);
        }

        // Reward amount below icon (bottom 40%).
        reward_text_area := reward_area.subrect(0, 0, 1, 0.42);
        ts_reward := UI.default_text_settings();
        ts_reward.size = 20;
        ts_reward.halign = .CENTER;
        ts_reward.valign = .CENTER;
        ts_reward.color = {0.15, 0.15, 0.15, 1};
        ts_reward.do_outline = false;
        ts_reward.font = bold_font;
        if q.is_challenge {
            UI.text(reward_text_area, ts_reward, "x%!", {format_int_with_commas(reward)});
        } else {
            UI.text(reward_text_area, ts_reward, "x%", {format_int_with_commas(reward)});
        }
    }
}
