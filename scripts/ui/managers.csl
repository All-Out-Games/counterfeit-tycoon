import "core:ao"

MANAGERS_COIN_CURRENCY :: "Coins";

MANAGERS_LANE_COUNT :: 4;
MANAGERS_PER_LANE  :: 4;

// Temporary: hide Managers button from HUD.
SHOW_MANAGERS_BUTTON :: false;

// Cosmetic purchase SFX/VFX icon (local-only for owning client) via purchase FX pipeline.
MANAGERS_SPARKS_PURCHASE_FX_ICON_PATH :: "UI/Spark.png";

Manager_Kind :: enum {
    PRESS_OPERATOR;
    COLORIST;
    STAMPER;
    COURIER;
    WOODCHIPPER;
}

manager_display_name :: proc(kind: Manager_Kind) -> string {
    switch kind {
        case .PRESS_OPERATOR: return "Press Operator";
        case .COLORIST:       return "Colorist";
        case .STAMPER:        return "Stamper";
        case .COURIER:        return "Courier";
        case .WOODCHIPPER:    return "Woodchipper";
    }
    return "Manager";
}

manager_unlock_cost :: proc(kind: Manager_Kind) -> s64 {
    switch kind {
        case .PRESS_OPERATOR: return 1500;
        case .COLORIST:       return 4000;
        case .STAMPER:        return 10000;
        case .COURIER:        return 50000;
        case .WOODCHIPPER:    return 500; // Harvester manager (see `HARVESTER_UPGRADES_MANAGER_UNLOCK_COST`)
    }
    return 0;
}

// ---------------------------------------------------------------------------
// Sparks purchases: manager unlocks (per lane)
//
// Product naming convention (created via MCP):
// - "Press Operator Manager (Lane X)"
// - "Colorist Manager (Lane X)"
// - "Stamper Manager (Lane X)"
// - "Courier Manager (Lane X)"
// Where X is 1..4.
//
// Fulfillment is handled by `ao_purchase_handler` in `scripts/main.csl`.
// ---------------------------------------------------------------------------

managers_sparks_products :: proc() -> [16]string {
    return {
        // Lane 1
        "6995e6c4a2df09d9d29d41db", // Press Operator
        "6995e6c4c2cb15d138fcd4eb", // Colorist
        "6995e6c4867b8ac8248d7ea9", // Stamper
        "6995e6c43d518aa4fbf96bc4", // Courier

        // Lane 2
        "6995e6c4a2df09d9d29d41dc", // Press Operator
        "6995e6c43d518aa4fbf96bc3", // Colorist
        "6995e6c4ca9617b56dfba857", // Stamper
        "6995e6c4867b8ac8248d7eaa", // Courier

        // Lane 3
        "6995e6cf527889841232491b", // Press Operator
        "6995e6cfd257e61474fbd504", // Colorist
        "6995e6cfd257e61474fbd503", // Stamper
        "6995e6cf3a6535a099a6848a", // Courier

        // Lane 4
        "6995e6cf81c1538750dea133", // Press Operator
        "6995e6cff01b2938ae0145a9", // Colorist
        "6995e6cf81c1538750dea134", // Stamper
        "6995e6cf527889841232491c", // Courier
    };
}

manager_kind_index_for_sparks :: proc(kind: Manager_Kind) -> s64 {
    switch kind {
        case .PRESS_OPERATOR: return 0;
        case .COLORIST:       return 1;
        case .STAMPER:        return 2;
        case .COURIER:        return 3;
        case .WOODCHIPPER:    return -1;
    }
    return -1;
}

manager_unlock_sparks_product_id :: proc(lane_index: s64, kind: Manager_Kind) -> string {
    if lane_index < 0 || lane_index >= MANAGERS_LANE_COUNT return "";

    ki := manager_kind_index_for_sparks(kind);
    if ki < 0 || ki >= 4 return "";

    idx := lane_index * 4 + ki;
    if idx < 0 || idx >= 16 return "";

    ids := managers_sparks_products();
    if idx < 0 || idx >= ids.count return "";
    return ids[idx];
}

manager_unlock_sparks_fallback_price :: proc(kind: Manager_Kind) -> s64 {
    switch kind {
        case .PRESS_OPERATOR: return 25;
        case .COLORIST:       return 50;
        case .STAMPER:        return 100;
        case .COURIER:        return 200;
        case .WOODCHIPPER:    return 0;
    }
    return 0;
}

manager_unlock_sparks_price :: proc(lane_index: s64, kind: Manager_Kind) -> s64 {
    id := manager_unlock_sparks_product_id(lane_index, kind);
    if id.count == 0 return 0;

    p := Purchasing.get_product(id);
    if p.id.count != 0 && p.price > 0 {
        return p.price;
    }

    // Fallback to authored prices (in case product data isn't available yet).
    return manager_unlock_sparks_fallback_price(kind);
}

server_try_prompt_sparks_manager_unlock_purchase :: proc(player: Player, lane_index: s64, kind: Manager_Kind) {
    if player == null return;
    if kind == .WOODCHIPPER return;

    if lane_index < 0 || lane_index >= MANAGERS_LANE_COUNT {
        if player->is_local() {
            Notifier.notify("Invalid lane.");
        }
        return;
    }

    // Lane must be unlocked.
    if !lanes_is_unlocked(player, lane_index) {
        if player->is_local() {
            Notifier.notify("Lane % is locked.", {lane_index + 1});
        }
        return;
    }

    // Already unlocked?
    if is_manager_unlocked(player, lane_index, kind) {
        if player->is_local() {
            Notifier.notify("Already unlocked.");
        }
        return;
    }

    product_id := manager_unlock_sparks_product_id(lane_index, kind);
    if product_id.count == 0 {
        if player->is_local() {
            Notifier.notify("Sparks purchase not available.");
        }
        return;
    }

    Purchasing.prompt_purchase(player, product_id);
}

server_grant_manager_unlock :: proc(player: Player, lane_index: s64, kind: Manager_Kind, purchase_source: string) -> bool {
    if player == null return false;
    if !Game.is_server() return false;
    if kind == .WOODCHIPPER return false;
    if lane_index < 0 || lane_index >= MANAGERS_LANE_COUNT return false;

    // Must have the lane unlocked.
    if !lanes_is_unlocked(player, lane_index) {
        Notifier.notify(player, "Lane % is locked.", {lane_index + 1});
        return false;
    }

    bit := manager_bit(kind);
    if bit == 0 return false;

    mask := player.managers_lane_masks[lane_index];
    if (mask & bit) != 0 {
        return false;
    }

    new_mask := mask | bit;
    player.managers_lane_masks[lane_index] = new_mask;
    Save.set_int(player, managers_lane_save_key(lane_index), new_mask);

    // Cosmetic: purchase FX + SFX on the owning client.
    server_request_purchase_fx(player, MANAGERS_SPARKS_PURCHASE_FX_ICON_PATH);

    // Quest tracking: manager hired.
    quest_on_manager_hired(player);

    // Spawn the manager at the station anchor (so Sparks unlocks behave like in-world prompts).
    gm := get_game_manager();
    if gm != null && player.base_entity != null && player.base_entity.self != null {
        pb := player.base_entity->get_component(PlayerBase);
        if pb != null {
            spawn_pos := gm->manager_unlock_anchor_world_pos(pb, lane_index, kind);
            gm->server_spawn_manager_kind_at(player, lane_index, kind, spawn_pos);
            gm->server_reconcile_manager_unlock_prompts_for_player(player);
        }
    }

    if purchase_source.count != 0 {
        Notifier.notify(player, "Unlocked % (Lane %) (%).", {manager_display_name(kind), lane_index + 1, purchase_source});
    }
    else {
        Notifier.notify(player, "Unlocked % (Lane %).", {manager_display_name(kind), lane_index + 1});
    }

    return true;
}

managers_try_handle_manager_unlock_purchase_name :: proc(player: Player, purchase_name: string) -> bool {
    if player == null return false;
    if purchase_name.count == 0 return false;

    for lane_num: 1..MANAGERS_LANE_COUNT {
        lane_index := lane_num - 1;
        for manager_index: 0..MANAGERS_PER_LANE-1 {
            kind := manager_kind_from_index(manager_index);
            expected := format_string("% Manager (Lane %)", {manager_display_name(kind), lane_num});
            if purchase_name == expected {
                if Game.is_server() {
                    _ := server_grant_manager_unlock(player, lane_index, kind, "Sparks");
                }
                return true;
            }
        }
    }

    return false;
}

// Managers Sparks purchase fulfillment.
// Called by `ao_purchase_handler` (defined in `scripts/main.csl`) when a purchase succeeds.
// Return true if we handled the purchase id.
managers_try_handle_purchase :: proc(player: Player, id: string) -> bool {
    if player == null return false;
    if id.count == 0 return false;

    // Primary: resolve product id -> product name, then match by naming convention.
    prod := Purchasing.get_product(id);
    if prod.id.count != 0 {
        if managers_try_handle_manager_unlock_purchase_name(player, prod.name) return true;
    }

    // Fallback: id might be the product name directly.
    if managers_try_handle_manager_unlock_purchase_name(player, id) return true;

    return false;
}

manager_kind_from_index :: proc(index: s64) -> Manager_Kind {
    switch index {
        case 0: return .PRESS_OPERATOR;
        case 1: return .COLORIST;
        case 2: return .STAMPER;
        case 3: return .COURIER;
    }
    return .PRESS_OPERATOR;
}

manager_bit :: proc(kind: Manager_Kind) -> s64 {
    switch kind {
        case .PRESS_OPERATOR: return 1;
        case .COLORIST:       return 2;
        case .STAMPER:        return 4;
        case .COURIER:        return 8;
        case .WOODCHIPPER:    return 0; // Not stored in per-lane mask (uses `player.harvester_manager_unlocked`)
    }
    return 0;
}

managers_lane_save_key :: proc(lane_index: s64) -> string {
    // lane_index is 0-based
    return format_string("managers_lane_%_mask", {lane_index});
}

is_manager_unlocked :: proc(player: Player, lane_index: s64, kind: Manager_Kind) -> bool {
    if player == null return false;
    if kind == .WOODCHIPPER {
        return player.harvester_manager_unlocked;
    }
    if lane_index < 0 || lane_index >= MANAGERS_LANE_COUNT return false;

    mask := player.managers_lane_masks[lane_index];
    bit := manager_bit(kind);
    return (mask & bit) != 0;
}

server_try_unlock_manager :: proc(player: Player, lane_index: s64, kind: Manager_Kind) {
    if player == null return;
    if !Game.is_server() return;
    if kind == .WOODCHIPPER {
        // Harvester manager is unlocked via `server_try_unlock_harvester_manager`.
        return;
    }
    if lane_index < 0 || lane_index >= MANAGERS_LANE_COUNT return;
    // Must have the lane unlocked.
    if !lanes_is_unlocked(player, lane_index) {
        Notifier.notify(player, "Lane % is locked.", {lane_index + 1});
        return;
    }

    bit := manager_bit(kind);
    if bit == 0 return;

    mask := player.managers_lane_masks[lane_index];
    if (mask & bit) != 0 {
        return; // already unlocked
    }

    cost := manager_unlock_cost(kind);
    if cost <= 0 return;

    if !Economy.can_withdraw_currency(player, MANAGERS_COIN_CURRENCY, cost) {
        Notifier.notify(player, "Not enough Coins!");
        return;
    }

    Economy.withdraw_currency(player, MANAGERS_COIN_CURRENCY, cost);

    new_mask := mask | bit;
    player.managers_lane_masks[lane_index] = new_mask;

    Save.set_int(player, managers_lane_save_key(lane_index), new_mask);
    Notifier.notify(player, "Unlocked % (Lane %).", {manager_display_name(kind), lane_index + 1});

    // Quest tracking: manager hired.
    quest_on_manager_hired(player);
}

draw_managers_unlock_lane_prompt :: proc(player: Player, rect: Rect, lane_index: s64) {
    if player == null return;
    if lane_index < 0 || lane_index >= MANAGERS_LANE_COUNT return;

    UI.quad(rect, core_globals.white_sprite, {0.08, 0.08, 0.08, 0.95});
    inner := rect->inset(26);

    title := inner->cut_top(90);
    _ := inner->cut_top(10);
    button_row := inner->cut_top(100);

    ts_title := UI.default_text_settings();
    ts_title.size = 44;
    ts_title.halign = .CENTER;
    ts_title.valign = .CENTER;
    ts_title.do_outline = true;
    ts_title.outline_thickness = 3;
    ts_title.outline_color = {0, 0, 0, 1};
    UI.text(title, ts_title, "Unlock Lane %?", {lane_index + 1});

    prereq_ok := lane_index == 0 || lanes_is_unlocked(player, lane_index - 1);
    cost := lanes_unlock_cost(lane_index);
    can_afford := cost > 0 && Economy.can_withdraw_currency(player, MANAGERS_COIN_CURRENCY, cost);

    bs := UI.default_button_settings();
    bs.press_scaling = 0.4;

    ts_btn := UI.default_text_settings();
    ts_btn.size = 34;
    ts_btn.halign = .CENTER;
    ts_btn.valign = .CENTER;
    ts_btn.do_outline = true;
    ts_btn.outline_thickness = 2;
    ts_btn.outline_color = {0, 0, 0, 1};

    if !prereq_ok {
        bs.sprite = get_asset(Texture_Asset, "$AO/new/modal/buttons_2/button_8.png"); // Grey
        UI.push_disabled(true);
        defer UI.pop_disabled();
        _ := UI.button(button_row->inset(10), bs, ts_btn, "Unlock previous lane first");
        return;
    }

    bs.sprite = get_asset(Texture_Asset, "$AO/new/modal/buttons_2/button_2.png"); // Green
    if !can_afford {
        bs.sprite = get_asset(Texture_Asset, "$AO/new/modal/buttons_2/button_3.png"); // Red
    }

    label := format_string("Unlock ($%)", {format_int_with_commas(cost)});
    if UI.button(button_row->inset(10), bs, ts_btn, label).clicked {
        server_try_unlock_lane(player, lane_index);
    }
}

draw_managers_button :: proc(player: Player) {
    if player == null return;
    if !player->is_local_or_server() return;
    if !SHOW_MANAGERS_BUTTON return;

    safe := UI.get_safe_screen_rect();
    btn_rect := safe->right_center_rect()->grow(75)->offset(-100, 120);

    bs := UI.default_button_settings();
    ts := UI.default_text_settings();
    ts.size = 28;

    icon := get_asset(Texture_Asset, "UI/Manager.png");
    bs.sprite = icon;
    bs.press_scaling = 0.8;

    // Fit the clickable button rect to the sprite aspect ratio so the image doesn't stretch.
    draw_rect := btn_rect;
    if icon != null {
        draw_rect = btn_rect->fit_aspect(icon->get_aspect());
    }

    if UI.button(draw_rect, bs, ts, "Managers").clicked {
        // Keep this state server-authoritative so it replicates.
        if Game.is_server() {
            player.managers_open = !player.managers_open;
            if player.managers_open {
                // Avoid overlapping modals.
                player.sell_shop_open = false;
                player.weapons_shop_open = false;
                player.harvester_upgrades_open = false;
                player.upgrades_open = false;
                player.truck_upgrades_open = false;
            }
        }
    }
}

draw_lane_header_buttons :: proc(player: Player, rect: Rect) {
    if player == null return;

    ts := UI.default_text_settings();
    ts.size = 28;
    ts.halign = .CENTER;
    ts.valign = .CENTER;
    ts.do_outline = true;
    ts.outline_thickness = 2;
    ts.outline_color = {0, 0, 0, 1};

    bs_selected := UI.default_button_settings();
    bs_selected.sprite = get_asset(Texture_Asset, "$AO/new/modal/buttons_2/button_5.png"); // Blue
    bs_selected.press_scaling = 0.35;

    bs_normal := UI.default_button_settings();
    bs_normal.sprite = get_asset(Texture_Asset, "$AO/new/modal/buttons_2/button_8.png"); // Grey
    bs_normal.press_scaling = 0.35;

    for i: 0..MANAGERS_LANE_COUNT-1 {
        UI.push_id("lane_btn_%", {i});
        defer UI.pop_id();

        x1 := i.(float) / MANAGERS_LANE_COUNT.(float);
        x2 := (i + 1).(float) / MANAGERS_LANE_COUNT.(float);
        btn := rect->subrect(x1, 0, x2, 1)->inset(8);

        label := format_string("Lane %", {i + 1});
        is_selected := player.managers_selected_lane == i;
        bs := is_selected ? bs_selected : bs_normal;

        if UI.button(btn, bs, ts, label).clicked {
            if Game.is_server() {
                player.managers_selected_lane = i;
            }
        }
    }
}

draw_manager_card :: proc(player: Player, rect: Rect, lane_index: s64, kind: Manager_Kind) {
    if player == null return;

    // Card background
    UI.quad(rect, core_globals.white_sprite, {0.08, 0.08, 0.08, 0.95});

    inner := rect->inset(18);

    // Title
    title_rect := inner->cut_top(56);
    ts_title := UI.default_text_settings();
    ts_title.size = 34;
    ts_title.halign = .CENTER;
    ts_title.valign = .CENTER;
    ts_title.do_outline = true;
    ts_title.outline_thickness = 2;
    ts_title.outline_color = {0, 0, 0, 1};
    UI.text(title_rect, ts_title, manager_display_name(kind));

    _ := inner->cut_top(10);

    // Icon
    icon_rect := inner->cut_top_unscaled(inner->height() * 0.62)->inset(10);
    icon := get_asset(Texture_Asset, "UI/Manager.png");
    if icon != null {
        tint := v4{1, 1, 1, 1};
        if !is_manager_unlocked(player, lane_index, kind) {
            tint = v4{0.45, 0.45, 0.45, 1};
        }
        UI.quad(icon_rect->fit_aspect(icon->get_aspect()), icon, tint);
    }

    // Bottom button area
    _ := inner->cut_top(10);
    btn_rect := inner->cut_bottom(78);

    unlocked := is_manager_unlocked(player, lane_index, kind);

    if !unlocked {
        cost := manager_unlock_cost(kind);

        can_afford := cost > 0 && Economy.can_withdraw_currency(player, MANAGERS_COIN_CURRENCY, cost);

        bs := UI.default_button_settings();
        bs.sprite = get_asset(Texture_Asset, "$AO/new/modal/buttons_2/button_2.png"); // Green
        if !can_afford {
            bs.sprite = get_asset(Texture_Asset, "$AO/new/modal/buttons_2/button_3.png"); // Red
        }
        bs.press_scaling = 0.4;

        ts := UI.default_text_settings();
        ts.size = 30;
        ts.halign = .CENTER;
        ts.valign = .CENTER;
        ts.do_outline = true;
        ts.outline_thickness = 2;
        ts.outline_color = {0, 0, 0, 1};

        if !lanes_is_unlocked(player, lane_index) {
            // Lane is locked: manager purchase not available.
            bs.sprite = get_asset(Texture_Asset, "$AO/new/modal/buttons_2/button_8.png"); // Grey
            UI.push_disabled(true);
            defer UI.pop_disabled();
            _ := UI.button(btn_rect->inset(6), bs, ts, "Lane Locked");
        }
        else {
            // Optional Sparks unlock button (if a product exists for this lane/kind).
            sparks_product_id := manager_unlock_sparks_product_id(lane_index, kind);
            sparks_price := manager_unlock_sparks_price(lane_index, kind);
            has_sparks := sparks_product_id.count != 0 && sparks_price > 0;

            coins_btn_rect := btn_rect;
            sparks_btn_rect := btn_rect;
            if has_sparks {
                left := btn_rect->cut_left_unscaled(btn_rect->width() * 0.5);
                coins_btn_rect = left;
                sparks_btn_rect = btn_rect;
            }

            // Coins unlock
            label := format_string("Unlock $%", {format_int_with_commas(cost)});
            UI.push_id("mgr_coin_btn", {}); defer UI.pop_id();
            if UI.button(coins_btn_rect->inset(6), bs, ts, label).clicked {
                server_try_unlock_manager(player, lane_index, kind);
            }

            // Sparks unlock
            if has_sparks {
                UI.push_id("mgr_sparks_btn", {}); defer UI.pop_id();

                bs_sparks := UI.default_button_settings();
                bs_sparks.sprite = get_asset(Texture_Asset, "$AO/new/modal/buttons_2/button_4.png"); // Gold
                bs_sparks.press_scaling = 0.35;

                sparks_icon := get_asset(Texture_Asset, "UI/Spark.png");
                sparks_label := format_string("%", {format_int_with_commas(sparks_price)});

                ts_sparks := ts;
                ts_sparks.do_autofit = true;
                ts_sparks.autofit_min_size = 18;
                ts_sparks.autofit_max_size = ts.size;

                result_sparks := UI.begin_button(sparks_btn_rect->inset(6), bs_sparks, ts_sparks, ""); {
                    defer UI.end_button();

                    inner_btn := result_sparks.rect->inset(10);
                    if sparks_icon != null {
                        icon_rect := inner_btn->left_center_rect()->grow_unscaled(18)->offset_unscaled(22, 0);
                        UI.quad(icon_rect->fit_aspect(sparks_icon->get_aspect()), sparks_icon);
                    }

                    label_rect := inner_btn;
                    _ := label_rect->cut_left_unscaled(46);
                    UI.text(label_rect, ts_sparks, sparks_label);
                }

                if result_sparks.clicked {
                    server_try_prompt_sparks_manager_unlock_purchase(player, lane_index, kind);
                }
            }
        }
    }
    else {
        bs := UI.default_button_settings();
        bs.sprite = get_asset(Texture_Asset, "$AO/new/modal/buttons_2/button_8.png"); // Grey
        bs.press_scaling = 0.0;

        ts := UI.default_text_settings();
        ts.size = 30;
        ts.halign = .CENTER;
        ts.valign = .CENTER;
        ts.do_outline = true;
        ts.outline_thickness = 2;
        ts.outline_color = {0, 0, 0, 1};

        UI.push_disabled(true);
        defer UI.pop_disabled();
        _ := UI.button(btn_rect->inset(6), bs, ts, "Unlocked");
    }
}

draw_managers_modal :: proc(player: Player) {
    UI.push_screen_draw_context();
    defer UI.pop_draw_context();

    UI.push_layer(210);
    defer UI.pop_layer();

    screen := UI.get_safe_screen_rect();

    // Dim background
    UI.quad(screen, core_globals.white_sprite, {0, 0, 0, 0.65});

    // Window (similar sizing to Sell Shop)
    window := screen->inset(100);
    UI.quad(window, core_globals.white_sprite, {0.12, 0.12, 0.12, 0.95});

    // Header with lane selection
    header := window->cut_top(150)->inset(20);
    title_rect := header->cut_top(60);
    lane_rect := header->cut_top(70);

    ts_title := UI.default_text_settings();
    ts_title.size = 52;
    ts_title.halign = .LEFT;
    ts_title.valign = .CENTER;
    ts_title.offset = {20, 0};
    ts_title.do_outline = true;
    ts_title.outline_thickness = 3;
    ts_title.outline_color = {0, 0, 0, 1};
    UI.text(title_rect, ts_title, "Managers");

    draw_lane_header_buttons(player, lane_rect);

    // Content area (below header)
    content := window->inset(30);

    // Footer close button (red)
    footer := content->cut_bottom(95);
    {
        bs_close := UI.default_button_settings();
        ts_close := UI.default_text_settings();
        ts_close.size = 40;
        ts_close.halign = .CENTER;
        ts_close.valign = .CENTER;

        bs_close.sprite = get_asset(Texture_Asset, "$AO/new/modal/buttons_2/button_3.png"); // Red
        bs_close.press_scaling = 0.45;

        close_btn := footer->inset(10);
        if UI.button(close_btn, bs_close, ts_close, "Close").clicked {
            if Game.is_server() {
                player.managers_open = false;
            }
            return;
        }
    }

    body := content->inset(10);

    lane := player.managers_selected_lane;
    if lane < 0 || lane >= MANAGERS_LANE_COUNT {
        lane = 0;
    }

    // If this lane is locked, show the lane unlock purchase UI instead of manager cards.
    if !lanes_is_unlocked(player, lane) {
        prompt_rect := body->center_rect()->grow(160, 360, 160, 360);
        draw_managers_unlock_lane_prompt(player, prompt_rect, lane);
        return;
    }

    // 2x2 grid of manager cards
    cards_area := body;
    for i: 0..MANAGERS_PER_LANE-1 {
        UI.push_id("mgr_card_%", {i});
        defer UI.pop_id();

        kind := manager_kind_from_index(i);

        x1 := (i % 2).(float) * 0.5;
        x2 := x1 + 0.5;
        y1 := (i < 2) ? 0.5 : 0.0;
        y2 := y1 + 0.5;

        card := cards_area->subrect(x1, y1, x2, y2)->inset(12);
        draw_manager_card(player, card, lane, kind);
    }
}

draw_managers_ui :: proc(player: Player) {
    if player == null return;
    if !player->is_local_or_server() return;

    // Always draw the toggle button (unless another modal should disable it later)
    draw_managers_button(player);

    if player.managers_open {
        draw_managers_modal(player);
    }
}

