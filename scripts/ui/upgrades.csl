paper_mill_upgrade_sparks_product_id_for_level :: proc(lane_index: s64, target_level: s64) -> string {
    // lane_index is 0-based
    switch lane_index {
        case 0: {
            switch target_level {
                case 2:  return PAPER_MILL_SPARKS_PRODUCT_LANE_1_LEVEL_2;
                case 3:  return PAPER_MILL_SPARKS_PRODUCT_LANE_1_LEVEL_3;
                case 4:  return PAPER_MILL_SPARKS_PRODUCT_LANE_1_LEVEL_4;
                case 5:  return PAPER_MILL_SPARKS_PRODUCT_LANE_1_LEVEL_5;
                case 6:  return PAPER_MILL_SPARKS_PRODUCT_LANE_1_LEVEL_6;
                case 7:  return PAPER_MILL_SPARKS_PRODUCT_LANE_1_LEVEL_7;
                case 8:  return PAPER_MILL_SPARKS_PRODUCT_LANE_1_LEVEL_8;
                case 9:  return PAPER_MILL_SPARKS_PRODUCT_LANE_1_LEVEL_9;
                case 10: return PAPER_MILL_SPARKS_PRODUCT_LANE_1_LEVEL_10;
            }
        }
        case 1: {
            switch target_level {
                case 2:  return PAPER_MILL_SPARKS_PRODUCT_LANE_2_LEVEL_2;
                case 3:  return PAPER_MILL_SPARKS_PRODUCT_LANE_2_LEVEL_3;
                case 4:  return PAPER_MILL_SPARKS_PRODUCT_LANE_2_LEVEL_4;
                case 5:  return PAPER_MILL_SPARKS_PRODUCT_LANE_2_LEVEL_5;
                case 6:  return PAPER_MILL_SPARKS_PRODUCT_LANE_2_LEVEL_6;
                case 7:  return PAPER_MILL_SPARKS_PRODUCT_LANE_2_LEVEL_7;
                case 8:  return PAPER_MILL_SPARKS_PRODUCT_LANE_2_LEVEL_8;
                case 9:  return PAPER_MILL_SPARKS_PRODUCT_LANE_2_LEVEL_9;
                case 10: return PAPER_MILL_SPARKS_PRODUCT_LANE_2_LEVEL_10;
            }
        }
        case 2: {
            switch target_level {
                case 2:  return PAPER_MILL_SPARKS_PRODUCT_LANE_3_LEVEL_2;
                case 3:  return PAPER_MILL_SPARKS_PRODUCT_LANE_3_LEVEL_3;
                case 4:  return PAPER_MILL_SPARKS_PRODUCT_LANE_3_LEVEL_4;
                case 5:  return PAPER_MILL_SPARKS_PRODUCT_LANE_3_LEVEL_5;
                case 6:  return PAPER_MILL_SPARKS_PRODUCT_LANE_3_LEVEL_6;
                case 7:  return PAPER_MILL_SPARKS_PRODUCT_LANE_3_LEVEL_7;
                case 8:  return PAPER_MILL_SPARKS_PRODUCT_LANE_3_LEVEL_8;
                case 9:  return PAPER_MILL_SPARKS_PRODUCT_LANE_3_LEVEL_9;
                case 10: return PAPER_MILL_SPARKS_PRODUCT_LANE_3_LEVEL_10;
            }
        }
        case 3: {
            switch target_level {
                case 2:  return PAPER_MILL_SPARKS_PRODUCT_LANE_4_LEVEL_2;
                case 3:  return PAPER_MILL_SPARKS_PRODUCT_LANE_4_LEVEL_3;
                case 4:  return PAPER_MILL_SPARKS_PRODUCT_LANE_4_LEVEL_4;
                case 5:  return PAPER_MILL_SPARKS_PRODUCT_LANE_4_LEVEL_5;
                case 6:  return PAPER_MILL_SPARKS_PRODUCT_LANE_4_LEVEL_6;
                case 7:  return PAPER_MILL_SPARKS_PRODUCT_LANE_4_LEVEL_7;
                case 8:  return PAPER_MILL_SPARKS_PRODUCT_LANE_4_LEVEL_8;
                case 9:  return PAPER_MILL_SPARKS_PRODUCT_LANE_4_LEVEL_9;
                case 10: return PAPER_MILL_SPARKS_PRODUCT_LANE_4_LEVEL_10;
            }
        }
    }
    return "";
}

paper_mill_upgrade_sparks_fallback_price_for_level :: proc(target_level: s64) -> s64 {
    // Price ladder for Level 2..10.
    switch target_level {
        case 2:  return 5;
        case 3:  return 5;
        case 4:  return 5;
        case 5:  return 10;
        case 6:  return 25;
        case 7:  return 75;
        case 8:  return 100;
        case 9:  return 150;
        case 10: return 200;
    }
    return 0;
}

paper_mill_upgrade_sparks_price_for_level :: proc(lane_index: s64, target_level: s64) -> s64 {
    id := paper_mill_upgrade_sparks_product_id_for_level(lane_index, target_level);
    if id.count == 0 {
        return 0;
    }

    p := Purchasing.get_product(id);
    if p.id.count != 0 && p.price > 0 {
        return p.price;
    }

    // Fallback to authored prices (in case product data isn't available yet).
    return paper_mill_upgrade_sparks_fallback_price_for_level(target_level);
}

station_upgrade_sparks_product_id_for_level :: proc(lane_index: s64, kind: Station_Kind, target_level: s64) -> string {
    switch kind {
        case .SHREDDER:      return paper_mill_upgrade_sparks_product_id_for_level(lane_index, target_level);
        case .PAPER_PRESS:   return blank_bill_press_upgrade_sparks_product_id_for_level(lane_index, target_level);
        case .COLOR_MACHINE: return colored_bill_press_upgrade_sparks_product_id_for_level(lane_index, target_level);
        case .STAMP_MACHINE: return finished_bill_press_upgrade_sparks_product_id_for_level(lane_index, target_level);
    }
    return "";
}

station_upgrade_sparks_fallback_price_for_level :: proc(kind: Station_Kind, target_level: s64) -> s64 {
    switch kind {
        case .SHREDDER:      return paper_mill_upgrade_sparks_fallback_price_for_level(target_level);
        case .PAPER_PRESS:   return blank_bill_press_upgrade_sparks_fallback_price_for_level(target_level);
        case .COLOR_MACHINE: return colored_bill_press_upgrade_sparks_fallback_price_for_level(target_level);
        case .STAMP_MACHINE: return finished_bill_press_upgrade_sparks_fallback_price_for_level(target_level);
    }
    return 0;
}

station_upgrade_sparks_price_for_level :: proc(lane_index: s64, kind: Station_Kind, target_level: s64) -> s64 {
    id := station_upgrade_sparks_product_id_for_level(lane_index, kind, target_level);
    if id.count == 0 {
        return 0;
    }

    p := Purchasing.get_product(id);
    if p.id.count != 0 && p.price > 0 {
        return p.price;
    }

    // Fallback to authored prices (in case product data isn't available yet).
    return station_upgrade_sparks_fallback_price_for_level(kind, target_level);
}

server_try_prompt_sparks_station_upgrade_purchase :: proc(player: Player, lane_index: s64, kind: Station_Kind, target_level: s64) {
    if player == null return;

    if lane_index < 0 || lane_index >= UPGRADES_LANE_COUNT {
        if player->is_local() {
            Notifier.notify("Invalid lane.");
        }
        return;
    }

    if target_level < 2 || target_level > UPGRADES_MAX_LEVEL {
        if player->is_local() {
            Notifier.notify("Invalid upgrade.");
        }
        return;
    }

    cur := get_player_station_level(player, lane_index, kind);
    if cur < 1 cur = 1;
    if cur >= target_level {
        if player->is_local() {
            Notifier.notify("% is already Level %.", {station_display_name(kind), cur});
        }
        return;
    }

    product_id := station_upgrade_sparks_product_id_for_level(lane_index, kind, target_level);
    if product_id.count == 0 {
        if player->is_local() {
            Notifier.notify("Sparks purchase not available.");
        }
        return;
    }

    Purchasing.prompt_purchase(player, product_id);
}

server_grant_station_upgrade_to_level :: proc(player: Player, lane_index: s64, kind: Station_Kind, target_level: s64, purchase_source: string) -> bool {
    if player == null return false;
    if !Game.is_server() return false;
    if lane_index < 0 || lane_index >= UPGRADES_LANE_COUNT return false;

    // Must have the lane unlocked (same requirement as coin upgrades).
    if !lanes_is_unlocked(player, lane_index) {
        Notifier.notify(player, "Lane % is locked.", {lane_index + 1});
        return false;
    }

    lvl := target_level;
    if lvl < 1 lvl = 1;
    if lvl > UPGRADES_MAX_LEVEL lvl = UPGRADES_MAX_LEVEL;

    cur := get_player_station_level(player, lane_index, kind);
    if cur >= lvl {
        return false;
    }

    set_player_station_level(player, lane_index, kind, lvl);

    st := station_index(kind);
    Save.set_int(player, station_upgrade_level_save_key(lane_index, st), lvl);

    // Push new level into the actual station components.
    gm := get_game_manager();
    if gm != null {
        gm->server_apply_station_upgrade_levels_for_player(player);
    }

    // Cosmetic: purchase FX + SFX on the owning client.
    server_request_purchase_fx(player, UPGRADES_SPARKS_PURCHASE_FX_ICON_PATH);

    if purchase_source.count != 0 {
        Notifier.notify(player, "% upgraded to Level % (Lane %) (%).", {station_display_name(kind), lvl, lane_index + 1, purchase_source});
    }
    else {
        Notifier.notify(player, "% upgraded to Level % (Lane %).", {station_display_name(kind), lvl, lane_index + 1});
    }

    // Quest tracking: machine upgraded.
    quest_on_upgrade(player);

    return true;
}

upgrades_try_handle_station_upgrade_purchase_name :: proc(player: Player, station_prefix: string, kind: Station_Kind, purchase_name: string) -> bool {
    if player == null return false;
    if purchase_name.count == 0 return false;
    if station_prefix.count == 0 return false;

    // We compare against generated expected names so we don't need to hardcode product ids.
    // (This also naturally handles any duplicate products with the same name.)
    for lane_num: 1..UPGRADES_LANE_COUNT {
        lane_index := lane_num - 1;
        for target_level: 2..UPGRADES_MAX_LEVEL {
            expected := format_string("% Upgrade (Lane %): Level %", {station_prefix, lane_num, target_level});
            if purchase_name == expected {
                if Game.is_server() {
                    _ := server_grant_station_upgrade_to_level(player, lane_index, kind, target_level, "Sparks");
                }
                return true;
            }
        }
    }

    return false;
}

// Called by `ao_purchase_handler` (defined in `scripts/main.csl`) when a purchase succeeds.
// Return true if we handled the purchase id.
upgrades_try_handle_purchase :: proc(player: Player, id: string) -> bool {
    if player == null return false;
    if id.count == 0 return false;

    // Primary: resolve product id -> product name, then match by naming convention.
    prod := Purchasing.get_product(id);
    if prod.id.count != 0 {
        if upgrades_try_handle_station_upgrade_purchase_name(player, "Paper Mill", .SHREDDER, prod.name) return true;
        if upgrades_try_handle_station_upgrade_purchase_name(player, "Blank Bill Press", .PAPER_PRESS, prod.name) return true;
        if upgrades_try_handle_station_upgrade_purchase_name(player, "Colored Bill Press", .COLOR_MACHINE, prod.name) return true;
        if upgrades_try_handle_station_upgrade_purchase_name(player, "Finished Bill Press", .STAMP_MACHINE, prod.name) return true;
    }

    // Fallback: some purchase flows may pass the product name directly.
    if upgrades_try_handle_station_upgrade_purchase_name(player, "Paper Mill", .SHREDDER, id) return true;
    if upgrades_try_handle_station_upgrade_purchase_name(player, "Blank Bill Press", .PAPER_PRESS, id) return true;
    if upgrades_try_handle_station_upgrade_purchase_name(player, "Colored Bill Press", .COLOR_MACHINE, id) return true;
    if upgrades_try_handle_station_upgrade_purchase_name(player, "Finished Bill Press", .STAMP_MACHINE, id) return true;

    return false;
}

draw_upgrades_unlock_lane_prompt :: proc(player: Player, rect: Rect, lane_index: s64) {
    if player == null return;
    if lane_index < 0 || lane_index >= UPGRADES_LANE_COUNT return;

    UI.quad(rect, core_globals.white_sprite, {0.08, 0.08, 0.08, 0.95});
    inner := rect->inset(26);

    title := inner->cut_top(90);
    _ := inner->cut_top(10);
    button_row := inner->cut_top(100);

    ts_title := UI.default_text_settings();
    ts_title.size = 44;
    ts_title.halign = .CENTER;
    ts_title.valign = .CENTER;
    ts_title.do_outline = true;
    ts_title.outline_thickness = 3;
    ts_title.outline_color = {0, 0, 0, 1};
    UI.text(title, ts_title, "Unlock Lane %?", {lane_index + 1});

    // Prereq: previous lane must be unlocked.
    prereq_ok := lane_index == 0 || lanes_is_unlocked(player, lane_index - 1);
    cost := lanes_unlock_cost(lane_index);
    can_afford := cost > 0 && Economy.can_withdraw_currency(player, UPGRADES_COIN_CURRENCY, cost);

    bs := UI.default_button_settings();
    bs.press_scaling = 0.4;

    ts_btn := UI.default_text_settings();
    ts_btn.size = 34;
    ts_btn.halign = .CENTER;
    ts_btn.valign = .CENTER;
    ts_btn.do_outline = true;
    ts_btn.outline_thickness = 2;
    ts_btn.outline_color = {0, 0, 0, 1};

    if !prereq_ok {
        bs.sprite = get_asset(Texture_Asset, "$AO/new/modal/buttons_2/button_8.png"); // Grey
        UI.push_disabled(true);
        defer UI.pop_disabled();
        _ := UI.button(button_row->inset(10), bs, ts_btn, "Unlock previous lane first");
        return;
    }

    bs.sprite = get_asset(Texture_Asset, "$AO/new/modal/buttons_2/button_2.png"); // Green
    if !can_afford {
        bs.sprite = get_asset(Texture_Asset, "$AO/new/modal/buttons_2/button_3.png"); // Red
    }

    label := format_string("Unlock ($%)", {format_int_with_commas(cost)});
    if UI.button(button_row->inset(10), bs, ts_btn, label).clicked {
        server_try_unlock_lane(player, lane_index);
    }
}

draw_upgrades_button :: proc(player: Player) {
    if player == null return;
    if !player->is_local_or_server() return;

    safe := UI.get_safe_screen_rect();
    btn_rect := safe->right_center_rect()->grow(60)->offset(-90, -240);

    bs := UI.default_button_settings();
    ts := UI.default_text_settings();
    ts.size = 24;

    icon := get_asset(Texture_Asset, "Buttons/upgrades.png");
    if icon != null {
        bs.sprite = icon;
        bs.press_scaling = 0.8;

        // Fit the clickable button rect to the sprite aspect ratio so the image doesn't stretch.
        draw_rect := btn_rect;
        draw_rect = btn_rect->fit_aspect(icon->get_aspect());

        if UI.button(draw_rect, bs, ts, "Upgrades").clicked {
            // Keep this state server-authoritative so it replicates.
            if Game.is_server() {
                player.upgrades_open = !player.upgrades_open;
                if player.upgrades_open {
                    // Avoid overlapping modals.
                    player.sell_shop_open = false;
                    player.weapons_shop_open = false;
                    player.managers_open = false;
                    player.harvester_upgrades_open = false;
                    player.truck_upgrades_open = false;
                }
            }
        }
        return;
    }

    // Fallback: if icon is missing, draw a normal button.
    bs.sprite = get_asset(Texture_Asset, "$AO/new/modal/buttons_2/button_5.png"); // Blue
    bs.press_scaling = 0.4;
    if UI.button(btn_rect->grow(0, 130, 0, 130), bs, ts, "Upgrades").clicked {
        if Game.is_server() {
            player.upgrades_open = !player.upgrades_open;
            if player.upgrades_open {
                player.sell_shop_open = false;
                player.weapons_shop_open = false;
                player.managers_open = false;
                player.harvester_upgrades_open = false;
                player.truck_upgrades_open = false;
            }
        }
    }
}

UPGRADES_TAB_VAULT :: 4; // upgrades_selected_lane == 4 means the Vault tab

draw_upgrades_lane_header_buttons :: proc(player: Player, rect: Rect) {
    if player == null return;

    ts := UI.default_text_settings();
    ts.size = 28;
    ts.halign = .CENTER;
    ts.valign = .CENTER;
    ts.do_outline = true;
    ts.outline_thickness = 2;
    ts.outline_color = {0, 0, 0, 1};

    bs_selected := UI.default_button_settings();
    bs_selected.sprite = get_asset(Texture_Asset, "$AO/new/modal/buttons_2/button_5.png"); // Blue
    bs_selected.press_scaling = 0.35;

    bs_normal := UI.default_button_settings();
    bs_normal.sprite = get_asset(Texture_Asset, "$AO/new/modal/buttons_2/button_8.png"); // Grey
    bs_normal.press_scaling = 0.35;

    TAB_COUNT :: 5; // 4 lanes + 1 vault

    for i: 0..TAB_COUNT-1 {
        UI.push_id("up_lane_btn_%", {i});
        defer UI.pop_id();

        x1 := i.(float) / TAB_COUNT.(float);
        x2 := (i + 1).(float) / TAB_COUNT.(float);
        btn := rect->subrect(x1, 0, x2, 1)->inset(8);

        label := "Piggy Bank";
        if i < UPGRADES_LANE_COUNT {
            label = format_string("Lane %", {i + 1});
        }

        is_selected := player.upgrades_selected_lane == i;
        bs := is_selected ? bs_selected : bs_normal;

        if UI.button(btn, bs, ts, label).clicked {
            if Game.is_server() {
                player.upgrades_selected_lane = i;
            }
        }
    }
}

draw_station_upgrade_card :: proc(player: Player, rect: Rect, lane_index: s64, kind: Station_Kind) {
    if player == null return;

    UI.quad(rect, core_globals.white_sprite, {0.08, 0.08, 0.08, 0.95});
    inner := rect->inset(18);

    // Title
    title_rect := inner->cut_top(56);
    ts_title := UI.default_text_settings();
    ts_title.size = 34;
    ts_title.halign = .CENTER;
    ts_title.valign = .CENTER;
    ts_title.do_outline = true;
    ts_title.outline_thickness = 2;
    ts_title.outline_color = {0, 0, 0, 1};
    UI.text(title_rect, ts_title, station_display_name(kind));

    _ := inner->cut_top(8);

    level := get_player_station_level(player, lane_index, kind);
    lvl_f := (level - 1).(float);
    speed_mult := 1.0 + lvl_f * UPGRADES_SPEED_MULT_PER_LEVEL;

    info_rect := inner->cut_top_unscaled(inner->height() * 0.78)->inset(8);
    ts_info := UI.default_text_settings();
    ts_info.size = 30;
    ts_info.halign = .LEFT;
    ts_info.valign = .TOP;
    ts_info.word_wrap = true;
    ts_info.do_outline = true;
    ts_info.outline_thickness = 2;
    ts_info.outline_color = {0, 0, 0, 1};

    cur_cap := machine_queue_cap_for_level(level);
    if level >= UPGRADES_MAX_LEVEL {
        UI.text(info_rect, ts_info, "Level: % / %\nSpeed Mult: %x\nQueue Cap: %", {level, UPGRADES_MAX_LEVEL, format_float(speed_mult, decimals=2), cur_cap});
    }
    else {
        next_mult := 1.0 + ((level).(float)) * UPGRADES_SPEED_MULT_PER_LEVEL;
        next_cap := machine_queue_cap_for_level(level + 1);
        UI.text(info_rect, ts_info, "Level: % / %\nSpeed Mult: %x -> %x\nQueue Cap: % -> %", {level, UPGRADES_MAX_LEVEL, format_float(speed_mult, decimals=2), format_float(next_mult, decimals=2), cur_cap, next_cap});
    }

    _ := inner->cut_top(10);
    btn_rect := inner->cut_bottom(78);

    ts_btn := UI.default_text_settings();
    ts_btn.size = 30;
    ts_btn.halign = .CENTER;
    ts_btn.valign = .CENTER;
    ts_btn.do_outline = true;
    ts_btn.outline_thickness = 2;
    ts_btn.outline_color = {0, 0, 0, 1};

    // Lane locked?
    if !lanes_is_unlocked(player, lane_index) {
        bs_na := UI.default_button_settings();
        bs_na.sprite = get_asset(Texture_Asset, "$AO/new/modal/buttons_2/button_8.png"); // Grey
        bs_na.press_scaling = 0.0;
        UI.push_disabled(true);
        defer UI.pop_disabled();
        _ := UI.button(btn_rect->inset(6), bs_na, ts_btn, "Lane Locked");
        return;
    }

    // Max level?
    if level >= UPGRADES_MAX_LEVEL {
        bs_max := UI.default_button_settings();
        bs_max.sprite = get_asset(Texture_Asset, "$AO/new/modal/buttons_2/button_8.png"); // Grey
        bs_max.press_scaling = 0.0;
        UI.push_disabled(true);
        defer UI.pop_disabled();
        _ := UI.button(btn_rect->inset(6), bs_max, ts_btn, "Max Level");
        return;
    }

    cost := station_upgrade_cost_for_level(kind, level);
    can_afford := cost > 0 && Economy.can_withdraw_currency(player, UPGRADES_COIN_CURRENCY, cost);

    // Optional Sparks upgrade button (if a product exists for this lane/target level).
    target_level := level + 1;
    sparks_product_id := station_upgrade_sparks_product_id_for_level(lane_index, kind, target_level);
    sparks_price := station_upgrade_sparks_price_for_level(lane_index, kind, target_level);
    has_sparks := sparks_product_id.count != 0 && sparks_price > 0;

    // Split the action row: Coins upgrade (left) + Sparks upgrade (right).
    coins_btn_rect := btn_rect;
    sparks_btn_rect := btn_rect;
    if has_sparks {
        left := btn_rect->cut_left_unscaled(btn_rect->width() * 0.5);
        coins_btn_rect = left;
        sparks_btn_rect = btn_rect;
    }

    // Coins button
    UI.push_id("up_coin_btn", {}); defer UI.pop_id();
    {
        bs := UI.default_button_settings();
        bs.sprite = get_asset(Texture_Asset, "$AO/new/modal/buttons_2/button_2.png"); // Green
        if !can_afford {
            bs.sprite = get_asset(Texture_Asset, "$AO/new/modal/buttons_2/button_3.png"); // Red
        }
        bs.press_scaling = 0.4;

        label := format_string("Upgrade ($%)", {format_int_with_commas(cost)});
        if UI.button(coins_btn_rect->inset(6), bs, ts_btn, label).clicked {
            server_try_upgrade_station(player, lane_index, kind);
        }
    }

    // Sparks button
    if has_sparks {
        UI.push_id("up_sparks_btn", {}); defer UI.pop_id();
        {
            bs_sparks := UI.default_button_settings();
            bs_sparks.sprite = get_asset(Texture_Asset, "$AO/new/modal/buttons_2/button_4.png"); // Gold
            bs_sparks.press_scaling = 0.35;

            sparks_icon := get_asset(Texture_Asset, "UI/Spark.png");
            sparks_label := format_string("%", {format_int_with_commas(sparks_price)});

            ts_sparks := ts_btn;
            ts_sparks.do_autofit = true;
            ts_sparks.autofit_min_size = 18;
            ts_sparks.autofit_max_size = ts_btn.size;

            result_sparks := UI.begin_button(sparks_btn_rect->inset(6), bs_sparks, ts_sparks, ""); {
                defer UI.end_button();

                inner_btn := result_sparks.rect->inset(10);
                if sparks_icon != null {
                    icon_rect := inner_btn->left_center_rect()->grow_unscaled(18)->offset_unscaled(22, 0);
                    UI.quad(icon_rect->fit_aspect(sparks_icon->get_aspect()), sparks_icon);
                }

                label_rect := inner_btn;
                _ := label_rect->cut_left_unscaled(46);
                UI.text(label_rect, ts_sparks, sparks_label);
            }

            if result_sparks.clicked {
                server_try_prompt_sparks_station_upgrade_purchase(player, lane_index, kind, target_level);
            }
        }
    }
}

draw_vault_upgrade_card :: proc(player: Player, rect: Rect) {
    if player == null return;

    UI.quad(rect, core_globals.white_sprite, {0.08, 0.08, 0.08, 0.95});
    inner := rect->inset(26);

    // Title
    title_rect := inner->cut_top(60);
    ts_title := UI.default_text_settings();
    ts_title.size = 44;
    ts_title.halign = .CENTER;
    ts_title.valign = .CENTER;
    ts_title.do_outline = true;
    ts_title.outline_thickness = 3;
    ts_title.outline_color = {0, 0, 0, 1};
    UI.text(title_rect, ts_title, "Piggy Bank");

    _ := inner->cut_top(16);

    level := player.vault_level;
    if level < 1 level = 1;

    cur_cap := vault_capacity_for_level(level);

    // Info
    info_rect := inner->cut_top(120)->inset(8);
    ts_info := UI.default_text_settings();
    ts_info.size = 34;
    ts_info.halign = .LEFT;
    ts_info.valign = .TOP;
    ts_info.word_wrap = true;
    ts_info.do_outline = true;
    ts_info.outline_thickness = 2;
    ts_info.outline_color = {0, 0, 0, 1};

    if level >= VAULT_MAX_LEVEL {
        UI.text(info_rect, ts_info, "Level: % / %\nCapacity: %", {level, VAULT_MAX_LEVEL, format_int_with_commas(cur_cap)});
    }
    else {
        next_cap := vault_capacity_for_level(level + 1);
        UI.text(info_rect, ts_info, "Level: % / %\nCapacity: % -> %", {level, VAULT_MAX_LEVEL, format_int_with_commas(cur_cap), format_int_with_commas(next_cap)});
    }

    _ := inner->cut_top(16);

    // Button
    btn_rect := inner->cut_top(90);

    ts_btn := UI.default_text_settings();
    ts_btn.size = 34;
    ts_btn.halign = .CENTER;
    ts_btn.valign = .CENTER;
    ts_btn.do_outline = true;
    ts_btn.outline_thickness = 2;
    ts_btn.outline_color = {0, 0, 0, 1};

    if level >= VAULT_MAX_LEVEL {
        bs_max := UI.default_button_settings();
        bs_max.sprite = get_asset(Texture_Asset, "$AO/new/modal/buttons_2/button_8.png");
        bs_max.press_scaling = 0.0;
        UI.push_disabled(true);
        defer UI.pop_disabled();
        _ := UI.button(btn_rect->inset(6), bs_max, ts_btn, "Max Level");
        return;
    }

    cost := vault_upgrade_cost_for_level(level);
    can_afford := cost > 0 && Economy.can_withdraw_currency(player, UPGRADES_COIN_CURRENCY, cost);

    bs := UI.default_button_settings();
    bs.sprite = get_asset(Texture_Asset, "$AO/new/modal/buttons_2/button_2.png");
    if !can_afford {
        bs.sprite = get_asset(Texture_Asset, "$AO/new/modal/buttons_2/button_3.png");
    }
    bs.press_scaling = 0.4;

    label := format_string("Upgrade ($%)", {format_int_with_commas(cost)});
    if UI.button(btn_rect->inset(6), bs, ts_btn, label).clicked {
        server_try_upgrade_vault(player);
    }
}

draw_upgrades_modal :: proc(player: Player) {
    if player == null return;

    UI.push_screen_draw_context();
    defer UI.pop_draw_context();

    UI.push_layer(230);
    defer UI.pop_layer();

    screen := UI.get_safe_screen_rect();

    // Dim background
    UI.quad(screen, core_globals.white_sprite, {0, 0, 0, 0.65});

    // Window
    window := screen->inset(100);
    UI.quad(window, core_globals.white_sprite, {0.12, 0.12, 0.12, 0.95});

    // Header with lane selection
    header := window->cut_top(150)->inset(20);
    title_rect := header->cut_top(60);
    lane_rect := header->cut_top(70);

    ts_title := UI.default_text_settings();
    ts_title.size = 52;
    ts_title.halign = .LEFT;
    ts_title.valign = .CENTER;
    ts_title.offset = {20, 0};
    ts_title.do_outline = true;
    ts_title.outline_thickness = 3;
    ts_title.outline_color = {0, 0, 0, 1};
    UI.text(title_rect, ts_title, "Upgrades");

    draw_upgrades_lane_header_buttons(player, lane_rect);

    // Content area (below header)
    content := window->inset(30);

    // Footer close button (red)
    footer := content->cut_bottom(95);
    {
        bs_close := UI.default_button_settings();
        ts_close := UI.default_text_settings();
        ts_close.size = 40;
        ts_close.halign = .CENTER;
        ts_close.valign = .CENTER;

        bs_close.sprite = get_asset(Texture_Asset, "$AO/new/modal/buttons_2/button_3.png"); // Red
        bs_close.press_scaling = 0.45;

        close_btn := footer->inset(10);
        if UI.button(close_btn, bs_close, ts_close, "Close").clicked {
            if Game.is_server() {
                player.upgrades_open = false;
            }
            return;
        }
    }

    body := content->inset(10);

    lane := player.upgrades_selected_lane;

    // Vault tab
    if lane == UPGRADES_TAB_VAULT {
        UI.push_id("up_vault", {});
        defer UI.pop_id();
        draw_vault_upgrade_card(player, body->inset(12));
        return;
    }

    // Lane tabs (0..3)
    if lane < 0 || lane >= UPGRADES_LANE_COUNT {
        lane = 0;
    }

    // If this lane is locked, show the lane unlock purchase UI instead of station cards.
    if !lanes_is_unlocked(player, lane) {
        prompt_rect := body->center_rect()->grow(160, 360, 160, 360);
        draw_upgrades_unlock_lane_prompt(player, prompt_rect, lane);
        return;
    }

    // 2x2 grid of station cards
    cards_area := body;
    for i: 0..UPGRADES_STATION_COUNT-1 {
        UI.push_id("up_card_%", {i});
        defer UI.pop_id();

        kind := station_kind_from_index(i);

        x1 := (i % 2).(float) * 0.5;
        x2 := x1 + 0.5;
        y1 := (i < 2) ? 0.5 : 0.0;
        y2 := y1 + 0.5;

        card := cards_area->subrect(x1, y1, x2, y2)->inset(12);
        draw_station_upgrade_card(player, card, lane, kind);
    }
}

draw_upgrades_ui :: proc(player: Player) {
    if player == null return;
    if !player->is_local_or_server() return;

    draw_upgrades_button(player);

    if player.upgrades_open {
        draw_upgrades_modal(player);
    }
}

