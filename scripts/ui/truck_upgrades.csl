import "core:ao"

draw_truck_upgrades_button :: proc(player: Player) {
    if player == null return;
    if !player.is_local_or_server() return;

    safe := UI.get_safe_screen_rect();
    // Place this where the Managers button used to be.
    btn_rect := safe.right_center_rect().grow(60).offset(-90, 120);

    bs := UI.default_button_settings();
    ts := UI.default_text_settings();
    ts.size = 22;

    icon := get_asset(Texture_Asset, "Buttons/truck.png");
    if icon != null {
        bs.sprite = icon;
        bs.press_scaling = 0.8;

        // Fit the clickable button rect to the sprite aspect ratio so the image doesn't stretch.
        draw_rect := btn_rect.fit_aspect(icon.get_aspect());

        if UI.button(draw_rect, bs, ts, "Truck").clicked {
            if Game.is_server() {
                player.truck_upgrades_open = !player.truck_upgrades_open;
                if player.truck_upgrades_open {
                    // Avoid overlapping modals.
                    player.sell_shop_open = false;
                    player.weapons_shop_open = false;
                    player.managers_open = false;
                    player.harvester_upgrades_open = false;
                    player.upgrades_open = false;
                }
            }
        }
        return;
    }

    // Fallback: regular button if icon missing.
    bs.sprite = get_asset(Texture_Asset, "$AO/new/modal/buttons_2/button_5.png"); // Blue
    bs.press_scaling = 0.4;
    if UI.button(btn_rect.grow(0, 120, 0, 120), bs, ts, "Truck").clicked {
        if Game.is_server() {
            player.truck_upgrades_open = !player.truck_upgrades_open;
            if player.truck_upgrades_open {
                player.sell_shop_open = false;
                player.weapons_shop_open = false;
                player.managers_open = false;
                player.harvester_upgrades_open = false;
                player.upgrades_open = false;
            }
        }
    }
}

draw_truck_upgrades_header_buttons :: proc(player: Player, rect: Rect) {
    if player == null return;

    ts := UI.default_text_settings();
    ts.size = 28;
    ts.halign = .CENTER;
    ts.valign = .CENTER;
    ts.do_outline = true;
    ts.outline_thickness = 2;
    ts.outline_color = {0, 0, 0, 1};

    bs_selected := UI.default_button_settings();
    bs_selected.sprite = get_asset(Texture_Asset, "$AO/new/modal/buttons_2/button_5.png"); // Blue
    bs_selected.press_scaling = 0.35;

    bs_normal := UI.default_button_settings();
    bs_normal.sprite = get_asset(Texture_Asset, "$AO/new/modal/buttons_2/button_8.png"); // Grey
    bs_normal.press_scaling = 0.35;

    labels: [3]string = {"Capacity", "HP", "Speed"};
    for i: 0..2 {
        UI.push_id("truck_up_kind_%", {i});
        defer UI.pop_id();

        x1 := i.(float) / 3.0;
        x2 := (i + 1).(float) / 3.0;
        btn := rect.subrect(x1, 0, x2, 1).inset(8);

        is_selected := player.truck_upgrades_selected_kind == i;
        bs := is_selected ? bs_selected : bs_normal;

        if UI.button(btn, bs, ts, labels[i]).clicked {
            if Game.is_server() {
                player.truck_upgrades_selected_kind = i;
            }
        }
    }
}

draw_truck_upgrade_panel :: proc(player: Player, rect: Rect, kind: Truck_Upgrade_Kind) {
    if player == null return;

    UI.quad(rect, core_globals.white_sprite, {0.08, 0.08, 0.08, 0.95});
    inner := rect.inset(18);

    // Title
    title_rect := inner.cut_top(60);
    ts_title := UI.default_text_settings();
    ts_title.size = 40;
    ts_title.halign = .LEFT;
    ts_title.valign = .CENTER;
    ts_title.offset = {10, 0};
    ts_title.do_outline = true;
    ts_title.outline_thickness = 2;
    ts_title.outline_color = {0, 0, 0, 1};
    UI.text(title_rect, ts_title, "Truck %", {truck_upgrade_display_name(kind)});

    _ := inner.cut_top(6);

    level := get_player_truck_level(player, kind);

    info_rect := inner.cut_top_unscaled(inner.height() * 0.62).inset(8);
    ts_info := UI.default_text_settings();
    ts_info.size = 30;
    ts_info.halign = .LEFT;
    ts_info.valign = .TOP;
    ts_info.word_wrap = true;
    ts_info.do_outline = true;
    ts_info.outline_thickness = 2;
    ts_info.outline_color = {0, 0, 0, 1};

    if kind == .CAPACITY {
        cur := truck_capacity_for_level(level);
        if level >= TRUCK_UPGRADES_MAX_LEVEL {
            UI.text(info_rect, ts_info, "Level: % / %\nCapacity per trip: % Finished Bills", {level, TRUCK_UPGRADES_MAX_LEVEL, cur});
        }
        else {
            next := truck_capacity_for_level(level + 1);
            UI.text(info_rect, ts_info, "Level: % / %\nCapacity per trip: % -> % Finished Bills", {level, TRUCK_UPGRADES_MAX_LEVEL, cur, next});
        }
    }
    else if kind == .HP {
        cur := truck_max_hp_for_level(level);
        if level >= TRUCK_UPGRADES_MAX_LEVEL {
            UI.text(info_rect, ts_info, "Level: % / %\nMax HP: %", {level, TRUCK_UPGRADES_MAX_LEVEL, cur});
        }
        else {
            next := truck_max_hp_for_level(level + 1);
            UI.text(info_rect, ts_info, "Level: % / %\nMax HP: % -> %", {level, TRUCK_UPGRADES_MAX_LEVEL, cur, next});
        }
    }
    else { // SPEED
        cur := truck_speed_mult_for_level(level);
        if level >= TRUCK_UPGRADES_MAX_LEVEL {
            UI.text(info_rect, ts_info, "Level: % / %\nSpeed Mult: %x", {level, TRUCK_UPGRADES_MAX_LEVEL, format_float(cur, decimals=2)});
        }
        else {
            next := truck_speed_mult_for_level(level + 1);
            UI.text(info_rect, ts_info, "Level: % / %\nSpeed Mult: %x -> %x", {level, TRUCK_UPGRADES_MAX_LEVEL, format_float(cur, decimals=2), format_float(next, decimals=2)});
        }
    }

    _ := inner.cut_top(10);
    btn_rect := inner.cut_bottom(84);

    ts_btn := UI.default_text_settings();
    ts_btn.size = 32;
    ts_btn.halign = .CENTER;
    ts_btn.valign = .CENTER;
    ts_btn.do_outline = true;
    ts_btn.outline_thickness = 2;
    ts_btn.outline_color = {0, 0, 0, 1};

    // Max level state.
    if level >= TRUCK_UPGRADES_MAX_LEVEL {
        bs_max := UI.default_button_settings();
        bs_max.sprite = get_asset(Texture_Asset, "$AO/new/modal/buttons_2/button_8.png"); // Grey
        bs_max.press_scaling = 0.0;
        UI.push_disabled(true);
        defer UI.pop_disabled();
        _ := UI.button(btn_rect.inset(6), bs_max, ts_btn, "Max Level");
        return;
    }

    cost := truck_upgrade_cost_for_level(kind, level);
    can_afford := cost > 0 && Economy.can_withdraw_currency(player, TRUCK_UPGRADES_COIN_CURRENCY, cost);

    bs := UI.default_button_settings();
    bs.sprite = get_asset(Texture_Asset, "$AO/new/modal/buttons_2/button_2.png"); // Green
    if !can_afford {
        bs.sprite = get_asset(Texture_Asset, "$AO/new/modal/buttons_2/button_3.png"); // Red
    }
    bs.press_scaling = 0.4;

    label := format_string("Upgrade ($%)", {format_int_with_commas(cost)});
    if UI.button(btn_rect.inset(6), bs, ts_btn, label).clicked {
        server_try_upgrade_truck(player, kind);
    }
}

draw_truck_upgrades_modal :: proc(player: Player) {
    if player == null return;

    UI.push_screen_draw_context();
    defer UI.pop_draw_context();

    UI.push_layer(232);
    defer UI.pop_layer();

    screen := UI.get_safe_screen_rect();

    // Dim background
    UI.quad(screen, core_globals.white_sprite, {0, 0, 0, 0.65});

    // Window
    window := screen.inset(100);
    UI.quad(window, core_globals.white_sprite, {0.12, 0.12, 0.12, 0.95});

    // Header with kind selection
    header := window.cut_top(150).inset(20);
    title_rect := header.cut_top(60);
    kind_rect := header.cut_top(70);

    ts_title := UI.default_text_settings();
    ts_title.size = 52;
    ts_title.halign = .LEFT;
    ts_title.valign = .CENTER;
    ts_title.offset = {20, 0};
    ts_title.do_outline = true;
    ts_title.outline_thickness = 3;
    ts_title.outline_color = {0, 0, 0, 1};
    UI.text(title_rect, ts_title, "Truck Upgrades");

    draw_truck_upgrades_header_buttons(player, kind_rect);

    // Content area (below header)
    content := window.inset(30);

    // Footer close button (red)
    footer := content.cut_bottom(95);
    {
        bs_close := UI.default_button_settings();
        ts_close := UI.default_text_settings();
        ts_close.size = 40;
        ts_close.halign = .CENTER;
        ts_close.valign = .CENTER;

        bs_close.sprite = get_asset(Texture_Asset, "$AO/new/modal/buttons_2/button_3.png"); // Red
        bs_close.press_scaling = 0.45;

        close_btn := footer.inset(10);
        if UI.button(close_btn, bs_close, ts_close, "Close").clicked {
            if Game.is_server() {
                player.truck_upgrades_open = false;
            }
            return;
        }
    }

    body := content.inset(10);

    idx := player.truck_upgrades_selected_kind;
    if idx < 0 || idx > 2 {
        idx = 0;
    }
    kind := truck_upgrade_kind_from_index(idx);

    panel := body.center_rect().grow(210, 460, 210, 460);
    draw_truck_upgrade_panel(player, panel, kind);
}

draw_truck_upgrades_ui :: proc(player: Player) {
    if player == null return;
    if !player.is_local_or_server() return;

    draw_truck_upgrades_button(player);

    if player.truck_upgrades_open {
        draw_truck_upgrades_modal(player);
    }
}

