import "core:ao"

// Courier:
// - Spawned via prefab and assigned to a specific owner + lane (Lane 1 = lane_index 0).
// - Paths between the owning PlayerBase's Finished_Bill_Press and Vault.
// - "Collects" finished bills from the Finished_Bill_Press's stored output (server-only) into internal storage.
// - Deposits carried finished bills into the Vault (server-only).
// - Despawns automatically if its owning player disconnects.
//
// Setup:
// - Add `Courier` to an entity that has a `Movement_Agent` component.
// - The Courier entity should be parented under the owning PlayerBase entity.
// - A server-side spawner should call `server_init(owner_user_id, lane_index)` after instantiation.

Courier_State :: enum {
    TO_SOURCE;
    WAIT_AT_SOURCE;
    TO_VAULT;
    WAIT_AT_VAULT;
    PAUSE_BEFORE_TO_VAULT;
    PAUSE_BEFORE_TO_SOURCE;
}

courier_find_finished_bill_press_for_base_and_lane :: proc(base: PlayerBase, lane_index: s64) -> Finished_Bill_Press {
    if base == null return null;
    if base.entity == null || base.entity.self == null return null;

    foreach p: component_iterator(Finished_Bill_Press) {
        if p == null continue;
        if p.entity == null || p.entity.self == null continue;
        if !p.entity->get_world_enabled() continue;
        if p.lane_index != lane_index continue;

        pb := get_parent_player_base(p.entity);
        if pb == base {
            return p;
        }
    }
    return null;
}

courier_find_vault_for_base :: proc(base: PlayerBase) -> Vault {
    if base == null return null;
    if base.entity == null || base.entity.self == null return null;

    foreach v: component_iterator(Vault) {
        if v == null continue;
        if v.entity == null || v.entity.self == null continue;
        if !v.entity->get_world_enabled() continue;

        pb := get_parent_player_base(v.entity);
        if pb == base {
            return v;
        }
    }
    return null;
}

Courier :: class : Component {
    // Tuning
    move_speed: float @ao_serialize;
    arrive_radius: float @ao_serialize;
    max_drive_seconds: float @ao_serialize; // Safety timeout to prevent soft-locks.

    max_finished_bills_capacity: s64 @ao_serialize;
    collect_interval: float @ao_serialize;  // seconds between collect attempts while waiting at press
    deposit_interval: float @ao_serialize;  // seconds between deposit attempts while waiting at vault
    path_wait_seconds: float @ao_serialize; // downtime between travel legs

    // Spine visuals
    spine_animator: Spine_Animator @ao_serialize;
    spine_entity: Entity @ao_serialize;

    // World UI
    ui_offset: v2 @ao_serialize;

    // Synced / runtime
    owner_user_id: string;
    lane_index: s64;
    state: Courier_State;
    carried_finished_bills: s64;

    // Runtime
    agent: Movement_Agent;
    drive_start_time: float;
    last_action_time: float;
    pause_until_time: float;
    break_variant: s64; // 1 or 2, controls Idle_Break_1 vs Idle_Break_2
    vault_full_notified_this_stop: bool;

    spine: Spine_Animator;
    spine_sm: State_Machine;
    spine_base_scale: v2;
    spine_scale_initialized: bool;

    last_world_pos: v2;
    last_world_pos_initialized: bool;

    ao_start :: method() {
        // Defaults (only if not set in editor)
        if move_speed <= 0 {
            move_speed = 3.75;
        }
        if arrive_radius <= 0 {
            arrive_radius = 0.6;
        }
        if max_drive_seconds <= 0 {
            max_drive_seconds = 60.0;
        }
        if max_finished_bills_capacity <= 0 {
            max_finished_bills_capacity = 20;
        }
        if collect_interval <= 0 {
            collect_interval = 0.35;
        }
        if deposit_interval <= 0 {
            deposit_interval = 0.2;
        }
        if path_wait_seconds <= 0 {
            path_wait_seconds = 3.0;
        }
        if ui_offset.x == 0 && ui_offset.y == 0 {
            ui_offset = {0, 1.35};
        }
        if lane_index < 0 {
            lane_index = 0;
        }

        agent = entity->get_component(Movement_Agent);
        if agent == null {
            log_warning("Courier: missing Movement_Agent on Courier entity", {});
        }

        last_world_pos = entity.world_position;
        last_world_pos_initialized = true;

        resolve_spine();
        setup_spine_state_machine();
        update_visuals();

        pb := get_parent_player_base(entity);
        if pb != null {
            owner_user_id = pb.owner_user_id;
        }

        if state != .TO_SOURCE && state != .WAIT_AT_SOURCE && state != .TO_VAULT && state != .WAIT_AT_VAULT {
            state = .TO_SOURCE;
        }
        if Game.is_server() {
            drive_start_time = get_time();
            last_action_time = 0;
            pause_until_time = 0;
            break_variant = 0;
            vault_full_notified_this_stop = false;
        }
    }

    target_pos_for_source :: method(press: Finished_Bill_Press) -> v2 {
        if press == null return entity.world_position;
        if press.entity == null || press.entity.self == null return entity.world_position;
        return press.entity.world_position + v2{0, -1.0};
    }

    target_pos_for_vault :: method(vault: Vault) -> v2 {
        if vault == null return entity.world_position;
        if vault.entity == null || vault.entity.self == null return entity.world_position;
        return vault.entity.world_position + v2{0, -1.0};
    }

    is_moving :: method() -> bool {
        return state == .TO_SOURCE || state == .TO_VAULT;
    }

    is_pausing :: method() -> bool {
        return state == .PAUSE_BEFORE_TO_VAULT || state == .PAUSE_BEFORE_TO_SOURCE;
    }

    should_play_bored_idle :: method() -> bool {
        // Only play bored idle when we're waiting at a station with no output to pick up.
        // (Not when we're pausing between path legs.)
        if state != .WAIT_AT_SOURCE return false;
        if carried_finished_bills > 0 return false;

        pb := get_parent_player_base(entity);
        source := courier_find_finished_bill_press_for_base_and_lane(pb, lane_index);
        if source == null return false;
        return source.stored_finished_bills <= 0;
    }

    server_init :: method(owner_id: string, lane: s64) {
        if !Game.is_server() {
            return;
        }
        owner_user_id = owner_id;
        lane_index = lane;
        if lane_index < 0 {
            lane_index = 0;
        }
        state = .TO_SOURCE;
        drive_start_time = get_time();
        last_action_time = 0;
        pause_until_time = 0;
        break_variant = 0;
    }

    server_begin_pause :: method(next_state: Courier_State) {
        if !Game.is_server() return;

        if path_wait_seconds <= 0 {
            state = next_state;
            drive_start_time = get_time();
            last_action_time = 0;
            pause_until_time = 0;
            break_variant = 0;
            return;
        }

        rng := rng_seed_time();
        break_variant = rng_range_int(ref rng, 1, 2);
        pause_until_time = get_time() + path_wait_seconds;
        last_action_time = get_time();
        drive_start_time = 0;

        if next_state == .TO_VAULT {
            state = .PAUSE_BEFORE_TO_VAULT;
        }
        else {
            state = .PAUSE_BEFORE_TO_SOURCE;
        }
    }

    resolve_spine :: method() {
        spine = null;
        target_entity := entity;

        if spine_animator != null {
            spine = spine_animator;
            if spine_animator.entity != null && spine_animator.entity.self != null {
                target_entity = spine_animator.entity;
            }
        }
        else if spine_entity != null && spine_entity.self != null {
            spine = spine_entity->get_component(Spine_Animator);
            target_entity = spine_entity;
        }
        else if target_entity != null && target_entity.self != null {
            spine = target_entity->get_component(Spine_Animator);
        }

        if spine != null {
            spine->awaken();
        }

        if !spine_scale_initialized {
            if target_entity != null && target_entity.self != null {
                spine_base_scale = target_entity.local_scale;
                if spine_base_scale.x == 0 {
                    spine_base_scale.x = 1;
                }
                if spine_base_scale.y == 0 {
                    spine_base_scale.y = 1;
                }
                spine_scale_initialized = true;
            }
        }
    }

    setup_spine_state_machine :: method() {
        if spine == null return;
        if spine.instance == null return;
        if spine_sm != null return;

        spine_sm = State_Machine.create();
        mode_var := spine_sm->create_variable("anim_mode", .INT);
        layer := spine_sm->create_layer("main", 0);

        idle_state := layer->create_state("Idle", true);
        run_state := layer->create_state("Run", true);
        break1_state := layer->create_state("Idle_Break_1", true);
        break2_state := layer->create_state("Idle_Break_2", true);
        layer->set_initial_state(idle_state);

        idle_to_run := layer->create_transition(idle_state, run_state, false);
        idle_to_run->create_int_condition(mode_var, 1, .EQUAL);

        idle_to_b1 := layer->create_transition(idle_state, break1_state, false);
        idle_to_b1->create_int_condition(mode_var, 2, .EQUAL);

        idle_to_b2 := layer->create_transition(idle_state, break2_state, false);
        idle_to_b2->create_int_condition(mode_var, 3, .EQUAL);

        run_to_idle := layer->create_transition(run_state, idle_state, false);
        run_to_idle->create_int_condition(mode_var, 0, .EQUAL);

        run_to_b1 := layer->create_transition(run_state, break1_state, false);
        run_to_b1->create_int_condition(mode_var, 2, .EQUAL);

        run_to_b2 := layer->create_transition(run_state, break2_state, false);
        run_to_b2->create_int_condition(mode_var, 3, .EQUAL);

        b1_to_idle := layer->create_transition(break1_state, idle_state, false);
        b1_to_idle->create_int_condition(mode_var, 0, .EQUAL);

        b1_to_run := layer->create_transition(break1_state, run_state, false);
        b1_to_run->create_int_condition(mode_var, 1, .EQUAL);

        b1_to_b2 := layer->create_transition(break1_state, break2_state, false);
        b1_to_b2->create_int_condition(mode_var, 3, .EQUAL);

        b2_to_idle := layer->create_transition(break2_state, idle_state, false);
        b2_to_idle->create_int_condition(mode_var, 0, .EQUAL);

        b2_to_run := layer->create_transition(break2_state, run_state, false);
        b2_to_run->create_int_condition(mode_var, 1, .EQUAL);

        b2_to_b1 := layer->create_transition(break2_state, break1_state, false);
        b2_to_b1->create_int_condition(mode_var, 2, .EQUAL);

        _ := mode_var;
        spine.instance->set_state_machine(spine_sm, true);
    }

    update_spine_state :: method() {
        if spine == null return;
        if spine.instance == null return;
        if spine.instance.state_machine == null return;

        mode := 0;
        if is_moving() {
            mode = 1;
        }
        else if should_play_bored_idle() {
            mode = (break_variant == 1) ? 2 : 3;
        }
        spine.instance.state_machine->set_int("anim_mode", mode);
    }

    update_visuals :: method() {
        if spine == null {
            resolve_spine();
            setup_spine_state_machine();
        }

        cur := entity.world_position;
        if !last_world_pos_initialized {
            last_world_pos = cur;
            last_world_pos_initialized = true;
        }
        delta := cur - last_world_pos;
        last_world_pos = cur;

        if spine_scale_initialized {
            target_entity := entity;
            if spine_entity != null && spine_entity.self != null {
                target_entity = spine_entity;
            }

            if target_entity != null && target_entity.self != null {
                if delta.x > 0.001 {
                    target_entity->set_local_scale({abs(spine_base_scale.x), spine_base_scale.y});
                }
                else if delta.x < -0.001 {
                    target_entity->set_local_scale({-abs(spine_base_scale.x), spine_base_scale.y});
                }
            }
        }

        update_spine_state();
        apply_depth_sort_from_owner();
    }

    apply_depth_sort_from_owner :: method() {
        if spine == null return;
        pb := get_parent_player_base(entity);
        if pb == null return;
        owner := pb->get_owner();
        if owner == null return;
        if owner.self == null return;
        if owner.animator == null return;

        spine.layer = owner.animator.layer;
        spine.depth_offset = owner.animator.depth_offset;
    }

    has_arrived :: method(target: v2) -> bool {
        delta := entity.world_position - target;
        return length_squared(delta) <= arrive_radius * arrive_radius;
    }

    server_should_despawn :: method() -> bool {
        if owner_user_id.count == 0 {
            return true;
        }

        pb := get_parent_player_base(entity);
        if pb == null {
            return true;
        }
        if pb.owner_user_id.count == 0 {
            return true;
        }
        if pb.owner_user_id != owner_user_id {
            return true;
        }

        owner := pb->get_owner();
        if owner == null {
            return true;
        }
        return false;
    }

    ao_update :: method(dt: float) {
        _ := dt;

        update_visuals();

        if agent == null {
            agent = entity->get_component(Movement_Agent);
        }

        pb := get_parent_player_base(entity);
        source := courier_find_finished_bill_press_for_base_and_lane(pb, lane_index);
        vault := courier_find_vault_for_base(pb);

        if agent != null {
            switch state {
                case .TO_SOURCE: {
                    if source != null {
                        _ := agent->set_path_target(target_pos_for_source(source), move_speed);
                    }
                }
                case .TO_VAULT: {
                    if vault != null {
                        _ := agent->set_path_target(target_pos_for_vault(vault), move_speed);
                    }
                }
            }
        }

        if !Game.is_server() {
            return;
        }

        if server_should_despawn() {
            entity->destroy();
            return;
        }

        if carried_finished_bills < 0 {
            carried_finished_bills = 0;
        }
        if carried_finished_bills > max_finished_bills_capacity {
            carried_finished_bills = max_finished_bills_capacity;
        }

        if (state == .TO_SOURCE || state == .TO_VAULT) && drive_start_time > 0 && max_drive_seconds > 0 {
            if get_time() - drive_start_time > max_drive_seconds {
                state = .TO_SOURCE;
                drive_start_time = get_time();
                last_action_time = 0;
                pause_until_time = 0;
                break_variant = 0;
            }
        }

        switch state {
            case .TO_SOURCE: {
                if source == null {
                    state = .WAIT_AT_SOURCE;
                    drive_start_time = 0;
                    last_action_time = 0;
                    return;
                }
                if has_arrived(target_pos_for_source(source)) {
                    state = .WAIT_AT_SOURCE;
                    drive_start_time = 0;
                    last_action_time = 0;
                }
            }
            case .WAIT_AT_SOURCE: {
                if source == null {
                    return;
                }

                // Choose a break variant only when we're truly waiting on empty output.
                // This prevents "bored" idles from being associated with path pauses.
                if carried_finished_bills <= 0 && source.stored_finished_bills <= 0 {
                    if break_variant == 0 {
                        rng := rng_seed_time();
                        break_variant = rng_range_int(ref rng, 1, 2);
                    }
                }
                else {
                    break_variant = 0;
                }

                // If the vault is full, don't collect more finished bills.
                vault_full := false;
                if vault != null {
                    cap := vault.max_capacity;
                    if cap <= 0 {
                        cap = vault_capacity_for_level(vault.upgrade_level);
                    }
                    if cap > 0 && vault.stored_finished_bills >= cap {
                        vault_full = true;
                    }
                }

                if !vault_full && carried_finished_bills < max_finished_bills_capacity {
                    if last_action_time <= 0 || get_time() - last_action_time >= collect_interval {
                        room := max_finished_bills_capacity - carried_finished_bills;
                        taken := source->server_collect_finished_bills_for_manager(owner_user_id, room);
                        if taken > 0 {
                            carried_finished_bills += taken;
                        }
                        last_action_time = get_time();
                    }
                }

                if carried_finished_bills > 0 {
                    source_empty_now := source.stored_finished_bills <= 0;
                    if carried_finished_bills >= max_finished_bills_capacity || source_empty_now {
                        server_begin_pause(.TO_VAULT);
                    }
                }
            }
            case .TO_VAULT: {
                if vault == null {
                    state = .TO_SOURCE;
                    drive_start_time = get_time();
                    last_action_time = 0;
                    return;
                }
                if has_arrived(target_pos_for_vault(vault)) {
                    state = .WAIT_AT_VAULT;
                    drive_start_time = 0;
                    last_action_time = 0;
                    vault_full_notified_this_stop = false;
                }
            }
            case .WAIT_AT_VAULT: {
                if vault == null {
                    return;
                }

                if carried_finished_bills <= 0 {
                    state = .TO_SOURCE;
                    drive_start_time = get_time();
                    last_action_time = 0;
                    return;
                }

                if last_action_time <= 0 || get_time() - last_action_time >= deposit_interval {
                    deposited := vault->server_deposit_finished_bills_from_manager(owner_user_id, carried_finished_bills);
                    if deposited > 0 {
                        carried_finished_bills -= deposited;
                        if carried_finished_bills < 0 {
                            carried_finished_bills = 0;
                        }
                    }
                    last_action_time = get_time();
                }

                // If we deposited all, head back.
                if carried_finished_bills <= 0 {
                    server_begin_pause(.TO_SOURCE);
                }
                else {
                    // Vault is full; wait here until space frees up.
                    cap := vault.max_capacity;
                    if cap <= 0 {
                        cap = vault_capacity_for_level(vault.upgrade_level);
                    }
                    if cap > 0 && vault.stored_finished_bills >= cap {
                        if !vault_full_notified_this_stop {
                            owner := pb != null ? pb->get_owner() : null;
                            if owner != null {
                                Notifier.notify(owner, "Piggy Bank is full! Courier is paused until there is space.");
                            }
                            vault_full_notified_this_stop = true;
                        }
                        return;
                    }
                }
            }
            case .PAUSE_BEFORE_TO_VAULT: {
                if pause_until_time > 0 && get_time() >= pause_until_time {
                    state = .TO_VAULT;
                    drive_start_time = get_time();
                    last_action_time = 0;
                    pause_until_time = 0;
                    break_variant = 0;
                }
            }
            case .PAUSE_BEFORE_TO_SOURCE: {
                if pause_until_time > 0 && get_time() >= pause_until_time {
                    state = .TO_SOURCE;
                    drive_start_time = get_time();
                    last_action_time = 0;
                    pause_until_time = 0;
                    break_variant = 0;
                }
            }
        }
    }

    ao_late_update :: method(dt: float) {
        _ := dt;
        draw_carried_ui();
    }

    draw_carried_ui :: method() {
        UI.push_world_draw_context();
        defer UI.pop_draw_context();

        UI.push_layer(5);
        defer UI.pop_layer();

        UI.push_z(entity.world_position.y - 0.002);
        defer UI.pop_z();

        pos := entity.world_position + ui_offset;

        rect := Rect{pos, pos}->grow(0.18, 0.55, 0.18, 0.55);
        icon_rect := rect->cut_left(0.22)->inset(0.01);
        text_rect := rect;

        #static bills_icon := get_asset(Texture_Asset, "Items/FinishedBills.png");
        if bills_icon != null {
            UI.quad(icon_rect->fit_aspect(bills_icon->get_aspect()), bills_icon);
        }

        ts := UI.default_text_settings();
        ts.size = 0.34;
        ts.halign = .LEFT;
        ts.valign = .CENTER;
        ts.do_outline = true;
        ts.outline_thickness = 2;
        ts.outline_color = {0, 0, 0, 1};
        ts.color = {1, 1, 1, 1};
        ts.offset = {0.05, 0};

        UI.text(text_rect, ts, "x%", {carried_finished_bills});
    }
}

